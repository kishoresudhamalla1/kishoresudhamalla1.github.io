---
/**
 * Metric counters.
 *
 * Drop this once per page. It finds anything marked `data-count` and animates
 * its number up on load. The final value always stays exactly as written in
 * the markup — it is never reset to zero, so a screenshot or link preview
 * taken before any scroll still shows the correct number.
 *
 * The element's existing text is the source of truth — "1.16M", "73.1%",
 * "16+", "~9", "8 yrs" all work. Only the numeric run is animated; prefix and
 * suffix are preserved exactly, so no metric has to be restated in a prop and
 * then drift from what the page says.
 */
---

<script>
  interface Parsed {
    prefix: string;
    suffix: string;
    target: number;
    decimals: number;
  }

  function parse(text: string): Parsed | null {
    // first numeric run, with optional thousands separators and decimals
    const m = text.match(/-?[\d][\d,]*(\.\d+)?/);
    if (!m) return null;
    const raw = m[0];
    const target = parseFloat(raw.replace(/,/g, ""));
    if (!isFinite(target)) return null;
    const dot = raw.indexOf(".");
    return {
      prefix: text.slice(0, m.index!),
      suffix: text.slice(m.index! + raw.length),
      target,
      decimals: dot === -1 ? 0 : raw.length - dot - 1,
    };
  }

  const grouped = (n: number, decimals: number, useGroups: boolean) =>
    n.toLocaleString("en-US", {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
      useGrouping: useGroups,
    });

  function initCounters() {
    const els = document.querySelectorAll<HTMLElement>("[data-count]:not([data-count-ready])");
    if (!els.length) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const animate = (el: HTMLElement, p: Parsed, hasGroups: boolean, delay: number) => {
      const DURATION = 800;

      const run = (start: number) => {
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / DURATION);
          // ease-out cubic: fast arrival, long settle — the number lands
          // rather than crawling the last few units.
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent =
            p.prefix + grouped(p.target * eased, p.decimals, hasGroups) + p.suffix;
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = p.prefix + grouped(p.target, p.decimals, hasGroups) + p.suffix;
        };
        requestAnimationFrame(tick);
      };

      setTimeout(() => requestAnimationFrame((now) => run(now)), delay);
    };

    // Group counters by their nearest shared container so stagger is local.
    const seen = new Map<Element, number>();

    els.forEach((el) => {
      const text = (el.textContent || "").trim();
      const p = parse(text);
      if (!p) return;

      el.dataset.countReady = "1";
      el.dataset.countParsed = JSON.stringify(p);
      const hasGroups = /\d,\d/.test(text);
      el.dataset.countGroups = hasGroups ? "1" : "0";

      // Reserve the final width so the layout cannot shift while digits change.
      el.style.setProperty("font-variant-numeric", "tabular-nums");
      el.style.setProperty("min-width", `${text.length}ch`);
      el.style.setProperty("display", "inline-block");

      // The final value is already on the page (set by the markup itself),
      // so first paint — including a screenshot or link preview taken before
      // any script runs — always shows the correct number. Animate on top of
      // that, immediately, without waiting to scroll into view.
      if (reduce) return;

      const group = el.closest("[data-count-group]") || el.parentElement?.parentElement || document.body;
      const i = seen.get(group) ?? 0;
      seen.set(group, i + 1);
      const delay = i * 60;
      el.dataset.countDelay = String(delay);

      animate(el, p, hasGroups, delay);
    });
  }

  /**
   * Snap every counter to its final value before printing.
   *
   * Counters animate up from zero on load, so printing mid-animation could
   * commit a partial figure to paper — "13+ yrs" instead of "16+ yrs" — the
   * first numbers a reader sees, wrong, in the artefact that gets emailed on.
   */
  function settleCounters() {
    document.querySelectorAll<HTMLElement>("[data-count][data-count-parsed]").forEach((el) => {
      const p: Parsed = JSON.parse(el.dataset.countParsed!);
      const hasGroups = (el.dataset.countGroups ?? "") === "1";
      el.textContent = p.prefix + grouped(p.target, p.decimals, hasGroups) + p.suffix;
    });
  }

  window.addEventListener("beforeprint", settleCounters);
  // Safari fires no beforeprint for the print shortcut; the media query does.
  window.matchMedia("print").addEventListener?.("change", (e) => {
    if (e.matches) settleCounters();
  });

  initCounters();
  document.addEventListener("astro:page-load", initCounters);
</script>
