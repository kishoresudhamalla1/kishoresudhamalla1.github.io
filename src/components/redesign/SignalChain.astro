---
/**
 * Animated version of the Signal -> Moment -> AI-recommended Playbook ->
 * Admin customization -> Employee experience chain. Abstract and
 * geometric on purpose (nodes, a line, a traveling pulse) -- not a
 * cartoon illustration, so it stays consistent with the rest of the site
 * and doesn't drift into the "generic AI imagery" the brief says to avoid.
 *
 * Two motions, both gated by prefers-reduced-motion:
 *  1. On scroll into view: the line draws left-to-right (or top-to-bottom
 *     on mobile) and the nodes land in sequence -- same IntersectionObserver
 *     convention AIProcess.astro and CaseHero.astro already use elsewhere
 *     on this site, so it reads as the same "house style" of motion.
 *  2. Afterward, a small pulse loops along the line, pausing briefly at
 *     each node, representing a signal moving through the system stage by
 *     stage rather than instantly.
 */

const STEPS = [
  { label: "Signal" },
  { label: "Moment" },
  { label: "AI-recommended Playbook" },
  { label: "Admin customization" },
  { label: "Employee experience" },
];
---

<div class="sc" data-sc>
  <div class="sc-track">
    <div class="sc-line" aria-hidden="true"></div>
    <div class="sc-dot" aria-hidden="true"></div>

    {STEPS.map((s, i) => (
      <div class="sc-step" style={`--i:${i}`}>
        <span class="sc-node" aria-hidden="true"></span>
        <p class="sc-label">{s.label}</p>
      </div>
    ))}
  </div>
</div>

<script>
  function initSignalChain() {
    document.querySelectorAll<HTMLElement>("[data-sc]").forEach((root) => {
      if (root.dataset.scReady) return;
      root.dataset.scReady = "1";

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        root.classList.add("is-in", "is-settled");
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            root.classList.add("is-in");
            io.unobserve(e.target);
            // Let the draw-in finish before the loop starts, so the two
            // motions never visually compete.
            window.setTimeout(() => root.classList.add("is-settled"), 1400);
          });
        },
        { threshold: 0.3 }
      );
      io.observe(root);
    });
  }
  initSignalChain();
  document.addEventListener("astro:page-load", initSignalChain);
</script>

<style>
  .sc { padding: 0.5rem 0 1rem; }

  .sc-track {
    position: relative;
    display: flex; flex-direction: column; gap: 2.25rem;
    padding-left: 1.5rem;
  }

  /* the constant line */
  .sc-line {
    position: absolute;
    left: 5px; top: 0.5rem; bottom: 0.5rem;
    width: 1px;
    background: var(--color-border);
  }
  .sc-line::before {
    content: ""; position: absolute; inset: 0;
    background: var(--color-ink);
    transform: scaleY(0); transform-origin: top;
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .is-in .sc-line::before { transform: scaleY(1); }

  .sc-step {
    position: relative;
    display: flex; align-items: center; gap: 1rem;
    opacity: 0; transform: translateX(-6px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    transition-delay: calc(var(--i) * 140ms + 150ms);
  }
  .is-in .sc-step { opacity: 1; transform: none; }

  .sc-node {
    flex-shrink: 0;
    position: relative; z-index: 2;
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--color-bg);
    border: 1.5px solid var(--color-ink-3);
    margin-left: -1.5rem;
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .is-in .sc-step .sc-node { border-color: var(--color-ink); }

  .sc-label {
    margin: 0;
    font-size: 0.875rem; font-weight: 500; color: var(--color-ink);
  }

  /* the traveling pulse -- a small glowing dot that loops along the line,
     pausing briefly at each node. Vertical track (mobile-first layout, see
     below for why the row-based desktop version is the override). */
  .sc-dot {
    position: absolute; z-index: 3;
    left: 5px; top: 0.5rem;
    width: 9px; height: 9px; margin-left: -4px; margin-top: -4px;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-ink) 18%, transparent);
    opacity: 0;
  }
  .is-settled .sc-dot {
    animation: sc-pulse-v 7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes sc-pulse-v {
    0%   { top: 0.5rem; opacity: 0; }
    4%   { opacity: 1; }
    14%  { top: 0.5rem; opacity: 1; }
    25%  { top: 25.25%; }
    35%  { top: 25.25%; }
    46%  { top: 50%; }
    56%  { top: 50%; }
    67%  { top: 74.75%; }
    77%  { top: 74.75%; }
    88%  { top: calc(100% - 0.5rem); opacity: 1; }
    96%  { opacity: 0; }
    100% { top: calc(100% - 0.5rem); opacity: 0; }
  }

  /* Desktop: row layout, horizontal line, pulse moves left-to-right. */
  @media (min-width: 720px) {
    .sc-track {
      flex-direction: row; align-items: flex-start;
      padding-left: 0; padding-top: 1.5rem; gap: 0;
    }
    .sc-line {
      left: 0.5rem; right: 0.5rem; top: 5px; bottom: auto;
      height: 1px; width: auto;
    }
    .sc-line::before { transform: scaleX(0); transform-origin: left; }
    .is-in .sc-line::before { transform: scaleX(1); }

    .sc-step {
      flex: 1; flex-direction: column; align-items: flex-start; gap: 0.9rem;
      transform: translateY(-6px);
    }
    .is-in .sc-step { transform: none; }
    .sc-node { margin-left: 0; }
    .sc-label { max-width: 9rem; line-height: 1.4; }

    .sc-dot {
      left: 0.5rem; top: 5px; margin-top: -4px;
    }
    .is-settled .sc-dot { animation-name: sc-pulse-h; }

    @keyframes sc-pulse-h {
      0%   { left: 0.5rem; opacity: 0; }
      4%   { opacity: 1; }
      14%  { left: 0.5rem; opacity: 1; }
      25%  { left: 25%; }
      35%  { left: 25%; }
      46%  { left: 50%; }
      56%  { left: 50%; }
      67%  { left: 75%; }
      77%  { left: 75%; }
      88%  { left: calc(100% - 0.5rem); opacity: 1; }
      96%  { opacity: 0; }
      100% { left: calc(100% - 0.5rem); opacity: 0; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-line::before, .sc-step { transition: none; }
    .sc-dot { display: none; }
  }
</style>
