---
/**
 * Selected work — a ledger of projects that previews on hover.
 *
 * Previously the row expanded on hover, animating open a full 16:9 image
 * that pushed every row below it down the page — the further down the list,
 * the more it moved. Now the row's height never changes: a small thumbnail
 * fades into space the row already reserves, the way wonderful.ai/careers
 * handles its "Main Roles" list. Hovering shows more without moving anything.
 *
 * Touch has no hover, so the thumbnail is simply not part of the mobile
 * layout rather than always-open — the list stays a clean, tappable index.
 */

const IMG = "/images/work";

const PROJECTS = [
  {
    index: "01",
    year: "2023",
    href: "/work/time-management-system",
    title: "Rethinking Time Management for a global workforce",
    meta: "Darwinbox · Senior UX Manager",
    blurb:
      "Reorganised an eight-year-old enterprise module around what managers need to decide first. Validated with 8 enterprise clients before global rollout.",
    tags: ["Enterprise UX", "Product Transformation", "Global HR Tech", "Complex Workflows"],
    img: `${IMG}/time-management/tm-manager-dashboard-poster.jpg`,
    alt: "Time Management, the redesigned manager dashboard",
  },
  {
    index: "02",
    year: "2026",
    href: "/work/design-ops",
    title: "Building an AI that explains why delivery slipped",
    meta: "Darwinbox · Designed and built solo",
    blurb:
      "An AI that explains why a commitment moved, cites the records it read, and measures whether the fix held.",
    tags: ["AI-Native", "Agentic UX", "Designed & built", "0 → 1"],
    img: `${IMG}/design-ops/hero-window.webp`,
    alt: "The Design Ops dashboard, delivery overview for the live quarter",
  },
];
---

<section id="cases" class="pl" data-reveal>
  <div class="container-pg">
    <div class="pl-head">
      <div>
        <p class="pl-eyebrow"><span class="pl-rule"></span>Selected work</p>
        <h2 class="pl-title">Recent<br />projects</h2>
      </div>
      <p class="pl-count">Two case studies / &rsquo;23&ndash;&rsquo;26</p>
    </div>

    <div class="pl-list">
      {PROJECTS.map((p) => (
        <a class="pl-row" href={p.href} data-pl-row>
          <div class="pl-top">
            <div class="pl-main">
              <h3 class="pl-name">
                <span class="pl-dash" aria-hidden="true"></span>
                {p.title}
                {p.status && <span class="pl-status">{p.status}</span>}
              </h3>
              <div class="pl-tags">
                {p.tags.map((t) => <span class="pl-tag">{t}</span>)}
              </div>
            </div>

            {p.img && (
              <div class="pl-thumb" aria-hidden="true">
                <img src={p.img} alt="" loading="lazy" decoding="async" />
              </div>
            )}

            <div class="pl-aside">
              <p class="pl-meta"><Fragment set:html={p.meta} /></p>
              <p class="pl-blurb">{p.blurb}</p>
            </div>

            <span class="pl-arrow" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                <path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor"
                      stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .pl { padding: clamp(4rem, 9vw, 7rem) 0; }

  .pl-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .pl-eyebrow {
    display: flex; align-items: center; gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-ink-3); margin-bottom: 1.1rem;
  }
  .pl-rule { width: 2.25rem; height: 1px; background: var(--color-ink-3); flex-shrink: 0; }

  .pl-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5.25rem);
    font-weight: 700; line-height: 0.95; letter-spacing: -0.04em;
    color: var(--color-ink); margin: 0;
  }
  .pl-count {
    font-family: var(--font-mono);
    font-size: 0.6875rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-ink-3);
  }

  .pl-list { border-top: 1px solid var(--color-border); }

  .pl-row {
    display: block;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    /* the hover tint, full-bleed within the row, edge to edge */
    background: transparent;
    transition: background-color 0.3s ease;
  }
  @media (hover: hover) {
    .pl-row:hover,
    .pl-row:focus-visible {
      background: var(--color-surface);
    }
  }

  /* Named areas rather than relying on source order + implicit auto-flow —
     that previously squeezed the description into an ~80px column on
     mobile when a bare two-column grid auto-placed four children. */
  .pl-top {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "main  arrow"
      "aside aside";
    gap: 0.75rem 1.25rem;
    align-items: center;
    padding: clamp(1.6rem, 3.5vw, 2.4rem) clamp(0rem, 2vw, 1.25rem);
  }
  .pl-main   { grid-area: main; }
  .pl-aside  { grid-area: aside; }
  .pl-arrow  { grid-area: arrow; justify-self: end; }

  @media (min-width: 900px) {
    /* title+tags | thumbnail | meta+blurb | arrow, one row. The thumbnail
       column exists in the grid at rest even when empty, so nothing shifts
       when the image fades in. */
    .pl-top {
      grid-template-columns: 1fr 11.5rem 19rem auto;
      grid-template-areas: "main thumb aside arrow";
      align-items: center;
    }
    .pl-thumb { grid-area: thumb; }
  }

  .pl-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    font-weight: 700; line-height: 1.03; letter-spacing: -0.035em;
    color: var(--color-ink); margin: 0;
    transition: opacity 0.3s ease;
  }

  /* The short dash that steps in before the title on hover — reserved
     width at rest so the title doesn't itself shift sideways when it
     appears, only the dash fades and slides in. */
  .pl-dash {
    display: inline-block;
    width: 0.9em;
    margin-right: 0.1em;
    opacity: 0;
    transform: translateX(-0.4em);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .pl-dash::before {
    content: "—";
    color: var(--color-ink-3);
  }
  @media (hover: hover) {
    .pl-row:hover .pl-dash,
    .pl-row:focus-visible .pl-dash { opacity: 1; transform: none; }
  }
  @media (hover: none) {
    .pl-dash { display: none; }
  }

  /* Sits on the title baseline rather than in the tag row: it qualifies the
     project, it is not another thing the project is about. */
  .pl-status {
    display: inline-block; vertical-align: middle;
    margin-left: 0.75rem; transform: translateY(-0.15em);
    font-family: var(--font-mono);
    font-size: 0.625rem; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-ink-3);
    border: 1px solid var(--color-border);
    border-radius: 100px; padding: 0.25rem 0.6rem;
    white-space: nowrap;
  }

  .pl-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.9rem; }
  .pl-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem; letter-spacing: 0.07em; text-transform: uppercase;
    color: var(--color-ink-3);
    border: 1px solid var(--color-border);
    border-radius: 100px; padding: 0.28rem 0.7rem;
  }

  /* ── the thumbnail ─────────────────────────────────────────────────
     Desktop-only, hover-only. Occupies its grid column at rest — width and
     height fixed — so the fade-in changes opacity, never layout. Hidden
     entirely below 900px rather than always-open: on touch this keeps the
     list a clean, fast-scanning index instead of showing four open images
     stacked on load. */
  .pl-thumb {
    display: none;
  }
  @media (min-width: 900px) {
    /* Sized to read as an actual preview of the case study, not a favicon —
       roughly the height of the two-line description beside it. */
    .pl-thumb {
      display: block;
      width: 100%;
      max-width: 10rem;
      aspect-ratio: 16 / 10;
      border-radius: 0.75rem;
      overflow: hidden;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      opacity: 0;
      transform: scale(0.97);
      transition: opacity 0.35s ease, transform 0.35s ease;
    }
    .pl-thumb img {
      display: block; width: 100%; height: 100%;
      object-fit: cover; object-position: top center;
    }
  }
  @media (hover: hover) and (min-width: 900px) {
    .pl-row:hover .pl-thumb,
    .pl-row:focus-visible .pl-thumb { opacity: 1; transform: none; }
  }

  .pl-meta {
    font-family: var(--font-mono);
    font-size: 0.625rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-ink-3); margin-bottom: 0.5rem;
  }
  .pl-blurb { font-size: 0.875rem; line-height: 1.6; color: var(--color-ink-2); }
  .pl-aside { align-self: start; padding-top: 0.35rem; }

  .pl-arrow {
    display: flex; align-items: center; justify-content: center;
    width: 2.75rem; height: 2.75rem; border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--color-ink-2);
    flex-shrink: 0; align-self: center;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  @media (hover: hover) {
    .pl-row:hover .pl-arrow,
    .pl-row:focus-visible .pl-arrow {
      background: var(--color-ink); border-color: var(--color-ink);
      color: var(--color-bg); transform: rotate(45deg);
    }
    /* dim the rest of the list so the hovered row leads */
    .pl-list:hover .pl-row:not(:hover) .pl-name { opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-row, .pl-thumb, .pl-dash, .pl-arrow, .pl-name { transition: none; }
  }
</style>
