---
/**
 * Selected work — three panels, one expanded at rest, hover swaps which.
 *
 * Earlier version faded a thumbnail into a reserved column on hover
 * (wonderful.ai/careers' "Main Roles" pattern). This replaces that with a
 * pattern borrowed from a reference the user liked: panels sit side by
 * side, one is expanded by default, and hovering a collapsed one expands
 * it while the others collapse — pure CSS (flex-grow transitions), no JS.
 *
 * Touch has no hover, so collapsing to illegible vertical strips would
 * strand two of three projects with no way to read them. Below 900px the
 * row becomes a plain vertical stack instead: full title, blurb and image
 * on all three, no collapse at all — the same "stays a clean, tappable
 * index on touch" rule the previous version used.
 */

const IMG = "/images/work";

const PROJECTS = [
  {
    href: "/work/time-management-system",
    n: "01",
    title: "Rethinking Time Management for a global workforce",
    meta: "Darwinbox · Senior UX Manager · Enterprise UX",
    blurb:
      "Reorganised an eight-year-old enterprise module around what managers need to decide first. Validated with 8 enterprise clients before global rollout.",
    img: `${IMG}/time-management/tm-manager-dashboard-poster.jpg`,
    alt: "Time Management, the redesigned manager dashboard",
    featured: false,
  },
  {
    href: "/work/design-ops",
    n: "02",
    title: "Building an AI that explains why delivery slipped",
    meta: "Darwinbox · Designed and built solo · AI-native",
    blurb:
      "An AI that explains why a commitment moved, cites the records it read, and measures whether the fix held.",
    img: `${IMG}/design-ops/hero-window.webp`,
    alt: "The Design Ops dashboard, delivery overview for the live quarter",
    featured: true,
  },
  {
    href: "/work/beyond-the-task",
    n: "03",
    title: "Beyond the Task: Journeys and AI-assisted Playbooks",
    meta: "Darwinbox · Senior Manager, UX Design · Product direction",
    blurb:
      "From transactional workflows to guided experiences, then to exploring how AI could help admins assemble guidance that doesn't already exist.",
    img: "/images/work/beyond-the-task/hero-diagram.svg",
    alt: "Conceptual diagram: from a task list to a guided Journey",
    featured: false,
    status: "Draft, evidence pending",
  },
];
---

<section id="cases" class="pl" data-reveal>
  <div class="container-pg">
    <div class="pl-head">
      <div>
        <p class="pl-eyebrow"><span class="pl-rule"></span>Selected work</p>
        <h2 class="pl-title">Recent<br />projects</h2>
      </div>
      <p class="pl-count">Three case studies / &rsquo;23&ndash;&rsquo;26</p>
    </div>

    <div class="work-row">
      {PROJECTS.map((p) => (
        <a class="work-card" href={p.href} data-featured={p.featured ? "true" : "false"}>
          <div class="work-card-img"><img src={p.img} alt="" loading="lazy" decoding="async" /></div>
          <p class="work-card-label">{p.n}</p>
          <div class="work-card-body">
            <p class="work-card-title">
              {p.title}
              {p.status && <span class="work-card-status">{p.status}</span>}
            </p>
            <p class="work-card-kicker"><Fragment set:html={p.meta} /></p>
            <p class="work-card-blurb">{p.blurb}</p>
            <span class="work-card-arrow" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                <path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor"
                      stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .pl { padding: clamp(4rem, 9vw, 7rem) 0; }

  .pl-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .pl-eyebrow {
    display: flex; align-items: center; gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-ink-3); margin-bottom: 1.1rem;
  }
  .pl-rule { width: 2.25rem; height: 1px; background: var(--color-ink-3); flex-shrink: 0; }

  .pl-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5.25rem);
    font-weight: 500; line-height: 0.95; letter-spacing: -0.045em;
    color: var(--color-ink); margin: 0;
  }
  .pl-count {
    font-family: var(--font-mono);
    font-size: 0.6875rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-ink-3);
  }

  /* ── the row: three panels, one expanded, css-only ────────────────────
     Mobile-first as a plain vertical stack (no hover to drive a collapse,
     so nothing collapses); the side-by-side expand/collapse only turns on
     at the breakpoint where a pointer with hover is also likely. */
  .work-row { display: flex; flex-direction: column; gap: 1rem; }

  .work-card {
    position: relative; overflow: hidden;
    border: 1px solid var(--color-border); border-radius: 1.25rem;
    text-decoration: none; color: inherit; background: var(--color-surface);
    min-height: 20rem;
  }

  @media (min-width: 900px) {
    .work-row { flex-direction: row; align-items: stretch; height: clamp(22rem, 44vw, 28rem); gap: 0.75rem; }
    .work-card {
      flex: 0 1 4.5rem; min-width: 4.5rem; min-height: 0;
      transition: flex-grow 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .work-card[data-featured="true"] { flex: 3 1 0; }
    .work-row:hover .work-card { flex: 1 1 0; }
    .work-row:hover .work-card:hover { flex: 3.2 1 0; }
  }

  .work-card-img { position: absolute; inset: 0; }
  .work-card-img img {
    width: 100%; height: 100%; object-fit: cover; object-position: top center;
  }
  /* uniform scrim first, so the vertical label stays legible against any
     photo, regardless of theme; a second, stronger gradient under the body
     text at the bottom so the title/blurb never fight the image for
     contrast. Both reference var(--color-bg), so they're already the
     correct colour for whichever theme is active -- no separate dark rule
     needed. */
  .work-card::before {
    content: ""; position: absolute; inset: 0; background: var(--color-bg); opacity: 0.62;
  }
  .work-card::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(0deg, var(--color-bg) 0%, var(--color-bg) 18%, transparent 68%);
    opacity: 0.88;
  }

  /* Mobile: a plain small index above the full card content below. Desktop
     collapsed state: the same number, rotated, reading top-to-bottom as the
     only thing a narrow strip has room for -- the full title lives in
     .work-card-body, which fades in once a panel expands, so there's
     nothing to duplicate here. */
  .work-card-label {
    position: absolute; top: 1.1rem; left: 1.1rem; z-index: 2; margin: 0;
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.06em;
    color: var(--color-ink-3);
  }
  @media (min-width: 900px) {
    .work-card-label { writing-mode: vertical-rl; text-orientation: mixed; top: 1.25rem; }
    .work-card[data-featured="true"] .work-card-label,
    .work-row:hover .work-card:hover .work-card-label { writing-mode: horizontal-tb; }
  }

  .work-card-body {
    position: absolute; left: 1.25rem; right: 1.25rem; bottom: 1.25rem; z-index: 2;
  }
  @media (min-width: 900px) {
    .work-card-body {
      opacity: 0; transform: translateY(8px); pointer-events: none;
      transition: opacity 0.3s ease 0.08s, transform 0.3s ease 0.08s;
    }
    .work-card[data-featured="true"] .work-card-body,
    .work-row:hover .work-card:hover .work-card-body {
      opacity: 1; transform: none; pointer-events: auto;
    }
  }

  .work-card-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 600; line-height: 1.15; letter-spacing: -0.02em;
    color: var(--color-ink); margin: 0 0 0.5rem; max-width: 30rem;
  }
  .work-card-status {
    display: inline-block; vertical-align: middle; margin-left: 0.6rem; transform: translateY(-0.1em);
    font-family: var(--font-mono); font-size: 0.625rem; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-3); white-space: nowrap;
  }
  .work-card-kicker {
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.03em;
    color: var(--color-ink-3); margin: 0 0 0.6rem;
  }
  .work-card-blurb {
    font-size: 0.875rem; line-height: 1.55; color: var(--color-ink-2); max-width: 28rem; margin: 0 0 1rem;
  }
  .work-card-arrow {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.5rem; height: 2.5rem; border-radius: 50%;
    border: 1px solid var(--color-border); color: var(--color-ink);
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) {
    .work-card:hover .work-card-arrow {
      background: var(--color-ink); border-color: var(--color-ink); color: var(--color-bg);
      transform: rotate(45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card, .work-card-body, .work-card-arrow { transition: none; }
  }
</style>
