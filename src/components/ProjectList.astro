---
/**
 * Selected work — three panels, one expanded at rest, hover swaps which.
 *
 * Earlier version overlaid the title and blurb directly on the screenshot,
 * with a scrim behind it for contrast. That never held up: tune the scrim
 * too light and the text fights a busy product screenshot for legibility;
 * tune it too dark and the image stops reading as a real screenshot. The
 * reference the user pointed back to (kokiltamta.in) never makes that
 * trade in the first place — the screenshot sits in its own framed window,
 * and the title/description sit below it on a plain surface. Text is never
 * on top of an image, so there's no contrast problem to solve. Rebuilt
 * around that structure instead of a fourth attempt at the overlay.
 *
 * Touch has no hover, so collapsing to illegible vertical strips would
 * strand two of three projects with no way to read them. Below 900px the
 * row becomes a plain vertical stack instead: full frame, title, blurb
 * and tags on all three, no collapse at all.
 */

const IMG = "/images/work";

const PROJECTS = [
  {
    href: "/work/time-management-system",
    n: "01",
    title: "Rethinking Time Management for a global workforce",
    meta: "Darwinbox · Senior UX Manager · Enterprise UX",
    blurb:
      "Reorganised an eight-year-old enterprise module around what managers need to decide first. Validated with 8 enterprise clients before global rollout.",
    img: `${IMG}/time-management/tm-manager-dashboard-poster.jpg`,
    alt: "Time Management, the redesigned manager dashboard",
    featured: false,
  },
  {
    href: "/work/design-ops",
    n: "02",
    title: "Building an AI that explains why delivery slipped",
    meta: "Darwinbox · Designed and built solo · AI-native",
    blurb:
      "An AI that explains why a commitment moved, cites the records it read, and measures whether the fix held.",
    img: `${IMG}/design-ops/hero-window.webp`,
    alt: "The Design Ops dashboard, delivery overview for the live quarter",
    featured: true,
  },
  {
    href: "/work/beyond-the-task",
    n: "03",
    title: "Beyond the Task: Journeys and AI-assisted Playbooks",
    meta: "Darwinbox · Senior Manager, UX Design · Product direction",
    blurb:
      "From transactional workflows to guided experiences, then to exploring how AI could help admins assemble guidance that doesn't already exist.",
    img: "/images/work/beyond-the-task/hero-diagram.svg",
    alt: "Conceptual diagram: from a task list to a guided Journey",
    featured: false,
    status: "Draft, evidence pending",
  },
];
---

<section id="cases" class="pl" data-reveal>
  <div class="container-pg">
    <div class="pl-head">
      <div>
        <p class="pl-eyebrow"><span class="pl-rule"></span>Selected work</p>
        <h2 class="pl-title">Recent<br />projects</h2>
      </div>
      <p class="pl-count">Three case studies / &rsquo;23&ndash;&rsquo;26</p>
    </div>

    <div class="work-row">
      {PROJECTS.map((p) => (
        <a class:list={["work-card", p.featured && "is-featured"]} href={p.href}>
          <span class="work-card-n" aria-hidden="true">{p.n}</span>

          <div class="work-card-frame">
            <span class="work-card-chrome" aria-hidden="true"><i></i><i></i><i></i></span>
            <div class="work-card-shot">
              <img src={p.img} alt="" loading="lazy" decoding="async" />
            </div>
          </div>

          <div class="work-card-info">
            <p class="work-card-kicker"><Fragment set:html={p.meta} /></p>
            <p class="work-card-title">
              {p.title}
              {p.status && <span class="work-card-status">{p.status}</span>}
            </p>
            <p class="work-card-blurb">{p.blurb}</p>
            <div class="work-card-foot">
              <div class="work-card-tags">
                {p.meta.split("·").slice(1).map((t) => <span>{t.trim()}</span>)}
              </div>
              <span class="work-card-arrow" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                  <path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor"
                        stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </div>

          <p class="work-card-label" aria-hidden="true">{p.n} &middot; {p.title}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .pl { padding: clamp(4rem, 9vw, 7rem) 0; }

  .pl-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .pl-eyebrow {
    display: flex; align-items: center; gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-ink-3); margin-bottom: 1.1rem;
  }
  .pl-rule { width: 2.25rem; height: 1px; background: var(--color-ink-3); flex-shrink: 0; }

  .pl-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5.25rem);
    font-weight: 500; line-height: 0.95; letter-spacing: -0.045em;
    color: var(--color-ink); margin: 0;
  }
  .pl-count {
    font-family: var(--font-mono);
    font-size: 0.6875rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-ink-3);
  }

  /* ── the row: three panels, one expanded, css-only ────────────────────
     Mobile-first as a plain vertical stack (no hover to drive a collapse,
     so nothing collapses); the side-by-side expand/collapse only turns on
     at the breakpoint where a pointer with hover is also likely. */
  .work-row { display: flex; flex-direction: column; gap: 1.25rem; }

  .work-card {
    position: relative; display: flex; flex-direction: column;
    border: 1px solid var(--color-border); border-radius: 1.25rem;
    text-decoration: none; color: inherit; background: var(--color-surface);
    padding: 1.1rem;
  }

  /* index number: always plain text on the card's own surface colour --
     never over the image, so it never needs a scrim. */
  .work-card-n {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.06em;
    color: var(--color-ink-3); margin-bottom: 0.9rem; display: block;
  }

  /* the screenshot's own window: a bordered, chrome-topped frame, the same
     language CaseHero and the case-study demo embeds already use. The
     image lives entirely inside this box and the text below never
     touches it. */
  .work-card-frame {
    border: 1px solid var(--color-border); border-radius: 0.85rem; overflow: hidden;
    background: var(--color-bg); margin-bottom: 1.1rem;
  }
  .work-card-chrome {
    display: flex; align-items: center; gap: 0.3rem;
    padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--color-border);
  }
  .work-card-chrome i {
    width: 6px; height: 6px; border-radius: 50%; background: var(--color-border);
  }
  .work-card-shot { aspect-ratio: 16 / 10; background: var(--color-surface); }
  .work-card-shot img {
    width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block;
  }

  .work-card-info { display: flex; flex-direction: column; flex: 1; }

  .work-card-kicker {
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.03em;
    color: var(--color-ink-3); margin: 0 0 0.6rem;
  }
  .work-card-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 600; line-height: 1.2; letter-spacing: -0.02em;
    color: var(--color-ink); margin: 0 0 0.6rem; max-width: 30rem;
  }
  .work-card-status {
    display: inline-block; vertical-align: middle; margin-left: 0.6rem; transform: translateY(-0.1em);
    font-family: var(--font-mono); font-size: 0.625rem; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-3); white-space: nowrap;
  }
  .work-card-blurb {
    font-size: 0.9375rem; line-height: 1.6; color: var(--color-ink-2); max-width: 32rem; margin: 0 0 1.25rem;
  }

  .work-card-foot {
    margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .work-card-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .work-card-tags span {
    font-size: 0.75rem; color: var(--color-ink-2);
    border: 1px solid var(--color-border); border-radius: 100px; padding: 0.4rem 0.85rem;
  }
  .work-card-arrow {
    flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    width: 2.5rem; height: 2.5rem; border-radius: 50%;
    border: 1px solid var(--color-border); color: var(--color-ink);
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) {
    .work-card:hover .work-card-arrow {
      background: var(--color-ink); border-color: var(--color-ink); color: var(--color-bg);
      transform: rotate(45deg);
    }
  }

  /* collapsed-state label: desktop-only, see below */
  .work-card-label { display: none; }

  @media (min-width: 900px) {
    .work-row { flex-direction: row; align-items: stretch; height: clamp(26rem, 46vw, 32rem); gap: 0.75rem; }
    .work-card {
      flex: 0 1 4.5rem; min-width: 4.5rem; overflow: hidden;
      transition: flex-grow 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .work-card.is-featured { flex: 3 1 0; }
    .work-row:hover .work-card { flex: 1 1 0; }
    .work-row:hover .work-card:hover { flex: 3.2 1 0; }

    /* Collapsed by default: hide everything except the rotated label,
       which reads top-to-bottom in the narrow strip. */
    .work-card-n, .work-card-frame, .work-card-info { display: none; }
    .work-card-label {
      display: block; writing-mode: vertical-rl; text-orientation: mixed;
      font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.02em;
      color: var(--color-ink-3); white-space: nowrap; overflow: hidden; max-height: 100%;
    }

    /*
      Expanded state swaps which children are visible via custom
      properties rather than ancestor-qualified selectors written directly
      against .work-card-n / .work-card-frame / .work-card-info /
      .work-card-label.

      Earlier attempts at the equivalent toggle (back when this card had a
      text-over-image overlay) used rules like
      ".work-card.is-featured .work-card-body" and
      ".work-row:hover .work-card:hover .work-card-body" side by side, and
      ran into a real, repeatable bug in Lightning CSS (Tailwind v4's
      minifier): sharing a trailing compound selector across rules caused
      it to "factor" them and silently drop the ancestor qualifier off one
      branch, leaving that branch's bare trailing selector apply to every
      card unconditionally. Confirmed by inspecting the compiled dist CSS
      directly, more than once, before landing on this approach.

      With exactly one concrete rule against each of those four elements,
      there's nothing left for that optimisation to merge unsafely -- the
      ancestor rules below only ever set a variable on their own selector.
    */
    .work-card-n, .work-card-frame, .work-card-info {
      display: var(--expanded-display, none);
    }
    .work-card-label { display: var(--collapsed-display, block); }
    .work-card.is-featured {
      --expanded-display: block; --collapsed-display: none;
    }
    .work-row:hover .work-card:hover {
      --expanded-display: block; --collapsed-display: none;
    }
    /* Without this, the featured card stayed expanded (block) even while
       the row was hovering a *different* card and its own flex-basis had
       shrunk to the narrow 4.5rem strip -- its title and blurb kept
       rendering, just wrapped into an unreadably narrow column instead of
       the clean vertical label every other non-hovered card shows.
       Higher specificity than .is-featured (four simple selectors against
       two), so this correctly wins whenever both could otherwise apply. */
    .work-row:hover .work-card:not(:hover) {
      --expanded-display: none; --collapsed-display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card, .work-card-arrow { transition: none; }
  }
</style>
