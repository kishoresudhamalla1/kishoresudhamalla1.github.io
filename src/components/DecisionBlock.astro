---
/**
 * One "key design decision": Problem, Options considered (shown as a
 * side-by-side comparison with the chosen path marked), then Why / Trade-offs
 * / Result as plain stacked text, always visible, nothing to click. Seniority
 * shows through the decision itself, not adjectives, so this stays a record
 * of reasoning, not a scorecard, and the reviewer never has to interrupt
 * reading to interact with it.
 */
interface Props {
  number: string;
  title?: string;
  problem: string;
  options: string[];
  /** Index into `options` that was chosen. Defaults to the last option,
   *  since that's how every decision on this site is currently written:
   *  the rejected path(s) first, the chosen one last. */
  chosenIndex?: number;
  decision: string;
  why: string;
  tradeoffs: string;
  result: string;
}
const { number, title, problem, options, chosenIndex, decision, why, tradeoffs, result } = Astro.props;
const chosen = chosenIndex ?? options.length - 1;
---

<div class="dblock">
  <p class="dblock-n">Decision {number}</p>
  {title && <h3 class="dblock-title">{title}</h3>}

  <div class="dblock-field">
    <p class="dblock-k">Problem</p>
    <p class="dblock-v">{problem}</p>
  </div>

  <div class="dblock-field">
    <p class="dblock-k">Options considered</p>
    <div class="dblock-options">
      {options.map((o, i) => (
        <div class={`dblock-opt${i === chosen ? " is-chosen" : ""}`}>
          <p class="dblock-opt-tag">
            {i === chosen ? (
              <>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                Chosen
              </>
            ) : "Not chosen"}
          </p>
          <p class="dblock-opt-v">{o}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="dblock-field">
    <p class="dblock-k">Decision</p>
    <p class="dblock-v dblock-decision">{decision}</p>
  </div>

  <div class="dblock-field">
    <p class="dblock-k">Why</p>
    <p class="dblock-v">{why}</p>
  </div>

  <div class="dblock-field">
    <p class="dblock-k">Trade-offs</p>
    <p class="dblock-v">{tradeoffs}</p>
  </div>

  <div class="dblock-field dblock-field--last">
    <p class="dblock-k">Result</p>
    <p class="dblock-v">{result}</p>
  </div>
</div>

<style>
  .dblock {
    padding: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
    border-top: 1px solid var(--color-border);
  }
  .dblock-n {
    font-family: var(--font-mono);
    font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-ink-3); margin: 0 0 0.6rem;
  }
  .dblock-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.375rem); letter-spacing: -0.015em;
    color: var(--color-ink); margin: 0 0 2rem;
  }
  .dblock-field {
    margin: 0 0 1.75rem;
  }
  .dblock-field--last { margin-bottom: 0; }
  .dblock-k {
    font-family: var(--font-mono);
    font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-ink-3); margin: 0 0 0.6rem;
  }
  .dblock-v {
    margin: 0; font-size: 1rem; line-height: 1.7; color: var(--color-ink-2);
    max-width: var(--measure);
  }
  .dblock-decision { color: var(--color-ink); font-weight: 600; }

  .dblock-options {
    display: grid; grid-template-columns: 1fr; gap: 0.875rem; max-width: var(--measure);
  }
  @media (min-width: 640px) {
    .dblock-options { grid-template-columns: 1fr 1fr; align-items: stretch; }
  }
  .dblock-opt {
    padding: 1rem 1.1rem; border-radius: 0.75rem; border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .dblock-opt.is-chosen {
    border-color: color-mix(in srgb, #4f8a7c 55%, var(--color-border));
    background: color-mix(in srgb, #4f8a7c 7%, var(--color-surface));
  }
  .dblock-opt-tag {
    display: flex; align-items: center; gap: 0.35rem;
    font-family: var(--font-mono); font-size: 0.625rem; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-3);
    margin: 0 0 0.5rem !important;
  }
  .dblock-opt.is-chosen .dblock-opt-tag { color: #4f8a7c; }
  .dblock-opt-v { font-size: 0.9375rem; line-height: 1.55; color: var(--color-ink-2); margin: 0 !important; }
  .dblock-opt.is-chosen .dblock-opt-v { color: var(--color-ink); }
</style>
