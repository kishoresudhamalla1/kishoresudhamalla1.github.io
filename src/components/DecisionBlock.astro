---
/**
 * One "key design decision" per the brief's structure: Problem, Options
 * considered, Decision, Why, Trade-offs, Result. Seniority is meant to show
 * through the decision itself, not through adjectives — so this stays a
 * plain record, no badges or scorekeeping.
 */
interface Props {
  number: string;
  title?: string;
  problem: string;
  options: string[];
  decision: string;
  why: string;
  tradeoffs: string;
  result: string;
}
const { number, title, problem, options, decision, why, tradeoffs, result } = Astro.props;
---

<div class="dblock">
  <p class="dblock-n">Decision {number}</p>
  {title && <h3 class="dblock-title">{title}</h3>}

  <div class="dblock-field">
    <p class="dblock-k">Problem</p>
    <p class="dblock-v">{problem}</p>
  </div>

  <div class="dblock-field">
    <p class="dblock-k">Options considered</p>
    <ul class="dblock-options">
      {options.map((o) => <li>{o}</li>)}
    </ul>
  </div>

  <div class="dblock-field">
    <p class="dblock-k">Decision</p>
    <p class="dblock-v dblock-decision">{decision}</p>
  </div>

  <div class="dblock-field">
    <p class="dblock-k">Why</p>
    <p class="dblock-v">{why}</p>
  </div>

  <div class="dblock-field">
    <p class="dblock-k">Trade-offs</p>
    <p class="dblock-v">{tradeoffs}</p>
  </div>

  <div class="dblock-field dblock-field--last">
    <p class="dblock-k">Result</p>
    <p class="dblock-v">{result}</p>
  </div>
</div>

<style>
  .dblock {
    padding: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
    border-top: 1px solid var(--color-border);
  }
  .dblock-n {
    font-family: var(--font-mono);
    font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-ink-3); margin: 0 0 0.6rem;
  }
  .dblock-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.125rem, 2vw, 1.375rem); letter-spacing: -0.015em;
    color: var(--color-ink); margin: 0 0 2rem;
  }
  .dblock-field {
    margin: 0 0 1.75rem;
  }
  .dblock-field--last { margin-bottom: 0; }
  .dblock-k {
    font-family: var(--font-mono);
    font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-ink-3); margin: 0 0 0.6rem;
  }
  .dblock-v {
    margin: 0; font-size: 1rem; line-height: 1.7; color: var(--color-ink-2);
    max-width: var(--measure);
  }
  .dblock-decision { color: var(--color-ink); font-weight: 600; }
  .dblock-options {
    margin: 0; padding: 0; list-style: none; max-width: var(--measure);
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .dblock-options li {
    font-size: 1rem; line-height: 1.6; color: var(--color-ink-2);
    padding-left: 1.1rem; position: relative;
  }
  .dblock-options li::before {
    content: "–"; position: absolute; left: 0; color: var(--color-ink-3);
  }
</style>
