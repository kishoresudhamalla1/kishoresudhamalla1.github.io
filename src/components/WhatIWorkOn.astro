---
const items = [
  {
    title: "Product design",
    detail: "Complex enterprise products, from understanding workflows and system constraints through to shaping the final product experience.",
  },
  {
    title: "Design leadership",
    detail: "Leading designers across product areas, improving product thinking and design quality while staying close to difficult problems.",
  },
  {
    title: "Complex systems",
    detail: "Platforms, workflows, configurations, permissions, business rules and dependencies across products and user roles.",
  },
  {
    title: "AI experiences",
    detail: "How AI and agents become part of real enterprise workflows: intent, planning, tools, permissions, approvals, actions, trust and recovery.",
  },
];
---

<section class="border-t border-[var(--color-border)] sec-y md:sec-y">
  <div class="container-pg">
    <p class="text-label mb-16 text-[var(--color-ink-3)]" data-reveal>What I do</p>

    <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item, i) => (
        <div data-reveal data-delay={String(Math.min(i + 1, 4))}>
          <h3 class="mb-3 text-base font-semibold leading-snug tracking-tight text-[var(--color-ink)]">
            {item.title}
          </h3>
          <p class="text-sm leading-relaxed text-[var(--color-ink-2)]">{item.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
