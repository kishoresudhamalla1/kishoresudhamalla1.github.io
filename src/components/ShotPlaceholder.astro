---
/**
 * Dashed-border placeholder for a screenshot that hasn't been exported yet.
 * Drop the real file at `src` (see the path comment at each call site) and
 * this renders it instead, same aspect ratio, no other changes needed.
 */
interface Props {
  src?: string;
  alt: string;
  label: string;
  ratio?: string; // CSS aspect-ratio value, e.g. "16 / 9"
}
const { src, alt, label, ratio = "16 / 9" } = Astro.props;
---

{src ? (
  <figure class="shot-ph shot-ph--filled" style={`aspect-ratio:${ratio}`}>
    <img {src} {alt} loading="lazy" />
  </figure>
) : (
  <figure class="shot-ph" style={`aspect-ratio:${ratio}`} role="img" aria-label={alt}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4.5" width="18" height="15" rx="1.8"/><circle cx="8.5" cy="10" r="1.6"/><path d="m4.5 17 4.8-5.1a1.6 1.6 0 0 1 2.3-.05L15 15.1M14.4 13.5l1.3-1.4a1.6 1.6 0 0 1 2.3 0l1.5 1.6"/>
    </svg>
    <p class="shot-ph-label">{label}</p>
  </figure>
)}

<style>
  .shot-ph {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.75rem; width: 100%; padding: 1.5rem;
    border: 1px dashed var(--color-border); border-radius: 0.875rem;
    background: var(--color-surface); color: var(--color-ink-3);
  }
  .shot-ph-label {
    margin: 0; max-width: 32rem; text-align: center;
    font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.55;
    letter-spacing: 0.01em; color: var(--color-ink-3);
  }
  .shot-ph--filled {
    padding: 0; border: 1px solid var(--color-border); overflow: hidden; background: var(--color-surface);
  }
  .shot-ph--filled img { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
