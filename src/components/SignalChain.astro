---
/**
 * Signal -> Moment -> AI-recommended Playbook -> Admin customization ->
 * Employee experience, as a quiet diagram: nodes on a line, and a pulse that
 * travels it, holding at each stage.
 *
 * Motion:
 *  1. On first view the line draws and the nodes land, once.
 *  2. Afterwards a small pulse loops along the line. It is positioned from the
 *     real node centres (measured, not assumed) and moves with `transform`
 *     only, so it never triggers layout. It pauses whenever the diagram is
 *     off-screen, and does not run at all under reduced motion.
 */

const STEPS = [
  { label: "Signal" },
  { label: "Moment" },
  { label: "AI-recommended Playbook" },
  { label: "Admin customization" },
  { label: "Employee experience" },
];
---

<div class="sc" data-sc>
  <div class="sc-track">
    <div class="sc-line" aria-hidden="true"></div>
    <div class="sc-dot" aria-hidden="true"></div>

    {STEPS.map((s, i) => (
      <div class="sc-step" style={`--i:${i}`}>
        <span class="sc-node" aria-hidden="true"></span>
        <p class="sc-label">{s.label}</p>
      </div>
    ))}
  </div>
</div>

<script>
  import { prefersReducedMotion, watchVisibility, motion } from "../lib/motion";

  function initSignalChain() {
    document.querySelectorAll<HTMLElement>("[data-sc]").forEach((root) => {
      if (root.dataset.scReady) return;
      root.dataset.scReady = "1";

      const track = root.querySelector<HTMLElement>(".sc-track")!;
      const nodes = Array.from(root.querySelectorAll<HTMLElement>(".sc-node"));

      // Where each node's centre sits inside the track, as the pulse's stops.
      const measure = () => {
        const t = track.getBoundingClientRect();
        nodes.forEach((n, i) => {
          const r = n.getBoundingClientRect();
          track.style.setProperty(`--x${i}`, `${(r.left - t.left + r.width / 2).toFixed(1)}px`);
          track.style.setProperty(`--y${i}`, `${(r.top - t.top + r.height / 2).toFixed(1)}px`);
        });
      };
      measure();
      new ResizeObserver(measure).observe(track);

      if (prefersReducedMotion()) {
        root.classList.add("is-in");
        return;
      }

      // Entrance (once), then the loop, which only runs while visible.
      let entered = false;
      watchVisibility(
        root,
        (visible) => {
          root.classList.toggle("is-paused", !visible);
          if (visible && !entered) {
            entered = true;
            root.classList.add("is-in");
            window.setTimeout(() => root.classList.add("is-settled"), motion.duration.narrative + 300);
          }
        },
        "0px"
      );
    });
  }
  initSignalChain();
  document.addEventListener("astro:page-load", initSignalChain);
</script>

<style>
  .sc { padding: 0.5rem 0 1rem; }

  .sc-track {
    position: relative;
    display: flex; flex-direction: column; gap: 2.25rem;
    padding-left: 1.5rem;
  }

  /* the constant line */
  .sc-line {
    position: absolute;
    left: 5px; top: 0.5rem; bottom: 0.5rem;
    width: 1px;
    background: var(--color-border);
  }
  .sc-line::before {
    content: ""; position: absolute; inset: 0;
    background: var(--color-ink);
    transform: scaleY(0); transform-origin: top;
    transition: transform var(--dur-narrative) var(--ease-move);
  }
  .is-in .sc-line::before { transform: scaleY(1); }

  .sc-step {
    position: relative;
    display: flex; align-items: center; gap: 1rem;
    opacity: 0; transform: translateX(calc(var(--dist-small) * -1));
    transition: opacity var(--dur-normal) var(--ease-enter), transform var(--dur-normal) var(--ease-enter);
    transition-delay: calc(var(--i) * 60ms + 120ms);
  }
  .is-in .sc-step { opacity: 1; transform: none; }

  .sc-node {
    flex-shrink: 0;
    position: relative; z-index: 2;
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--color-bg);
    border: 1.5px solid var(--color-ink-3);
    margin-left: -1.5rem;
    transition: border-color var(--dur-normal) var(--ease-enter);
  }
  .is-in .sc-step .sc-node { border-color: var(--color-ink); }

  .sc-label {
    margin: 0;
    font-size: 0.875rem; font-weight: 500; color: var(--color-ink);
  }

  /* The pulse: parked at the track origin and moved with transform alone. The
     stops (--x0..--x4, --y0..--y4) are the measured node centres, so it lands
     exactly on each node whatever the layout (column on mobile, row on
     desktop) or the label wrapping. */
  .sc-dot {
    position: absolute; z-index: 3;
    left: 0; top: 0;
    width: 9px; height: 9px; margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-ink) 18%, transparent);
    opacity: 0;
    transform: translate(var(--x0, 0px), var(--y0, 0px));
  }
  .is-settled .sc-dot { animation: sc-pulse 7s linear infinite; }
  .is-paused .sc-dot { animation-play-state: paused; }

  @keyframes sc-pulse {
    0%   { transform: translate(var(--x0), var(--y0)); opacity: 0; animation-timing-function: ease-out; }
    4%   { transform: translate(var(--x0), var(--y0)); opacity: 1; }
    14%  { transform: translate(var(--x0), var(--y0)); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    25%  { transform: translate(var(--x1), var(--y1)); }
    35%  { transform: translate(var(--x1), var(--y1)); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    46%  { transform: translate(var(--x2), var(--y2)); }
    56%  { transform: translate(var(--x2), var(--y2)); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    67%  { transform: translate(var(--x3), var(--y3)); }
    77%  { transform: translate(var(--x3), var(--y3)); animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1); }
    88%  { transform: translate(var(--x4), var(--y4)); opacity: 1; }
    96%  { transform: translate(var(--x4), var(--y4)); opacity: 0; }
    100% { transform: translate(var(--x4), var(--y4)); opacity: 0; }
  }

  /* Desktop: a row, with the line running horizontally. */
  @media (min-width: 720px) {
    .sc-track {
      flex-direction: row; align-items: flex-start;
      padding-left: 0; padding-top: 1.5rem; gap: 0;
    }
    .sc-line {
      left: 0.5rem; right: 0.5rem; top: 5px; bottom: auto;
      height: 1px; width: auto;
    }
    .sc-line::before { transform: scaleX(0); transform-origin: left; }
    .is-in .sc-line::before { transform: scaleX(1); }

    .sc-step {
      flex: 1; flex-direction: column; align-items: flex-start; gap: 0.9rem;
      transform: translateY(calc(var(--dist-small) * -1));
    }
    .is-in .sc-step { transform: none; }
    .sc-node { margin-left: 0; }
    .sc-label { max-width: 9rem; line-height: 1.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-line::before, .sc-step, .sc-node { transition: none; }
    .sc-step { opacity: 1; transform: none; }
    .sc-line::before { transform: none; }
    .sc-dot { display: none; }
  }
</style>
