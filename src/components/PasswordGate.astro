---
/**
 * A soft gate for a page that shouldn't surface to a casual visitor who
 * follows the link, without pretending to be real security — the password
 * check runs client-side and the gated content is already in the page
 * source. It's there to stop someone from landing on the page and seeing
 * it, not to stand up to a determined look.
 */
interface Props {
  password: string;
  /** Identifies this gate in sessionStorage; unique per gated page. */
  storageKey: string;
  /** Shown under the title, explaining why the gate is here. */
  reason?: string;
}
const { password, storageKey, reason } = Astro.props;
---

<div class="pg-gate" data-pg-gate data-pg-password={password} data-pg-key={storageKey}>
  <div class="pg-card">
    <p class="pg-label">This page is gated</p>
    <h1 class="pg-title">Enter the password to continue.</h1>
    {reason && <p class="pg-reason">{reason}</p>}
    <form class="pg-form" data-pg-form autocomplete="off">
      <input
        class="pg-input"
        type="password"
        inputmode="numeric"
        name="pg-password"
        aria-label="Password"
        autocomplete="off"
      />
      <button class="pg-btn" type="submit">Continue</button>
    </form>
    <p class="pg-error" data-pg-error aria-live="polite">Incorrect password.</p>
  </div>
</div>

<div class="pg-content" data-pg-content>
  <slot />
</div>

<script>
  function initPasswordGates() {
    document.querySelectorAll<HTMLElement>("[data-pg-gate]").forEach((gate) => {
      if (gate.dataset.pgReady) return;
      gate.dataset.pgReady = "1";

      const key = `pg-${gate.dataset.pgKey}`;
      const password = gate.dataset.pgPassword || "";
      const content = gate.nextElementSibling as HTMLElement | null;
      const form = gate.querySelector<HTMLFormElement>("[data-pg-form]")!;
      const input = gate.querySelector<HTMLInputElement>(".pg-input")!;
      const error = gate.querySelector<HTMLElement>("[data-pg-error]")!;

      const unlock = () => {
        gate.style.display = "none";
        if (content) content.style.display = "";
      };

      let unlocked = false;
      try {
        unlocked = sessionStorage.getItem(key) === "1";
      } catch {}

      if (unlocked) {
        unlock();
        return;
      }

      if (content) content.style.display = "none";
      input.focus();

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (input.value === password) {
          try { sessionStorage.setItem(key, "1"); } catch {}
          unlock();
        } else {
          error.classList.add("is-visible");
          gate.querySelector(".pg-card")?.classList.remove("is-shake");
          void (gate.querySelector(".pg-card") as HTMLElement)?.offsetWidth;
          gate.querySelector(".pg-card")?.classList.add("is-shake");
          input.value = "";
          input.focus();
        }
      });
    });
  }

  initPasswordGates();
  document.addEventListener("astro:page-load", initPasswordGates);
</script>

<style>
  .pg-gate {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }
  .pg-card {
    width: 100%;
    max-width: 22rem;
    text-align: center;
  }
  .pg-card.is-shake { animation: pg-shake 320ms ease; }
  @keyframes pg-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }
  .pg-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-ink-3);
    margin: 0 0 0.75rem;
  }
  .pg-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.25rem, 3vw, 1.625rem); letter-spacing: -0.02em;
    color: var(--color-ink); margin: 0 0 1rem;
  }
  .pg-reason {
    font-size: 0.875rem; line-height: 1.6; color: var(--color-ink-2);
    margin: 0 0 1.75rem;
  }
  .pg-form {
    display: flex; gap: 0.6rem;
  }
  .pg-input {
    flex: 1; min-width: 0;
    font: inherit; font-size: 0.9375rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg);
    color: var(--color-ink);
  }
  .pg-input:focus {
    outline: 2px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
    outline-offset: 1px;
  }
  .pg-btn {
    font: inherit; font-size: 0.875rem; font-weight: 600;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--color-ink);
    border-radius: 0.5rem;
    background: var(--color-ink);
    color: var(--color-bg);
    cursor: pointer;
    transition: opacity var(--dur-micro) var(--ease-enter);
  }
  .pg-btn:hover { opacity: 0.85; }
  .pg-error {
    font-size: 0.8125rem; color: #c0564a;
    margin: 1rem 0 0; opacity: 0; visibility: hidden;
  }
  .pg-error.is-visible { opacity: 1; visibility: visible; }
</style>
