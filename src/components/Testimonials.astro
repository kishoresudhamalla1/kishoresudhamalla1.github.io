---

<section class="border-t border-[var(--color-border)] sec-y md:sec-y">
  <div class="container-pg relative">
    <span
      aria-hidden
      data-parallax="0.1"
      class="pointer-events-none absolute -top-8 right-0 select-none font-serif text-[clamp(8rem,18vw,14rem)] font-bold leading-none text-[var(--color-ink)] opacity-[0.05]"
    >
      &rdquo;
    </span>
    <p class="text-label mb-16 text-[var(--color-ink-3)]" data-reveal>In their words</p>
    <blockquote class="relative max-w-3xl" data-reveal data-delay="1">
      <p class="text-2xl font-medium leading-snug tracking-tight text-[var(--color-ink)] md:text-3xl">
        &ldquo;AI Power plugged into Time Management. Really great job, simplified
        for managers, helps plan the day, work-life balance and save their own time.&rdquo;
      </p>
      <footer class="mt-8">
        <p class="text-sm font-medium text-[var(--color-ink-2)]">Monik Suthar</p>
        <p class="text-label mt-0.5 text-[var(--color-ink-3)]">Enterprise HR community · post-launch</p>
      </footer>
    </blockquote>
  </div>
</section>
