---
/**
 * DRAFT — asymmetric "selected work" layout, calmer 2026-SaaS treatment.
 *
 * Replaces PaperCards' glass/accordion sheets with flat, generously padded
 * cards: one flagship card (wide, left column) and a supporting stack of two
 * smaller cards (right column). No heavy borders or shadows — just a subtle
 * surface tint and border that shifts on hover.
 *
 * `items[0]` is treated as the flagship; the rest render in the supporting
 * stack in order. Reuses the same PaperItem shape already defined in
 * PaperCards.astro (duck-typed here, not importing its interface, so this
 * component has no dependency on PaperCards).
 */
export interface WorkItem {
  n: string; ptitle: string; pblurb: string; tags: string[]; href: string; title: string;
}
interface Props { items: WorkItem[] }
const { items } = Astro.props;
const [flagship, ...rest] = items;
---

<div class="wg-grid">
  <a href={flagship.href} class="wg-card wg-card--flagship" aria-label={flagship.title}>
    <p class="wg-n">{flagship.n}</p>
    <h3 class="wg-title">{flagship.ptitle}</h3>
    <ul class="wg-tags">{flagship.tags.map((t) => <li>{t}</li>)}</ul>
    <p class="wg-brief">{flagship.pblurb}</p>
    <span class="wg-cta">View case study →</span>
  </a>

  <div class="wg-stack">
    {rest.map((p) => (
      <a href={p.href} class="wg-card" aria-label={p.title}>
        <p class="wg-n">{p.n}</p>
        <h3 class="wg-title">{p.ptitle}</h3>
        <ul class="wg-tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
        <p class="wg-brief">{p.pblurb}</p>
        <span class="wg-cta">View case study →</span>
      </a>
    ))}
  </div>
</div>

<style>
  .wg-grid {
    display: grid; grid-template-columns: 1fr; gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .wg-grid { grid-template-columns: 1.5fr 1fr; align-items: stretch; gap: 1.5rem; }
  }

  .wg-stack { display: flex; flex-direction: column; gap: 1.25rem; }

  .wg-card {
    position: relative; display: flex; flex-direction: column;
    padding: clamp(2rem, 3.2vw, 2.75rem);
    border-radius: 1.5rem; text-decoration: none; color: inherit;
    background: color-mix(in srgb, var(--color-ink) 3%, var(--color-bg));
    border: 1px solid color-mix(in srgb, var(--color-ink) 7%, transparent);
    transition: background-color 420ms var(--ease-enter, ease), border-color 420ms var(--ease-enter, ease);
  }
  @media (hover: hover) {
    .wg-card:hover {
      background: color-mix(in srgb, var(--color-ink) 6%, var(--color-bg));
      border-color: color-mix(in srgb, var(--color-ink) 16%, transparent);
    }
  }

  .wg-card--flagship {
    min-height: clamp(22rem, 32vw, 28rem);
    justify-content: flex-end;
  }
  .wg-stack .wg-card { flex: 1; justify-content: flex-end; min-height: 13rem; }

  .wg-n {
    font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500;
    letter-spacing: 0.1em; color: var(--color-ink-3); margin: 0 0 auto;
  }
  .wg-card--flagship .wg-n { font-size: 0.8125rem; }

  .wg-title {
    font-family: var(--font-display); font-weight: 700; letter-spacing: -0.03em;
    color: var(--color-ink); margin: 1.5rem 0 1rem;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem); line-height: 1.12;
  }
  .wg-card--flagship .wg-title { font-size: clamp(1.75rem, 3.4vw, 2.5rem); margin-top: 2rem; }

  .wg-tags { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .wg-tags li {
    font-family: var(--font-sans); font-size: 0.75rem; font-weight: 500;
    color: var(--color-ink-2); padding: 0.4rem 0.85rem; border-radius: 100px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .wg-brief {
    font-size: 0.9375rem; line-height: 1.6; color: var(--color-ink-2);
    margin: 0 0 1.5rem; max-width: 34rem;
  }
  .wg-card--flagship .wg-brief { font-size: 1rem; max-width: 38rem; }

  .wg-cta {
    font-size: 0.8125rem; font-weight: 500; color: var(--color-ink);
    padding-top: 1rem; border-top: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .wg-card { transition: none; }
  }
</style>
