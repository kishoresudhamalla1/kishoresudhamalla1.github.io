---
/**
 * Flagship case study: Runtime Governance for Enterprise AI Agents
 * (Agent Control Plane). A concept project, not a shipped Darwinbox product,
 * so the human figures (VectorScale AI, REQ-842, Dana Okafor, etc.) are
 * illustrative throughout rather than client data.
 *
 * High text-to-diagram ratio on purpose: this is the flagship case study,
 * styled closer to a product teardown (Linear/Stripe Press register) than
 * the prose-first case studies elsewhere on the site. Two React islands
 * carry the interactivity (ProtoTabs, HotspotInspector); everything else
 * is static Astro + CSS, matching the rest of the site's convention.
 */
import Base from "../../layouts/Base.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import { ProtoTabs } from "../../components/work/ProtoTabs.tsx";
import { HotspotInspector, type Pin } from "../../components/work/HotspotInspector.tsx";

// Deployed Agent Control Plane prototype, built and checked into
// public/demo/agent-control-plane/.
const PROTOTYPE_URL = "/demo/agent-control-plane/index.html";
const IMG = "/images/work/agent-control-plane";

const PRINCIPLES = [
  {
    n: "01",
    tag: "REQ-843",
    title: "Silence for safe work",
    body: "Routine renewals within budget auto-execute silently. Only interrupt humans when a threshold breaks.",
  },
  {
    n: "02",
    tag: "No bare approve",
    title: "Context over rubber-stamps",
    body: "Never render a standalone \"Approve\" button. Pair every dollar figure with its compliance impact.",
  },
  {
    n: "03",
    tag: "No dead ends",
    title: "Fixes over hard stops",
    body: "A blocked message stalls teams. Every policy trigger calculates a safe alternative on the spot.",
  },
  {
    n: "04",
    tag: "Every override",
    title: "Proof by default",
    body: "Every human override, cap change or region reroute writes an immutable audit receipt automatically.",
  },
];

const PINS: Pin[] = [
  {
    x: 27, y: 17,
    tag: "Triage queue",
    title: "Exception-first triage queue",
    body: "The top filter bar separates work into Needs Attention, Escalated and Auto-Executed, instead of one noisy event stream.",
    tradeoff: "A VP of Finance clears high-risk blocks in two minutes, trusting that safe renewals keep running in the background unseen.",
  },
  {
    x: 24, y: 24,
    tag: "REQ-842",
    title: "Multi-factor risk card",
    body: "Finance and InfoSec signals live on one object. REQ-842 shows $12k over Q4 budget and a GDPR §4.2 conflict, together.",
    tradeoff: "Most companies split these across two tools. Combining them means one card, not two separate approvals to chase.",
  },
  {
    x: 76, y: 48,
    tag: "[DPA §4.2]",
    title: "Inline evidence drawer",
    body: "Clicking [DPA §4.2] slides open a right-hand drawer with the exact vendor telemetry clause, no modal, no lost context.",
    tradeoff: "I rejected a blocking modal here. It hid the budget numbers the approver needed to see at the same time.",
  },
  {
    x: 24, y: 53,
    tag: "Steer panel",
    title: "Live steering toggles",
    body: "Toggling \"Enforce EU-Only Data Scope\" or \"6-Month Pilot Cap\" recalculates the pre-flight diff in real time.",
    tradeoff: "Dead-end rejections stall launches. A pre-calculated fix lets the approver clear the block without a follow-up meeting.",
  },
];

const EVOLUTION = [
  {
    n: "01",
    title: "Layout and hierarchy",
    sub: "From dashboard clutter to exception-first triage",
    draftTag: "Generic data table",
    draft: "Every agent action got equal visual weight. Resulted in executive alert fatigue and high cognitive load.",
    finalTag: "Exception-first triage",
    final: "A triage flow separating high-risk human gates (REQ-842) from safe, silent automation (REQ-843).",
    principle: "Signal-to-noise ratio",
    impact: "Cut executive triage time from 15 minutes to under 2",
  },
  {
    n: "02",
    title: "Information architecture",
    sub: "From disruptive modals to inline drawers",
    draftTag: "Blocking modal",
    draft: "A pop-up for compliance warnings. Hid the surrounding budget context and forced a jarring context switch.",
    finalTag: "Inline evidence drawer",
    final: "A right-hand drawer ([DPA §4.2]) that surfaces legal proof beside the decision card, queue still in view.",
    principle: "Contextual continuity",
    impact: "Removed multi-tab switching for compliance review",
  },
  {
    n: "03",
    title: "Action model",
    sub: "From dead-end rejections to one-click steering",
    draftTag: "Approve / reject",
    draft: "A standard binary choice. Resulted in team friction, stalled projects and dead-end admin blocks.",
    finalTag: "Remediation toggles",
    final: "Pre-calculated fixes (\"Enforce EU-Only Data Scope\") that recalculate the pre-flight diff live before release.",
    principle: "Remediation over restriction",
    impact: "Kept velocity high without loosening InfoSec review",
  },
];
---

<Base
  title="Runtime Governance for Enterprise AI Agents | Kishore Sudhamalla"
  description="How I designed a human-in-the-loop Agent Control Plane that stops budget overruns and regional compliance breaches before they happen."
>
  <!-- 1. Hero + early interactive proof -->
  <section class="container-pg aw-hero" data-reveal>
    <p class="aw-eyebrow"><span class="aw-rule"></span>Flagship case study &middot; AI governance &amp; enterprise SaaS</p>
    <h1 class="aw-title">Runtime Governance for Enterprise AI Agents</h1>
    <p class="aw-lede">
      Autonomous agents can sign contracts and move customer data in milliseconds. I designed the control plane that catches budget overruns and GDPR violations before execution.
    </p>

    <div class="aw-meta-strip">
      <span class="aw-chip"><b>Role</b> Principal Product Designer</span>
      <span class="aw-chip"><b>Scope</b> Strategy, systems architecture, live code prototype</span>
      <span class="aw-chip"><b>Buyers</b> VP Finance &amp; InfoSec</span>
    </div>

    <div class="aw-proto-tabs">
      <ProtoTabs
        client:load
        prototypeUrl={PROTOTYPE_URL}
        screenshotSrc={`${IMG}/hero.png`}
        screenshotAlt="Agent Control Plane showing REQ-842 (VectorScale AI Enterprise) paused at Human Gate, Budget + GDPR §4.2"
      />
    </div>
  </section>

  <article class="container-pg r-case">
    <!-- 2. The core tension -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="context">The blind spot</SectionLabel>
      <h2>Agents move at machine speed. Enterprise approvals do not.</h2>

      <div class="aw-contrast">
        <div class="aw-contrast-col aw-contrast-col--muted">
          <p class="aw-contrast-k">Why current tools fail</p>
          <ul class="aw-contrast-list">
            <li>Developer observability (LangSmith) is unreadable to finance leads.</li>
            <li>Slack "approve / reject" pings cause alert fatigue and blind rubber-stamping.</li>
            <li>Post-mortem audit logs run after European data has already crossed borders.</li>
          </ul>
        </div>
        <div class="aw-contrast-col aw-contrast-col--bold">
          <p class="aw-contrast-k">The control plane shift</p>
          <ul class="aw-contrast-list">
            <li>Pre-flight interception halts high-risk actions before spend occurs.</li>
            <li>Zero-context-switch evidence drawers pair legal citations with budget deltas.</li>
            <li>Actionable steering replaces dead ends with one-click Frankfurt reroutes.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 3. Design principles -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="judgment">How I framed the system</SectionLabel>
      <h2>Four rules that governed every pixel.</h2>

      <div class="aw-principles">
        {PRINCIPLES.map((p) => (
          <div class="aw-pcard">
            <div class="aw-pcard-head">
              <span class="aw-pcard-n">{p.n}</span>
              <span class="aw-pcard-tag">{p.tag}</span>
            </div>
            <h3 class="aw-pcard-title">{p.title}</h3>
            <p class="aw-pcard-body">{p.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Systems architecture -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="systems">Systems thinking</SectionLabel>
      <h2>Turning static legal PDFs into runtime guardrails.</h2>
      <p class="aw-tight">
        Global enterprises run across dozens of jurisdictions. A central Policies engine parses regional laws and department budgets into live pre-flight checks.
      </p>

      <div class="aw-arch" role="img" aria-label="Architecture diagram: Finance rules and country policies feed into a Control Plane Interceptor, which branches into Auto-Execute or Pause and Steer">
        <div class="aw-arch-col">
          <div class="aw-arch-node aw-arch-node--input">
            <p class="aw-arch-node-k">Input</p>
            <p class="aw-arch-node-v">Finance rules<br/><span class="aw-arch-mono">Q4 dept caps</span></p>
          </div>
          <div class="aw-arch-node aw-arch-node--input">
            <p class="aw-arch-node-k">Input</p>
            <p class="aw-arch-node-v">Country policies<br/><span class="aw-arch-mono">GDPR §4.2</span></p>
          </div>
        </div>

        <svg class="aw-arch-wires aw-arch-wires--in" viewBox="0 0 60 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 20 Q 30 20 30 50 Q 30 80 60 80" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <path d="M0 80 Q 30 80 30 50 Q 30 20 60 20" fill="none" stroke="currentColor" stroke-width="1.5"/>
        </svg>

        <div class="aw-arch-node aw-arch-node--core">
          <p class="aw-arch-node-k">Core</p>
          <p class="aw-arch-node-v">Control Plane<br/>Interceptor</p>
        </div>

        <svg class="aw-arch-wires aw-arch-wires--out" viewBox="0 0 60 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 20 Q 30 20 30 50 Q 30 80 60 80" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <path d="M0 80 Q 30 80 30 50 Q 30 20 60 20" fill="none" stroke="currentColor" stroke-width="1.5"/>
        </svg>

        <div class="aw-arch-col">
          <div class="aw-arch-node aw-arch-node--good">
            <p class="aw-arch-node-k">Output</p>
            <p class="aw-arch-node-v">Auto-execute<br/><span class="aw-arch-mono">REQ-843</span></p>
          </div>
          <div class="aw-arch-node aw-arch-node--warn">
            <p class="aw-arch-node-k">Output</p>
            <p class="aw-arch-node-v">Pause &amp; steer<br/><span class="aw-arch-mono">REQ-842</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Interactive UI teardown -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="craft">Interaction craft</SectionLabel>
      <h2>Anatomy of the decision workspace.</h2>
      <p class="aw-tight">Click a pin to open the decision behind it.</p>

      <HotspotInspector
        client:visible
        imageSrc={`${IMG}/anatomy-annotated.png`}
        imageAlt="Agent Control Plane workspace with the evidence drawer open, four numbered hotspots over the triage queue, risk card, evidence drawer and steering panel"
        pins={PINS}
      />
    </section>

    <!-- 5b. Evolution of the control plane -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="judgment">Design evolution &amp; craft</SectionLabel>
      <h2>Turning raw AI output into executive-ready software.</h2>
      <p class="aw-tight">
        AI tools generate functional code instantly. Executive-grade UX still takes editorial judgment. Here's how I steered the system across three architectural shifts, balancing speed with enterprise governance.
      </p>

      <div class="aw-evo">
        {EVOLUTION.map((e) => (
          <div class="aw-evo-card">
            <div class="aw-evo-head">
              <span class="aw-evo-n">{e.n}</span>
              <div>
                <h3 class="aw-evo-title">{e.title}</h3>
                <p class="aw-evo-sub">{e.sub}</p>
              </div>
            </div>

            <div class="aw-evo-split">
              <div class="aw-evo-col aw-evo-col--draft">
                <div class="aw-evo-col-head">
                  <span class="aw-evo-badge aw-evo-badge--draft">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.7 17a1.8 1.8 0 0 0 1.5 2.7h15.6a1.8 1.8 0 0 0 1.5-2.7L13.7 3.9a1.8 1.8 0 0 0-3.4 0Z"/></svg>
                    Draft 1
                  </span>
                  <span class="aw-evo-state">{e.draftTag}</span>
                </div>
                <p class="aw-evo-body">{e.draft}</p>
              </div>

              <div class="aw-evo-col aw-evo-col--final">
                <div class="aw-evo-col-head">
                  <span class="aw-evo-badge aw-evo-badge--final">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                    Final design
                  </span>
                  <span class="aw-evo-state aw-evo-state--final">{e.finalTag}</span>
                </div>
                <p class="aw-evo-body">{e.final}</p>
              </div>
            </div>

            <div class="aw-evo-foot">
              <span class="aw-evo-foot-item"><b>Principle</b> {e.principle}</span>
              <span class="aw-evo-foot-item aw-evo-foot-item--impact"><b>Impact</b> {e.impact}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. Edge cases + reusable patterns -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="validated">Scalable patterns</SectionLabel>
      <h2>Reusable primitives for AI-native enterprise software.</h2>

      <div class="aw-patterns">
        <div class="aw-pattern">
          <p class="aw-pattern-k">The pre-flight diff</p>
          <div class="aw-pattern-mini">
            <span class="aw-pattern-chip aw-pattern-chip--bad">$42k</span>
            <span class="aw-pattern-arrow">&rarr;</span>
            <span class="aw-pattern-chip aw-pattern-chip--good">$21k</span>
          </div>
          <div class="aw-pattern-mini">
            <span class="aw-pattern-chip aw-pattern-chip--bad">US-East</span>
            <span class="aw-pattern-arrow">&rarr;</span>
            <span class="aw-pattern-chip aw-pattern-chip--good">EU-Frankfurt</span>
          </div>
          <p class="aw-pattern-body">A before-vs-after impact table, shown before an agent commits an irreversible action.</p>
        </div>

        <div class="aw-pattern">
          <p class="aw-pattern-k">Confidence escalation tiers</p>
          <div class="aw-pattern-conf">
            <span class="aw-pattern-conf-tag">REQ-844</span>
            <span class="aw-pattern-conf-score">61%</span>
          </div>
          <div class="aw-pattern-conf-bar"><div class="aw-pattern-conf-bar-fill" style="width:61%"></div></div>
          <p class="aw-pattern-body">Redacted contract clauses route to legal counsel with the missing terms highlighted, not auto-approved.</p>
        </div>

        <div class="aw-pattern">
          <p class="aw-pattern-k">Living agent pipeline</p>
          <div class="aw-pattern-chain">
            <span class="aw-pattern-node">Procurement</span>
            <span class="aw-pattern-arrow">&rarr;</span>
            <span class="aw-pattern-node">Finance</span>
            <span class="aw-pattern-arrow">&rarr;</span>
            <span class="aw-pattern-node aw-pattern-node--flag">InfoSec</span>
          </div>
          <p class="aw-pattern-body">The exact sub-agent chain stays visible, so it's clear which agent raised which flag.</p>
        </div>
      </div>
    </section>

    <!-- 7. Builder note -->
    <section class="r-case-section" data-reveal>
      <div class="aw-footer-card">
        <p class="aw-footer-k">Builder note</p>
        <h3 class="aw-footer-title">Why I built this in code, not just Figma.</h3>
        <p class="aw-footer-body">
          Static artboards cannot test alert fatigue, drawer timing or multi-factor state math. Pairing Figma systems architecture with working code in Claude Code let me stress-test real edge cases and ship an interaction model ready for production.
        </p>
      </div>
    </section>
  </article>
</Base>

<style>
  .aw-hero { padding: clamp(1.5rem, 4vw, 2.75rem) 0 clamp(2rem, 5vw, 3rem); }
  .aw-eyebrow {
    display: flex; align-items: center; gap: 0.9rem;
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-3);
    margin: 0 0 1.5rem;
  }
  .aw-rule { width: 2.25rem; height: 1px; background: var(--color-ink-3); flex-shrink: 0; }
  .aw-title {
    font-family: var(--font-display); font-weight: 700; letter-spacing: -0.03em; line-height: 1.02;
    font-size: clamp(2rem, 5vw, 3.5rem); color: var(--color-ink); margin: 0 0 1.25rem; max-width: 46rem;
  }
  .aw-lede {
    font-size: clamp(1rem, 1.5vw, 1.1875rem); line-height: 1.55; color: var(--color-ink-2);
    max-width: 38rem; margin: 0 0 1.75rem;
  }

  .aw-meta-strip { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0 0 2rem; }
  .aw-chip {
    font-size: 0.8125rem; color: var(--color-ink-2);
    padding: 0.5rem 0.9rem; border-radius: 0.5rem; border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .aw-chip b { color: var(--color-ink); font-weight: 600; margin-right: 0.3rem; }

  .aw-proto-tabs { margin-top: 0.5rem; }

  .r-case { padding-block: 0 clamp(4rem, 8vw, 6rem); }
  .r-case-section > :is(p, h2, h3, .r-decisions) { max-width: var(--measure); }
  .r-case-section { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .r-case-section h2 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.375rem, 2.6vw, 1.875rem); letter-spacing: -0.02em;
    color: var(--color-ink); margin: 0 0 1.25rem;
  }
  .r-case-section p {
    font-size: 1rem; line-height: 1.7; color: var(--color-ink-2); margin: 0 0 1.25rem;
  }
  .aw-tight { max-width: 34rem !important; margin-bottom: 1.5rem !important; }

  /* 2. Core tension contrast */
  .aw-contrast { display: grid; grid-template-columns: 1fr; gap: 1px; max-width: none; background: var(--color-border); border: 1px solid var(--color-border); border-radius: 0.875rem; overflow: hidden; }
  @media (min-width: 720px) { .aw-contrast { grid-template-columns: 1fr 1fr; } }
  .aw-contrast-col { padding: 1.5rem 1.6rem; background: var(--color-bg); }
  .aw-contrast-col--muted { opacity: 0.72; }
  .aw-contrast-col--bold { background: var(--color-surface); }
  .aw-contrast-k { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-3); margin: 0 0 1rem; }
  .aw-contrast-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .aw-contrast-list li { position: relative; padding-left: 1.1rem; font-size: 0.9375rem; line-height: 1.55; color: var(--color-ink-2); }
  .aw-contrast-list li::before { content: "–"; position: absolute; left: 0; color: var(--color-ink-3); }
  .aw-contrast-col--bold .aw-contrast-list li { color: var(--color-ink); }

  /* 3. Design principles 2x2 */
  .aw-principles { display: grid; grid-template-columns: 1fr; gap: 1px; max-width: none; background: var(--color-border); border: 1px solid var(--color-border); border-radius: 0.875rem; overflow: hidden; }
  @media (min-width: 640px) { .aw-principles { grid-template-columns: 1fr 1fr; } }
  .aw-pcard { background: var(--color-bg); padding: 1.4rem 1.5rem; }
  .aw-pcard-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.9rem; }
  .aw-pcard-n { font-family: var(--font-mono); font-size: 1.125rem; font-weight: 700; color: var(--color-ink-3); }
  .aw-pcard-tag {
    font-family: var(--font-mono); font-size: 0.625rem; font-weight: 600; letter-spacing: 0.04em;
    padding: 0.25rem 0.55rem; border-radius: 999px; border: 1px solid var(--color-border); color: var(--color-ink-3);
  }
  .aw-pcard-title { font-family: var(--font-display); font-weight: 700; font-size: 1.0625rem; letter-spacing: -0.01em; color: var(--color-ink); margin: 0 0 0.5rem; }
  .aw-pcard-body { font-size: 0.875rem; line-height: 1.55; color: var(--color-ink-2); margin: 0; }

  /* 4. Architecture diagram */
  .aw-arch { display: flex; align-items: center; gap: 0; max-width: none; overflow-x: auto; padding: 0.5rem 0; }
  .aw-arch-col { display: flex; flex-direction: column; gap: 0.75rem; flex-shrink: 0; }
  .aw-arch-node {
    min-width: 9.5rem; padding: 0.9rem 1.1rem; border-radius: 0.75rem; border: 1px solid var(--color-border);
    background: var(--color-surface); flex-shrink: 0;
  }
  .aw-arch-node-k { font-family: var(--font-mono); font-size: 0.5625rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-3); margin: 0 0 0.4rem; }
  .aw-arch-node-v { font-size: 0.8125rem; font-weight: 600; line-height: 1.4; color: var(--color-ink); margin: 0; }
  .aw-arch-mono { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500; color: var(--color-ink-3); }
  .aw-arch-node--core { background: var(--color-ink); border-color: var(--color-ink); }
  .aw-arch-node--core .aw-arch-node-k, .aw-arch-node--core .aw-arch-node-v { color: var(--color-bg); }
  .aw-arch-node--good { border-color: color-mix(in srgb, #4f8a7c 45%, var(--color-border)); background: color-mix(in srgb, #4f8a7c 8%, var(--color-surface)); }
  .aw-arch-node--warn { border-color: color-mix(in srgb, #c17a4a 45%, var(--color-border)); background: color-mix(in srgb, #c17a4a 8%, var(--color-surface)); }
  .aw-arch-wires { width: 2.5rem; height: 6rem; color: var(--color-ink-3); flex-shrink: 0; }

  /* 5. Hotspot inspector section spacing handled in work-interactive.css */

  /* 5b. Evolution of the control plane */
  .aw-evo { display: flex; flex-direction: column; gap: 1.5rem; max-width: none; }
  .aw-evo-card {
    padding: 1.75rem 1.75rem 1.5rem; border: 1px solid var(--color-border); border-radius: 1rem;
    background: var(--color-bg);
  }
  .aw-evo-head { display: flex; gap: 1rem; margin-bottom: 1.4rem; }
  .aw-evo-n { flex-shrink: 0; font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 700; color: var(--color-ink-3); line-height: 1.5; }
  .aw-evo-title { font-family: var(--font-display); font-weight: 700; font-size: 1.0625rem; letter-spacing: -0.01em; color: var(--color-ink); margin: 0 0 0.25rem; }
  .aw-evo-sub { font-size: 0.8125rem; color: var(--color-ink-3); margin: 0; }

  .aw-evo-split { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-bottom: 1.1rem; }
  @media (min-width: 640px) { .aw-evo-split { grid-template-columns: 1fr 1fr; align-items: stretch; } }

  .aw-evo-col { border-radius: 0.75rem; padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); }
  .aw-evo-col--draft { background: var(--color-surface); opacity: 0.82; }
  .aw-evo-col--final {
    background: color-mix(in srgb, #4f8a7c 6%, var(--color-surface));
    border-color: color-mix(in srgb, #4f8a7c 42%, var(--color-border));
