---
/**
 * Flagship case study: Runtime Governance for Enterprise AI Agents
 * (Agent Control Plane). A concept project, not a shipped Darwinbox product,
 * so the human figures (VectorScale AI, REQ-842, Dana Okafor, etc.) are
 * illustrative throughout rather than client data.
 *
 * High text-to-diagram ratio on purpose: this is the flagship case study,
 * styled closer to a product teardown (Linear/Stripe Press register) than
 * the prose-first case studies elsewhere on the site. Two React islands
 * carry the interactivity (ProtoTabs, HotspotInspector); everything else
 * is static Astro + CSS, matching the rest of the site's convention.
 */
import Base from "../../layouts/Base.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import { HotspotInspector, type Pin } from "../../components/work/HotspotInspector.tsx";
import { BeforeAfterShowcase } from "../../components/work/BeforeAfterShowcase.tsx";

// Deployed Agent Control Plane prototype, built and checked into
// public/demo/agent-control-plane/.
const PROTOTYPE_URL = "/demo/agent-control-plane/index.html";
const IMG = "/images/work/agent-control-plane";

const RISKS = [
  {
    k: "Unbudgeted capital burn",
    v: "An agent provisioning compute or renewing contracts without spend caps can blow a quarter's budget in seconds.",
  },
  {
    k: "Cross-border regulatory fines",
    v: "Routing EU customer telemetry to a US server breaks GDPR residency law, exposing the company to multi-million-dollar penalties.",
  },
  {
    k: "Executive alert fatigue",
    v: "Fifty context-free \"approve or reject\" Slack pings a day train VP and InfoSec leaders to rubber-stamp risk.",
  },
];

const COMPETITORS = [
  {
    n: "01",
    category: "LLM observability",
    logos: ["LangSmith", "Weights & Biases"],
    does: "Debug token latency, prompt chains and model drift for engineers.",
    blindSpot: "Unreadable to a VP of Finance or InfoSec lead checking contract caps or GDPR residency.",
  },
  {
    n: "02",
    category: "Procurement & compliance",
    logos: ["Coupa", "Vanta"],
    does: "Manage manual purchase tickets and periodic compliance checklists.",
    blindSpot: "Built for multi-day workflows. Too slow to intercept a 200ms agent transaction.",
  },
  {
    n: "03",
    category: "ChatOps notifications",
    logos: ["Slack", "Microsoft Teams"],
    does: "Route binary approve or reject webhook alerts into a team channel.",
    blindSpot: "Strips away budget and legal context, training leaders to rubber-stamp risk.",
  },
  {
    n: "04",
    category: "Identity & access gateways",
    logos: ["Okta", "AWS IAM"],
    does: "Enforce static allow or deny rules for system access.",
    blindSpot: "Hard blocks stall launches. Cannot steer an agent to reroute data or cap spend.",
  },
];

const PRINCIPLES = [
  {
    n: "01",
    tag: "REQ-843",
    title: "Silence for safe work",
    body: "Routine renewals within budget auto-execute silently. Only interrupt humans when a threshold breaks.",
  },
  {
    n: "02",
    tag: "No bare approve",
    title: "Context over rubber-stamps",
    body: "Never render a standalone \"Approve\" button. Pair every dollar figure with its compliance impact.",
  },
  {
    n: "03",
    tag: "No dead ends",
    title: "Fixes over hard stops",
    body: "A blocked message stalls teams. Every policy trigger calculates a safe alternative on the spot.",
  },
  {
    n: "04",
    tag: "Every override",
    title: "Proof by default",
    body: "Every human override, cap change or region reroute writes an immutable audit receipt automatically.",
  },
];

const PINS: Pin[] = [
  {
    x: 27, y: 17,
    tag: "Triage queue",
    title: "Exception-first triage queue",
    body: "The top filter bar separates work into Needs Attention, Escalated and Auto-Executed, instead of one noisy event stream.",
    tradeoff: "A VP of Finance clears high-risk blocks in two minutes, trusting that safe renewals keep running in the background unseen.",
  },
  {
    x: 24, y: 24,
    tag: "REQ-842",
    title: "Multi-factor risk card",
    body: "Finance and InfoSec signals live on one object. REQ-842 shows $12k over Q4 budget and a GDPR §4.2 conflict, together.",
    tradeoff: "Most companies split these across two tools. Combining them means one card, not two separate approvals to chase.",
  },
  {
    x: 76, y: 48,
    tag: "[DPA §4.2]",
    title: "Inline evidence drawer",
    body: "Clicking [DPA §4.2] slides open a right-hand drawer with the exact vendor telemetry clause, no modal, no lost context.",
    tradeoff: "I rejected a blocking modal here. It hid the budget numbers the approver needed to see at the same time.",
  },
  {
    x: 24, y: 53,
    tag: "Steer panel",
    title: "Live steering toggles",
    body: "Toggling \"Enforce EU-Only Data Scope\" or \"6-Month Pilot Cap\" recalculates the pre-flight diff in real time.",
    tradeoff: "Dead-end rejections stall launches. A pre-calculated fix lets the approver clear the block without a follow-up meeting.",
  },
];

---

<Base
  title="Runtime Governance for Enterprise AI Agents | Kishore Sudhamalla"
  description="How I designed a human-in-the-loop Agent Control Plane that stops budget overruns and regional compliance breaches before they happen."
>
  <!-- 1. Hero + early interactive proof -->
  <section class="container-pg aw-hero" data-reveal>
    <p class="aw-eyebrow"><span class="aw-rule"></span>Flagship case study &middot; AI governance &amp; enterprise SaaS</p>
    <h1 class="aw-title">Runtime Governance for Enterprise AI Agents</h1>
    <p class="aw-lede">
      Autonomous agents can sign contracts and move customer data in milliseconds. I designed the human-in-the-loop control plane that catches budget overruns and GDPR violations before execution.
    </p>

    <div class="aw-meta-strip">
      <span class="aw-chip"><b>Role</b> Principal Product Designer</span>
      <span class="aw-chip"><b>Scope</b> Strategy, systems architecture, live code prototype</span>
      <span class="aw-chip"><b>Buyers</b> VP Finance &amp; InfoSec</span>
    </div>

    <figure class="aw-hero-shot">
      <div class="aw-hero-frame">
        <img src={`${IMG}/hero.png`} alt="Agent Control Plane showing REQ-842 (VectorScale AI Enterprise) paused at Human Gate, Budget + GDPR §4.2" />
      </div>
      <figcaption class="aw-hero-caption">REQ-842 paused at the Human Gate: $42,000 over budget, GDPR §4.2 conflict.</figcaption>
    </figure>
  </section>

  <article class="container-pg r-case">
    <!-- 01. The enterprise risk -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="impact">01 &middot; The enterprise risk</SectionLabel>
      <h2>When software acts on its own, a 200ms mistake costs millions.</h2>
      <p class="aw-tight">
        Traditional SaaS waited for humans to click buttons. Autonomous agents execute at machine speed, exposing three operational failures.
      </p>

      <div class="aw-risk">
        {RISKS.map((r) => (
          <div class="aw-risk-card">
            <p class="aw-risk-k">{r.k}</p>
            <p class="aw-risk-v">{r.v}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 02. Competitive landscape -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="context">02 &middot; Competitive landscape</SectionLabel>
      <h2>Existing tools were built for developers or slow human tickets, not autonomous agents.</h2>
      <p class="aw-tight">
        Before designing the control plane, I audited four tool categories enterprises stitch together today. Every one breaks down once software acts autonomously.
      </p>

      <div class="aw-compete">
        {COMPETITORS.map((c) => (
          <div class="aw-compete-card">
            <p class="aw-compete-n">{c.n}</p>
            <div class="aw-compete-logos">
              {c.logos.map((l) => <span class="aw-compete-logo">{l}</span>)}
            </div>
            <p class="aw-compete-cat">{c.category}</p>
            <p class="aw-compete-does">{c.does}</p>
            <div class="aw-compete-blind">
              <p class="aw-compete-blind-k">The blind spot</p>
              <p class="aw-compete-blind-v">{c.blindSpot}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="aw-core">
        <p class="aw-core-badge">The core problem</p>
        <h3 class="aw-core-title">Enterprises lack a runtime layer that turns legal and financial rules into live, steerable guardrails.</h3>
        <p class="aw-core-body">
          Today, companies choose between shutting agents off completely or letting them spend and move data unchecked. The Agent Control Plane closes that gap: pausing high-risk actions in real time and giving leaders one-click fixes before execution.
        </p>
      </div>
    </section>

    <!-- 03. Systems thinking -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="systems">03 &middot; Systems thinking</SectionLabel>
      <h2>Four rules, and the pipeline that enforces them.</h2>

      <div class="aw-principles">
        {PRINCIPLES.map((p) => (
          <div class="aw-pcard">
            <div class="aw-pcard-head">
              <span class="aw-pcard-n">{p.n}</span>
              <span class="aw-pcard-tag">{p.tag}</span>
            </div>
            <h3 class="aw-pcard-title">{p.title}</h3>
            <p class="aw-pcard-body">{p.body}</p>
          </div>
        ))}
      </div>

      <p class="aw-tight aw-arch-intro">
        Global enterprises run across dozens of jurisdictions. A central Policies engine parses regional laws and department budgets into live pre-flight checks.
      </p>

      <div class="aw-arch" role="img" aria-label="Architecture diagram: Finance rules and country policies feed into a Control Plane Interceptor, which branches into Auto-Execute or Pause and Steer">
        <div class="aw-arch-col">
          <div class="aw-arch-node aw-arch-node--input">
            <p class="aw-arch-node-k">Input</p>
            <p class="aw-arch-node-v">Finance rules<br/><span class="aw-arch-mono">Q4 dept caps</span></p>
          </div>
          <div class="aw-arch-node aw-arch-node--input">
            <p class="aw-arch-node-k">Input</p>
            <p class="aw-arch-node-v">Country policies<br/><span class="aw-arch-mono">GDPR §4.2</span></p>
          </div>
        </div>

        <svg class="aw-arch-wires aw-arch-wires--in" viewBox="0 0 60 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 20 Q 30 20 30 50 Q 30 80 60 80" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <path d="M0 80 Q 30 80 30 50 Q 30 20 60 20" fill="none" stroke="currentColor" stroke-width="1.5"/>
        </svg>

        <div class="aw-arch-node aw-arch-node--core">
          <p class="aw-arch-node-k">Core</p>
          <p class="aw-arch-node-v">Control Plane<br/>Interceptor</p>
        </div>

        <svg class="aw-arch-wires aw-arch-wires--out" viewBox="0 0 60 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 20 Q 30 20 30 50 Q 30 80 60 80" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <path d="M0 80 Q 30 80 30 50 Q 30 20 60 20" fill="none" stroke="currentColor" stroke-width="1.5"/>
        </svg>

        <div class="aw-arch-col">
          <div class="aw-arch-node aw-arch-node--good">
            <p class="aw-arch-node-k">Output</p>
            <p class="aw-arch-node-v">Auto-execute<br/><span class="aw-arch-mono">REQ-843</span></p>
          </div>
          <div class="aw-arch-node aw-arch-node--warn">
            <p class="aw-arch-node-k">Output</p>
            <p class="aw-arch-node-v">Pause &amp; steer<br/><span class="aw-arch-mono">REQ-842</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 04. Interactive UI teardown -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="craft">04 &middot; Interaction craft</SectionLabel>
      <h2>Anatomy of the decision workspace.</h2>
      <p class="aw-tight">Click a pin to open the decision behind it.</p>

      <HotspotInspector
        client:visible
        imageSrc={`${IMG}/anatomy-annotated.png`}
        imageAlt="Agent Control Plane workspace with the evidence drawer open, four numbered hotspots over the triage queue, risk card, evidence drawer and steering panel"
        pins={PINS}
      />
    </section>

    <!-- 05. Visual evolution: before/after slider -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="judgment">05 &middot; Visual evolution</SectionLabel>
      <h2>Steering raw AI output into executive-grade craft.</h2>
      <p class="aw-tight">Drag the slider to inspect how I restructured hierarchy, removed blocking modals, and added live remediation.</p>

      <BeforeAfterShowcase
        client:visible
        beforeSrc="/images/acp-draft-1.png"
        afterSrc="/images/acp-final.webp"
        pins={[
          { x: 35, y: 9, label: "Exception-first queue: separated safe auto-runs from human gates." },
          { x: 89, y: 52, label: "Inline evidence drawer: replaced blocking modal with zero-switch DPA proof." },
          { x: 49, y: 54, label: "Live steering toggles: turned dead-end blocks into 1-click fixes." },
        ]}
      />

      <div class="bas-delta">
        <div class="bas-delta-col">
          <p class="bas-delta-k">Hierarchy</p>
          <p class="bas-delta-v"><span class="bas-delta-from">14 equal-weight rows</span><span class="bas-delta-arrow">&rarr;</span><span class="bas-delta-to">3 priority triage tiers</span></p>
        </div>
        <div class="bas-delta-col">
          <p class="bas-delta-k">Compliance flow</p>
          <p class="bas-delta-v"><span class="bas-delta-from">Blocking modal</span><span class="bas-delta-arrow">&rarr;</span><span class="bas-delta-to">Inline evidence drawer</span></p>
        </div>
        <div class="bas-delta-col">
          <p class="bas-delta-k">Resolution</p>
          <p class="bas-delta-v"><span class="bas-delta-from">Binary reject button</span><span class="bas-delta-arrow">&rarr;</span><span class="bas-delta-to">Live remediation toggles</span></p>
        </div>
      </div>
    </section>

    <!-- 06. Working product: live prototype -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="film">06 &middot; Working product</SectionLabel>
      <h2>Test the live Agent Control Plane.</h2>

      <div class="aw-steps">
        <span class="aw-step"><span class="aw-step-n">1</span>Click <code>REQ-842</code> in the queue</span>
        <span class="aw-step-arrow" aria-hidden="true">&rarr;</span>
        <span class="aw-step"><span class="aw-step-n">2</span>Click <code>[DPA §4.2]</code> to inspect vendor telemetry</span>
        <span class="aw-step-arrow" aria-hidden="true">&rarr;</span>
        <span class="aw-step"><span class="aw-step-n">3</span>Toggle remediation fixes to clear the block</span>
      </div>

      <div class="aw-embed">
        <div class="aw-embed-bar">
          <span class="aw-embed-label">Agent Control Plane: Enterprise Spend &amp; Compliance Governance</span>
          <a href={PROTOTYPE_URL} target="_blank" rel="noopener noreferrer" class="aw-embed-open">
            Open fullscreen
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
        </div>
        <div class="aw-embed-frame">
          <iframe src={PROTOTYPE_URL} title="Agent Control Plane live prototype" loading="lazy"></iframe>
        </div>
      </div>
    </section>

    <!-- 07. Reusable patterns + builder note -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="validated">07 &middot; Scalable patterns</SectionLabel>
      <h2>Reusable primitives for AI-native enterprise software.</h2>

      <div class="aw-patterns">
        <div class="aw-pattern">
          <p class="aw-pattern-k">The pre-flight diff</p>
          <div class="aw-pattern-mini">
            <span class="aw-pattern-chip aw-pattern-chip--bad">$42k</span>
            <span class="aw-pattern-arrow">&rarr;</span>
            <span class="aw-pattern-chip aw-pattern-chip--good">$21k</span>
          </div>
          <div class="aw-pattern-mini">
            <span class="aw-pattern-chip aw-pattern-chip--bad">US-East</span>
            <span class="aw-pattern-arrow">&rarr;</span>
            <span class="aw-pattern-chip aw-pattern-chip--good">EU-Frankfurt</span>
          </div>
          <p class="aw-pattern-body">A before-vs-after impact table, shown before an agent commits an irreversible action.</p>
        </div>

        <div class="aw-pattern">
          <p class="aw-pattern-k">Confidence escalation tiers</p>
          <div class="aw-pattern-conf">
            <span class="aw-pattern-conf-tag">REQ-844</span>
            <span class="aw-pattern-conf-score">61%</span>
          </div>
          <div class="aw-pattern-conf-bar"><div class="aw-pattern-conf-bar-fill" style="width:61%"></div></div>
          <p class="aw-pattern-body">Redacted contract clauses route to legal counsel with the missing terms highlighted, not auto-approved.</p>
        </div>

        <div class="aw-pattern">
          <p class="aw-pattern-k">Living agent pipeline</p>
          <div class="aw-pattern-chain">
            <span class="aw-pattern-node">Procurement</span>
            <span class="aw-pattern-arrow">&rarr;</span>
            <span class="aw-pattern-node">Finance</span>
            <span class="aw-pattern-arrow">&rarr;</span>
            <span class="aw-pattern-node aw-pattern-node--flag">InfoSec</span>
          </div>
          <p class="aw-pattern-body">The exact sub-agent chain stays visible, so it's clear which agent raised which flag.</p>
        </div>
      </div>
    </section>

    <!-- 7. Builder note -->
    <section class="r-case-section" data-reveal>
      <div class="aw-footer-card">
        <p class="aw-footer-k">Builder note</p>
        <h3 class="aw-footer-title">Why I built this in code, not just Figma.</h3>
        <p class="aw-footer-body">
          Static artboards cannot test alert fatigue, drawer timing or multi-factor state math. Pairing Figma systems architecture with working code in Claude Code let me stress-test real edge cases and ship an interaction model ready for production.
        </p>
      </div>
    </section>
  </article>
</Base>

<style>
  .aw-hero { padding: clamp(1.5rem, 4vw, 2.75rem) 0 clamp(2rem, 5vw, 3rem); }
  .aw-eyebrow {
    display: flex; align-items: center; gap: 0.9rem;
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-3);
    margin: 0 0 1.5rem;
  }
  .aw-rule { width: 2.25rem; height: 1px; background: var(--color-ink-3); flex-shrink: 0; }
  .aw-title {
    font-family: var(--font-display); font-weight: 700; letter-spacing: -0.03em; line-height: 1.02;
    font-size: clamp(2rem, 5vw, 3.5rem); color: var(--color-ink); margin: 0 0 1.25rem; max-width: 46rem;
  }
  .aw-lede {
    font-size: clamp(1rem, 1.5vw, 1.1875rem); line-height: 1.55; color: var(--color-ink-2);
    max-width: 38rem; margin: 0 0 1.75rem;
  }

  .aw-meta-strip { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0 0 2rem; }
  .aw-chip {
    font-size: 0.8125rem; color: var(--color-ink-2);
    padding: 0.5rem 0.9rem; border-radius: 0.5rem; border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .aw-chip b { color: var(--color-ink); font-weight: 600; margin-right: 0.3rem; }

  .aw-hero-shot { margin: 0.5rem 0 0; }
  .aw-hero-frame { border: 1px solid var(--color-border); border-radius: 0.875rem; overflow: hidden; background: var(--color-surface); }
  .aw-hero-frame img { display: block; width: 100%; height: auto; }
  .aw-hero-caption { margin: 0.9rem 0 0; font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-3); }

  .r-case { padding-block: 0 clamp(4rem, 8vw, 6rem); }
  .r-case-section > :is(p, h2, h3, .r-decisions) { max-width: var(--measure); }
  .r-case-section { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .r-case-section h2 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.375rem, 2.6vw, 1.875rem); letter-spacing: -0.02em;
    color: var(--color-ink); margin: 0 0 1.25rem;
  }
  .r-case-section p {
    font-size: 1rem; line-height: 1.7; color: var(--color-ink-2); margin: 0 0 1.25rem;
  }
  .aw-tight { max-width: 34rem !important; margin-bottom: 1.5rem !important; }

  /* 01. Enterprise risk matrix */
  .aw-risk { display: grid; grid-template-columns: 1fr; gap: 1px; max-width: none; background: var(--color-border); border: 1px solid var(--color-border); border-radius: 0.875rem; overflow: hidden; }
  @media (min-width: 760px) { .aw-risk { grid-template-columns: repeat(3, 1fr); } }
  .aw-risk-card { background: var(--color-bg); padding: 1.4rem 1.5rem; }
  .aw-risk-k { font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin: 0 0 0.6rem; }
  .aw-risk-v { font-size: 0.875rem; line-height: 1.55; color: var(--color-ink-2); margin: 0; }

  /* 02. Competitive landscape grid + core problem callout */
  .aw-compete { display: grid; grid-template-columns: 1fr; gap: 1px; max-width: none; background: var(--color-border); border: 1px solid var(--color-border); border-radius: 0.875rem; overflow: hidden; margin-bottom: 1.5rem; }
  @media (min-width: 560px) { .aw-compete { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 960px) { .aw-compete { grid-template-columns: repeat(4, 1fr); } }
  .aw-compete-card { background: var(--color-bg); padding: 1.25rem 1.3rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .aw-compete-n { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; color: var(--color-ink-3); margin: 0; }
  .aw-compete-logos { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .aw-compete-logo {
    font-family: var(--font-display); font-weight: 700; font-size: 0.75rem; letter-spacing: -0.01em;
    padding: 0.3rem 0.6rem; border-radius: 0.4rem; border: 1px solid var(--color-border); color: var(--color-ink-2);
  }
  .aw-compete-cat { font-family: var(--font-mono); font-size: 0.625rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-3); margin: 0; }
  .aw-compete-does { font-size: 0.8125rem; line-height: 1.5; color: var(--color-ink-2); margin: 0; }
  .aw-compete-blind { margin-top: auto; padding-top: 0.7rem; border-top: 1px dashed var(--color-border); }
  .aw-compete-blind-k { font-family: var(--font-mono); font-size: 0.5625rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #b8604f; margin: 0 0 0.35rem; }
  .aw-compete-blind-v { font-size: 0.75rem; line-height: 1.5; color: var(--color-ink-2); margin: 0; }

  .aw-core {
    max-width: none; padding: 1.75rem 2rem; border: 1px solid var(--color-border); border-radius: 0.875rem;
    background: color-mix(in srgb, #2e63e0 5%, var(--color-surface));
  }
  .aw-core-badge { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #2e63e0; margin: 0 0 0.9rem; }
  .aw-core-title { font-family: var(--font-display); font-weight: 700; font-size: 1.1875rem; letter-spacing: -0.01em; line-height: 1.35; color: var(--color-ink); margin: 0 0 0.9rem; max-width: 42rem; }
  .aw-core-body { font-size: 0.9375rem; line-height: 1.6; color: var(--color-ink-2); margin: 0; max-width: 42rem; }

  /* 3. Design principles 2x2 */
