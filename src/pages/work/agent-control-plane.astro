<script>
  // Progress rail: highlight the dot for whichever of the 8 sections is
  // most in view. One observer, re-bound on each page load since this is
  // a single long page (no view-transition re-entry concern here, but the
  // pattern matches the rest of the site's astro:page-load convention).
  function initRail() {
    const dots = document.querySelectorAll<HTMLAnchorElement>("[data-rail-target]");
    if (!dots.length) return;
    const map = new Map<string, HTMLAnchorElement>();
    dots.forEach((d) => map.set(d.dataset.railTarget!, d));

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const dot = map.get(entry.target.id);
          if (!dot) return;
          dot.classList.toggle("is-active", entry.isIntersecting);
        });
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
    );
    map.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
  initRail();
  document.addEventListener("astro:page-load", initRail);
</script>
