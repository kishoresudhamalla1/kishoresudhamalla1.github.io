---
/**
 * Flagship case study: Runtime Governance for Enterprise AI Agents
 * (Agent Control Plane). A concept project, not a shipped Darwinbox product,
 * so the human-figures (VectorScale AI, REQ-842, etc.) are illustrative
 * throughout the page rather than client data.
 */
import Base from "../../layouts/Base.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import ShotPlaceholder from "../../components/ShotPlaceholder.astro";

// Deployed Agent Control Plane prototype, built and checked into
// public/demo/agent-control-plane/.
const PROTOTYPE_URL = "/demo/agent-control-plane/index.html";

const IMG = "/images/work/agent-control-plane";

const QUESTIONS = [
  {
    q: "Who owns the risk?",
    a: "I designed the experience around two specific enterprise buyers: Dana Okafor (VP of Finance) and InfoSec Leads. They do not care how the LLM works under the hood, they care about budget limits, vendor contracts and legal boundaries.",
  },
  {
    q: "When should the system interrupt a human?",
    a: "If an agent blocks every routine task, teams will turn the system off. Routine, compliant actions, like renewing an existing seat license within budget (REQ-843, Figma Dev Mode), must auto-execute silently. Humans should only step in when a threshold is crossed.",
  },
  {
    q: "How do we stop blind approvals?",
    a: "Never show a standalone \"Approve\" button. Every decision card must pair the financial cost with the exact policy conflict right next to it.",
  },
  {
    q: "What replaces a dead-end error?",
    a: "A hard \"Blocked\" message creates friction between Legal and Engineering. Whenever a policy triggers, the system must calculate safe alternatives so the approver can fix the issue on the spot.",
  },
  {
    q: "How do we prove compliance later?",
    a: "Every human override, cap adjustment or server reroute must generate a timestamped audit record automatically.",
  },
];

const DECISIONS = [
  {
    n: "1",
    title: "Exception-first triage queue",
    body: "Instead of a noisy stream of every agent event, the top filter bar separates work into Needs Attention, Escalated and Auto-Executed. A VP of Finance can clear high-risk blocks in two minutes while trusting that safe renewals (REQ-843) are running smoothly in the background.",
  },
  {
    n: "2",
    title: "Multi-factor decision cards (REQ-842)",
    body: "In most companies, Finance approves the budget while InfoSec reviews data privacy in a separate tool. I combined both signals onto a single card. REQ-842 clearly displays that the $42,000/yr VectorScale AI contract is both $12,000 over Q4 budget and in conflict with EU data residency (GDPR §4.2).",
  },
  {
    n: "3",
    title: "Zero-context-switch evidence drawer",
    body: "Early on, I considered opening a full-screen modal when a user clicked a compliance warning. I rejected that approach because it hid the surrounding budget numbers. Instead, clicking [DPA §4.2] slides open a contextual evidence inspector on the right side. Approvers can read the exact vendor telemetry clause and verify the violation without losing their place in the queue.",
  },
  {
    n: "4",
    title: "Actionable steering toggles (Review & Steer)",
    body: "Dead-end rejections stall product launches. Inside the Steer Before Execution panel, I designed pre-calculated remediation toggles: \"Enforce EU-Only Data Scope\" (reroutes vendor telemetry to Frankfurt, clearing the GDPR conflict) and \"Convert to 6-Month Pilot Cap\" (drops spend from $42,000 to $21,000, clearing the budget overage). As the approver toggles these options, the system recalculates the pre-flight diff in real time before releasing the agent to execute.",
  },
];

const PATTERNS = [
  {
    title: "The pre-flight diff",
    body: "Always display a clear before vs. after impact table (spend delta, data boundary, vendor status) before an agent commits an irreversible action.",
  },
  {
    title: "The living agent pipeline",
    body: "Show the sequence of specialized sub-agents (Procurement, Finance, InfoSec) and which specific agent raised a flag. Transparency builds executive trust faster than black-box AI scores.",
  },
  {
    title: "Remediation over rejection",
    body: "Pair every policy violation with at least one safe configuration fix, so governance accelerates business instead of blocking it.",
  },
];
---

<Base
  title="Runtime Governance for Enterprise AI Agents | Kishore Sudhamalla"
  description="How I designed a human-in-the-loop Agent Control Plane that stops budget overruns and regional compliance breaches before they happen."
>
  <!-- Hero -->
  <section class="container-pg aw-hero" data-reveal>
    <p class="aw-eyebrow"><span class="aw-rule"></span>Enterprise SaaS &middot; AI Governance &middot; FinOps &amp; InfoSec</p>
    <h1 class="aw-title">Runtime Governance for Enterprise AI Agents</h1>
    <p class="aw-lede">How I designed a human-in-the-loop Agent Control Plane that stops budget overruns and regional compliance breaches before they happen.</p>

    <dl class="aw-meta">
      <div>
        <dt>Role</dt>
        <dd>Principal Product Designer, product strategy, systems architecture, interaction design, live prototyping</dd>
      </div>
      <div>
        <dt>Domain</dt>
        <dd>Enterprise SaaS, AI governance, FinOps &amp; InfoSec</dd>
      </div>
      <div>
        <dt>Deliverables</dt>
        <dd>Governance framework, interactive control plane prototype, policy ingestion engine</dd>
      </div>
    </dl>

    <a href="#live-prototype" class="aw-btn">Launch live prototype</a>

    <figure class="aw-hero-shot">
      <ShotPlaceholder
        src={`${IMG}/hero-workbench.webp`}
        ratio="16 / 9"
        alt="Agent Control Plane showing REQ-842 (VectorScale AI Enterprise) paused at Human Gate, Budget + GDPR §4.2"
        label={`Hero screenshot, Agent Control Plane showing REQ-842 (VectorScale AI Enterprise) paused at Human Gate (Budget + GDPR §4.2)\n${IMG}/hero.png`}
      />
    </figure>
  </section>

  <article class="container-pg r-case">
    <!-- 1. The problem -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="context">1. The problem</SectionLabel>
      <h2>When software acts on its own.</h2>
      <p>
        Enterprise software is changing fast. For decades, SaaS tools waited for humans to click buttons. Today, autonomous AI agents negotiate vendor contracts, provision cloud servers and route customer data in milliseconds.
      </p>
      <p>
        This speed creates a massive blind spot for enterprise buyers. When an agent acts without real-time guardrails, a single misstep can blow through a quarterly department budget or transfer European customer data to a US server, triggering millions in regulatory fines.
      </p>

      <p class="r-sub-label">Why existing tools fail enterprise buyers</p>
      <div class="aw-cards">
        <div class="aw-card">
          <p class="aw-card-k">Developer tools are unreadable to executives</p>
          <p class="aw-card-v">Platforms like LangSmith are built for engineers debugging token latency and prompt chains. A VP of Finance or InfoSec officer cannot use them to verify if a software purchase violates GDPR.</p>
        </div>
        <div class="aw-card">
          <p class="aw-card-k">Basic approval notifications cause alert fatigue</p>
          <p class="aw-card-v">Sending 50 "approve or reject" pings a day to Slack without context forces busy leaders to rubber-stamp requests just to keep work moving.</p>
        </div>
        <div class="aw-card">
          <p class="aw-card-k">Audit logs happen too late</p>
          <p class="aw-card-v">Checking logs at the end of the month only tells you what went wrong after the money is spent and the data has already left the building.</p>
        </div>
      </div>

      <p class="r-sub-label">Legacy flow vs. the control plane</p>
      <div class="aw-flow">
        <div class="aw-flow-track">
          <p class="aw-flow-track-label aw-flow-track-label--bad">Broken legacy flow</p>
          <div class="aw-flow-row">
            <span class="aw-flow-step">Agent proposes action</span>
            <span class="aw-flow-arrow" aria-hidden="true">→</span>
            <span class="aw-flow-step">Blind Slack ping</span>
            <span class="aw-flow-arrow" aria-hidden="true">→</span>
            <span class="aw-flow-step aw-flow-step--bad">Money spent / data leaked</span>
            <span class="aw-flow-arrow" aria-hidden="true">→</span>
            <span class="aw-flow-step">Post-mortem audit log</span>
          </div>
        </div>
        <div class="aw-flow-track">
          <p class="aw-flow-track-label aw-flow-track-label--good">Agent Control Plane</p>
          <div class="aw-flow-row">
            <span class="aw-flow-step">Agent proposes action</span>
            <span class="aw-flow-arrow" aria-hidden="true">→</span>
            <span class="aw-flow-step">Policy &amp; budget interceptor</span>
            <span class="aw-flow-arrow" aria-hidden="true">→</span>
            <span class="aw-flow-step">Multi-factor gate</span>
            <span class="aw-flow-arrow" aria-hidden="true">→</span>
            <span class="aw-flow-step aw-flow-step--good">Human steers &amp; resolves</span>
            <span class="aw-flow-arrow" aria-hidden="true">→</span>
            <span class="aw-flow-step">Immutable audit receipt</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Five questions -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="judgment">2. My thought process</SectionLabel>
      <h2>Five questions before drawing a pixel.</h2>
      <p>
        Before opening Figma or writing prototype code, I framed the product around five core governance questions to make sure every screen solved a real organizational risk:
      </p>
      <ol class="aw-qlist">
        {QUESTIONS.map((item) => (
          <li>
            <p class="aw-qlist-q">{item.q}</p>
            <p class="aw-qlist-a">{item.a}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 3. Systems thinking -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="systems">3. Systems thinking</SectionLabel>
      <h2>Turning static laws into runtime guardrails.</h2>
      <p>
        A Principal-level governance tool cannot rely on hardcoded rules. Global enterprises operate across dozens of countries, each with strict data laws like GDPR and the EU AI Act.
      </p>
      <p>
        To make the product scale, I designed an underlying configuration and policy ingestion layer (Policies, in the top navigation) that connects legal frameworks directly to live agent executions:
      </p>
      <ul class="r-schema-list">
        <li><strong>Department budget guardrails:</strong> finance admins set quarterly spend ceilings and auto-approval thresholds per team, for example Engineering AI tooling capped at $30k/quarter.</li>
        <li><strong>Country-level policy reading:</strong> compliance teams upload or sync regional regulations such as GDPR Articles 44 to 50 and EU AI Act data rules. The engine parses static legal clauses into programmatic checks, such as blocking telemetry routes outside Frankfurt for European records.</li>
      </ul>
      <p>
        When an engineering lead triggers an agent to buy a new vector database (REQ-842), the control plane runs a pre-flight check against both layers simultaneously.
      </p>

      <div class="aw-split">
        <figure class="aw-split-col">
          <ShotPlaceholder
            src={`${IMG}/policies.webp`}
            ratio="4 / 3"
            alt="Policies configuration view showing active regional rules (GDPR §4.2, EU AI Act) and Q4 budget caps"
            label={`Policies configuration view, active regional rules (GDPR §4.2, EU AI Act) and Q4 budget caps\n${IMG}/policies-config.png`}
          />
        </figure>
        <span class="aw-split-connector" aria-hidden="true">
          <svg width="40" height="24" viewBox="0 0 40 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <path d="M2 12h32M26 4l8 8-8 8"/>
          </svg>
        </span>
        <figure class="aw-split-col">
          <ShotPlaceholder
            src={`${IMG}/queue.webp`}
            ratio="4 / 3"
            alt="REQ-842 decision card showing how backend policy rules trigger a frontend human gate"
            label={`REQ-842 decision card, backend policy rules triggering a frontend Human Gate\n${IMG}/req-842-decision-card.png`}
          />
        </figure>
      </div>
    </section>

    <!-- 4. Anatomy of the control plane -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="craft">4. Anatomy of the control plane</SectionLabel>
      <h2>Key UX decisions.</h2>
      <p>
        Rather than scattering information across separate Finance, Legal and Procurement tabs, I unified the decision workspace into a single triage flow. Here are the four core interaction patterns I built and why I chose them:
      </p>

      <figure class="aw-annotated">
        <ShotPlaceholder
          src={`${IMG}/workbench.webp`}
          ratio="16 / 10"
          alt="Full-screen annotated UI breakdown of the Agent Control Plane workspace"
          label={`Full-screen annotated UI breakdown, numbered badges 1 to 4 mapping to the decisions below\n${IMG}/anatomy-annotated.png`}
        />
      </figure>

      <div class="r-decisions">
        {DECISIONS.map((d) => (
          <div class="aw-dcard">
            <p class="aw-dcard-n">{d.n}</p>
            <div>
              <h3 class="aw-dcard-title">{d.title}</h3>
              <p class="aw-dcard-body">{d.body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. Edge cases -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="judgment">5. Handling edge cases</SectionLabel>
      <h2>Confidence tiers and escalations.</h2>
      <p>
        Not every policy check is a clear pass or fail. Sometimes an agent encounters an ambiguous vendor contract where key terms are missing or redacted.
      </p>
      <p>
        To handle uncertainty safely, I designed an escalation confidence tier, shown in REQ-844 (custom LLM API contract): when the contract parser detects redacted clauses in the Master Services Agreement, the confidence score drops to 61%. Instead of guessing or auto-approving, the control plane routes the request to Inspect Escalation, highlighting the exact missing clauses so legal counsel can step in with full context.
      </p>

      <div class="aw-confidence">
        <div class="aw-confidence-head">
          <span class="aw-confidence-tag">REQ-844 &middot; Custom LLM API contract</span>
          <span class="aw-confidence-score">61% confidence</span>
        </div>
        <div class="aw-confidence-bar"><div class="aw-confidence-bar-fill" style="width:61%"></div></div>
        <p class="aw-confidence-note">Redacted clauses detected in the Master Services Agreement. Routed to Inspect Escalation instead of auto-approving.</p>
      </div>
    </section>

    <!-- 6. Live prototype -->
    <section id="live-prototype" class="r-case-section" data-reveal>
      <SectionLabel icon="film">6. Live interactive prototype</SectionLabel>
      <h2>Try it yourself.</h2>
      <p>
        Static screens cannot convey how it feels to clear a live compliance block. I built and deployed a working version of the Agent Control Plane so you can test the state transitions firsthand.
      </p>

      <div class="aw-walkthrough">
        <p class="aw-walkthrough-k">Try it yourself</p>
        <ol>
          <li>Select <strong>REQ-842</strong> in the left queue to inspect the dual budget and GDPR conflict.</li>
          <li>Click <strong>[DPA §4.2]</strong> under the InfoSec agent step to open the right-hand legal evidence drawer.</li>
          <li>Toggle <strong>Enforce EU-Only Data Scope</strong> and <strong>Convert to 6-Month Pilot Cap</strong> in the center workspace to watch the control plane clear the block for execution.</li>
        </ol>
      </div>

      <div class="aw-embed">
        <div class="aw-embed-bar">
          <span class="aw-embed-label">Agent Control Plane, live prototype</span>
          <a href={PROTOTYPE_URL} target="_blank" rel="noopener noreferrer" class="aw-embed-open">
            Open fullscreen
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
        </div>
        <div class="aw-embed-frame">
          <iframe src={PROTOTYPE_URL} title="Agent Control Plane live prototype" loading="lazy"></iframe>
        </div>
      </div>
    </section>

    <!-- 7. Reusable patterns -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="systems">7. Reusable patterns</SectionLabel>
      <h2>Patterns for AI-native enterprise products.</h2>
      <p>
        While designing this system, I extracted three reusable UX patterns that apply to any enterprise product integrating autonomous agents:
      </p>
      <div class="aw-cards">
        {PATTERNS.map((p) => (
          <div class="aw-card">
            <p class="aw-card-k">{p.title}</p>
            <p class="aw-card-v">{p.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 8. Builder reflection -->
    <section class="r-case-section" data-reveal>
      <SectionLabel icon="judgment">8. Builder reflection</SectionLabel>
      <h2>Why I prototyped in code.</h2>
      <p>
        Traditional static wireframes fall short when designing agentic software. You cannot feel alert fatigue, drawer timing or multi-factor state changes by clicking between flat artboards.
      </p>
      <p>
        By pairing my systems architecture in Figma with hands-on prototyping in Claude Code, I stress-tested how real compliance citations, budget math and steering toggles behave under pressure. Every interaction in the live product was refined by testing real edge cases, ensuring that when AI agents move fast, humans stay firmly in control.
      </p>
    </section>
  </article>
</Base>

<style>
  .aw-hero { padding: clamp(1.5rem, 4vw, 2.75rem) 0 clamp(2rem, 5vw, 3rem); }
  .aw-eyebrow {
    display: flex; align-items: center; gap: 0.9rem;
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-ink-3);
    margin: 0 0 1.5rem;
  }
  .aw-rule { width: 2.25rem; height: 1px; background: var(--color-ink-3); flex-shrink: 0; }
  .aw-title {
    font-family: var(--font-display); font-weight: 700; letter-spacing: -0.03em; line-height: 1.02;
    font-size: clamp(2rem, 5vw, 3.5rem); color: var(--color-ink); margin: 0 0 1.25rem; max-width: 46rem;
  }
  .aw-lede {
    font-size: clamp(1rem, 1.5vw, 1.1875rem); line-height: 1.65; color: var(--color-ink-2);
    max-width: var(--measure); margin: 0 0 2rem;
  }
  .aw-meta {
    display: grid; grid-template-columns: 1fr; gap: 1.5rem;
    margin: 0 0 2rem; padding-top: 1.75rem; border-top: 1px solid var(--color-border);
    max-width: 50rem;
  }
  @media (min-width: 640px) { .aw-meta { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .aw-meta dt {
    font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-ink-3); margin: 0 0 0.4rem;
  }
  .aw-meta dd { margin: 0; font-size: 0.875rem; font-weight: 500; line-height: 1.5; color: var(--color-ink); }

  .aw-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.8rem 1.6rem; border-radius: 100px;
    font-size: 0.875rem; font-weight: 500; text-decoration: none;
    background: var(--color-ink); color: var(--color-bg);
    transition: opacity var(--dur-micro) var(--ease-enter);
  }
  .aw-btn:hover { opacity: 0.85; }

  .aw-hero-shot { margin: 2.5rem 0 0; }

  .r-case { padding-block: 0 clamp(4rem, 8vw, 6rem); }
  .r-case-section > :is(p, h2, h3, ul, ol, .r-case-label, .r-sub-label, .r-decisions) { max-width: var(--measure); }
  .r-case-section { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .r-case-section h2 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.375rem, 2.6vw, 1.875rem); letter-spacing: -0.02em;
    color: var(--color-ink); margin: 0 0 1.25rem;
  }
  .r-case-section p {
    font-size: 1rem; line-height: 1.7; color: var(--color-ink-2); margin: 0 0 1.25rem;
  }
  .r-sub-label {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-ink-3); margin: 2rem 0 1rem !important;
  }
  .r-schema-list { margin: 0 0 1.25rem; padding: 0; list-style: none; }
  .r-schema-list li {
    position: relative; padding-left: 1.1rem; margin-bottom: 0.75rem;
    font-size: 1rem; line-height: 1.7; color: var(--color-ink-2);
  }
  .r-schema-list li::before { content: "–"; position: absolute; left: 0; color: var(--color-ink-3); }
  .r-schema-list strong { color: var(--color-ink); font-weight: 600; }
  .r-decisions { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 1.5rem; }

  /* problem cards + reusable-pattern cards share this grid */
  .aw-cards {
    display: grid; grid-template-columns: 1fr; gap: 1px;
    background: var(--color-border); border: 1px solid var(--color-border);
    border-radius: 0.875rem; overflow: hidden; max-width: var(--measure); margin: 0 0 1.25rem;
  }
  @media (min-width: 760px) { .aw-cards { grid-template-columns: repeat(3, 1fr); } }
  .aw-card { background: var(--color-bg); padding: 1.25rem 1.4rem; }
  .aw-card-k { font-size: 0.9375rem; font-weight: 600; color: var(--color-ink); margin: 0 0 0.5rem !important; }
  .aw-card-v { font-size: 0.875rem; line-height: 1.6; color: var(--color-ink-2); margin: 0 !important; }

  /* legacy vs control-plane flow */
  .aw-flow { display: flex; flex-direction: column; gap: 1.5rem; margin: 0 0 1.25rem; }
  .aw-flow-track-label {
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 0.75rem !important;
  }
  .aw-flow-track-label--bad { color: #b8604f; }
  .aw-flow-track-label--good { color: #4f8a7c; }
  .aw-flow-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .aw-flow-step {
    font-size: 0.8125rem; font-weight: 500; color: var(--color-ink-2);
    padding: 0.5rem 0.9rem; border-radius: 0.5rem; border: 1px solid var(--color-border);
    background: var(--color-surface); white-space: nowrap;
  }
  .aw-flow-step--bad { color: #b8604f; border-color: color-mix(in srgb, #b8604f 40%, var(--color-border)); background: color-mix(in srgb, #b8604f 8%, var(--color-surface)); }
  .aw-flow-step--good { color: #4f8a7c; border-color: color-mix(in srgb, #4f8a7c 40%, var(--color-border)); background: color-mix(in srgb, #4f8a7c 8%, var(--color-surface)); }
  .aw-flow-arrow { color: var(--color-ink-3); flex-shrink: 0; }

  /* five questions */
  .aw-qlist {
    margin: 0 0 1.25rem; padding: 0; list-style: none; counter-reset: aw-q;
    display: flex; flex-direction: column; gap: 1.5rem;
  }
  .aw-qlist li { counter-increment: aw-q; position: relative; padding-left: 2.5rem; }
  .aw-qlist li::before {
    content: counter(aw-q); position: absolute; left: 0; top: 0.1rem;
    width: 1.75rem; height: 1.75rem; border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-ink) 22%, transparent);
    color: var(--color-ink-3); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500;
    display: flex; align-items: center; justify-content: center;
  }
  .aw-qlist-q { font-size: 1rem; font-weight: 600; color: var(--color-ink); margin: 0 0 0.4rem !important; }
  .aw-qlist-a { font-size: 0.9375rem; line-height: 1.65; color: var(--color-ink-2); margin: 0 !important; }

  /* systems split view */
  .aw-split { display: flex; flex-direction: column; align-items: center; gap: 1rem; max-width: none; }
  @media (min-width: 760px) { .aw-split { flex-direction: row; align-items: center; } }
  .aw-split-col { flex: 1 1 0; min-width: 0; margin: 0; width: 100%; }
  .aw-split-connector { flex-shrink: 0; color: var(--color-ink-3); transform: rotate(90deg); }
  @media (min-width: 760px) { .aw-split-connector { transform: none; } }

  /* anatomy annotated shot + decision cards */
  .aw-annotated { margin: 1.5rem 0 1.75rem; max-width: none; }
  .aw-dcard { display: flex; gap: 1.25rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .aw-dcard-n {
    flex-shrink: 0; width: 2rem; height: 2rem; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 600; color: var(--color-ink-3);
