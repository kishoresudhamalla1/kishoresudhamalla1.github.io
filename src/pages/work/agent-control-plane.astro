---
/**
 * Flagship case study: Runtime Governance for Enterprise AI Agents
 * (Agent Control Plane). A concept project, not a shipped Darwinbox product,
 * so the human figures (VectorScale AI, REQ-842, Dana Okafor, etc.) are
 * illustrative throughout rather than client data.
 *
 * High text-to-diagram ratio on purpose: this is the flagship case study,
 * styled closer to a product teardown (Linear/Stripe Press register) than
 * the prose-first case studies elsewhere on the site. Two React islands
 * carry the interactivity (ProtoTabs, HotspotInspector); everything else
 * is static Astro + CSS, matching the rest of the site's convention.
 */
import Base from "../../layouts/Base.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import { HotspotInspector, type Pin } from "../../components/work/HotspotInspector.tsx";
import { BeforeAfterShowcase } from "../../components/work/BeforeAfterShowcase.tsx";

// Deployed Agent Control Plane prototype, built and checked into
// public/demo/agent-control-plane/.
const PROTOTYPE_URL = "/demo/agent-control-plane/index.html";
const IMG = "/images/work/agent-control-plane";

const ICONS = {
  flame: `<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>`,
