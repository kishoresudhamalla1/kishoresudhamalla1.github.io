const ROADMAP = [
  {
    phase: "NOW", phaseLabel: "Phase 01 · Automated regulatory sync",
    icon: ICONS.globe,
    headline: "Live European policy ingestion",
    copy: "Parses EU AI Act and GDPR updates into runtime guardrails. No manual legal rewrites.",
  },
  {
    phase: "NEXT", phaseLabel: "Phase 02 · Policy sandbox and simulation",
    icon: ICONS.flaskConical,
    headline: "Pre-flight impact replay",
    copy: "Test a new spend cap or regional rule against 90 days of real agent traffic first.",
  },
  {
    phase: "FUTURE", phaseLabel: "Phase 03 · Multi-agent swarm governance",
    icon: ICONS.gitBranch,
    headline: "Cross-agent delegation boundaries",
    copy: "A procurement agent spawning sub-agents inherits the same budget and privacy ceiling.",
  },
];

const RISKS = [
  { icon: ICONS.flame, color: "#c17a4a", stat: "200ms", k: "Unbudgeted capital burn", v: "Autonomous API renewals blow quarterly caps before finance notices." },
  { icon: ICONS.shieldAlert, color: "#2e63e0", stat: "€20M+", k: "Cross-border GDPR exposure", v: "Routing EU telemetry to US servers triggers immediate regulatory fines." },
  { icon: ICONS.bellRing, color: "#b8604f", stat: "50+/day", k: "Executive alert fatigue", v: "Context-free Slack pings train leaders to blindly rubber-stamp risk." },
];

const COMPETITORS = [
  {
    n: "01",
    category: "LLM observability",
    logos: [
      { name: "LangSmith", icon: ICONS.flaskConical },
      { name: "Weights & Biases", icon: ICONS.scale },
    ],
    does: "Debug token latency, prompt chains and model drift for engineers.",
    blindSpot: "Unreadable to a VP of Finance or InfoSec lead checking contract caps or GDPR residency.",
  },
  {
    n: "02",
    category: "Procurement & compliance",
    logos: [
      { name: "Coupa", icon: ICONS.cart },
      { name: "Vanta", icon: ICONS.shieldCheck },
    ],
    does: "Manage manual purchase tickets and periodic compliance checklists.",
    blindSpot: "Built for multi-day workflows. Too slow to intercept a 200ms agent transaction.",
  },
  {
    n: "03",
    category: "ChatOps notifications",
    logos: [
      { name: "Slack", icon: ICONS.messageSquare },
      { name: "Microsoft Teams", icon: ICONS.users },
    ],
    does: "Route binary approve or reject webhook alerts into a team channel.",
    blindSpot: "Strips away budget and legal context, training leaders to rubber-stamp risk.",
  },
  {
    n: "04",
    category: "Identity & access gateways",
    logos: [
      { name: "Okta", icon: ICONS.key },
      { name: "AWS IAM", icon: ICONS.lock },
    ],
    does: "Enforce static allow or deny rules for system access.",
    blindSpot: "Hard blocks stall launches. Cannot steer an agent to reroute data or cap spend.",
  },
];

interface PrincipleTag {
  kind: "pill" | "split" | "toggle" | "mono";
  text?: string;
  parts?: string[];
}
const PRINCIPLES: { n: string; icon: string; title: string; rule: string; tag: PrincipleTag }[] = [
  {
    n: "01",
    icon: ICONS.checkCircle,
    title: "Silence for safe work",
    rule: "Safe renewals run unseen; humans only see broken thresholds.",
    tag: { kind: "pill", text: "REQ-843 · Auto-Executed" },
  },
  {
    n: "02",
    icon: ICONS.layers,
    title: "Context over rubber-stamps",
    rule: "Never approve blind. Pair every dollar with its legal proof.",
    tag: { kind: "split", parts: ["+$12k Cap", "GDPR §4.2"] },
  },
  {
    n: "03",
    icon: ICONS.sliders,
    title: "Fixes over hard stops",
    rule: "Every policy trigger computes a safe fix on the spot.",
    tag: { kind: "toggle", text: "Enforce EU-Only Scope" },
  },
  {
    n: "04",
    icon: ICONS.fileCheck,
    title: "Proof by default",
    rule: "Every override or cap edit writes a tamper-proof receipt.",
    tag: { kind: "mono", text: "LOG #9921 · Immutable" },
  },
];

const PINS: Pin[] = [
  {
    x: 27, y: 17,
    tag: "Triage queue",
    title: "Exception-first triage queue",
    body: "The top filter bar separates work into Needs Attention, Escalated and Auto-Executed, instead of one noisy event stream.",
    tradeoff: "A VP of Finance clears high-risk blocks in two minutes, trusting that safe renewals keep running in the background unseen.",
  },
  {
    x: 24, y: 24,
    tag: "REQ-842",
    title: "Multi-factor risk card",
    body: "Finance and InfoSec signals live on one object. REQ-842 shows $12k over Q4 budget and a GDPR §4.2 conflict, together.",
    tradeoff: "Most companies split these across two tools. Combining them means one card, not two separate approvals to chase.",
  },
  {
    x: 76, y: 48,
    tag: "[DPA §4.2]",
    title: "Inline evidence drawer",
    body: "Clicking [DPA §4.2] slides open a right-hand drawer with the exact vendor telemetry clause, no modal, no lost context.",
    tradeoff: "I rejected a blocking modal here. It hid the budget numbers the approver needed to see at the same time.",
  },
  {
    x: 24, y: 53,
    tag: "Steer panel",
    title: "Live steering toggles",
    body: "Toggling \"Enforce EU-Only Data Scope\" or \"6-Month Pilot Cap\" recalculates the pre-flight diff in real time.",
    tradeoff: "Dead-end rejections stall launches. A pre-calculated fix lets the approver clear the block without a follow-up meeting.",
  },
];

---

<Base
  title="Runtime Governance for Enterprise AI Agents | Kishore Sudhamalla"
  description="How I designed a human-in-the-loop Agent Control Plane that stops budget overruns and regional compliance breaches before they happen."
>
  <!-- Progress rail: which of the 8 sections is in view, click to jump -->
  <nav class="aw-rail" aria-label="Case study sections">
    {[
      { id: "s-risk", label: "01 Enterprise risk" },
      { id: "s-landscape", label: "02 Competitive landscape" },
      { id: "s-systems", label: "03 Systems thinking" },
      { id: "s-craft", label: "04 Interaction craft" },
      { id: "s-evolution", label: "05 Visual evolution" },
      { id: "s-product", label: "06 Working product" },
      { id: "s-patterns", label: "07 Scalable patterns" },
      { id: "s-vision", label: "08 Future vision" },
    ].map((s) => (
      <a href={`#${s.id}`} class="aw-rail-dot" data-rail-target={s.id} aria-label={s.label}>
        <span class="aw-rail-tip">{s.label}</span>
      </a>
    ))}
  </nav>

  <!-- 1. Hero + early interactive proof -->
  <section class="container-pg aw-hero" data-reveal>
    <p class="aw-eyebrow"><span class="aw-rule"></span>Flagship case study &middot; AI governance &amp; enterprise SaaS</p>
    <h1 class="aw-title">Runtime Governance for Enterprise AI Agents</h1>
    <p class="aw-lede">
      Autonomous agents can sign contracts and move customer data in milliseconds. I designed the human-in-the-loop control plane that catches budget overruns and GDPR violations before execution.
    </p>

    <div class="aw-meta-strip">
      <span class="aw-chip"><b>Role</b> Principal Product Designer</span>
      <span class="aw-chip"><b>Scope</b> Strategy, systems architecture, live code prototype</span>
      <span class="aw-chip"><b>Buyers</b> VP Finance &amp; InfoSec</span>
    </div>

    <figure class="aw-hero-shot">
      <div class="aw-hero-frame">
        <img src={`${IMG}/hero.png`} alt="Agent Control Plane showing REQ-842 (VectorScale AI Enterprise) paused at Human Gate, Budget + GDPR §4.2" />
        <span class="aw-hero-live" style="left:42%; top:15%" aria-hidden="true">
          <span class="aw-hero-live-dot" />
        </span>
      </div>
      <figcaption class="aw-hero-caption">REQ-842 paused at the Human Gate: $42,000 over budget, GDPR §4.2 conflict.</figcaption>
    </figure>
  </section>

  <article class="container-pg r-case">
    <!-- 01. The enterprise risk -->
    <section id="s-risk" class="r-case-section" data-reveal>
      <SectionLabel icon="impact">01 &middot; The enterprise risk</SectionLabel>
      <h2>When software acts on its own, a 200ms mistake costs millions.</h2>
      <p class="aw-tight">
        Traditional SaaS waited for humans to click buttons. Autonomous agents execute at machine speed.
      </p>

      <div class="aw-stat-strip">
        {RISKS.map((r) => (
          <div class="aw-stat">
            <svg class="aw-stat-icon" style={`color:${r.color}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={r.icon} />
            <p class="aw-stat-num">{r.stat}</p>
            <p class="aw-stat-k">{r.k}</p>
            <p class="aw-stat-v">{r.v}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 02. Competitive landscape -->
    <section id="s-landscape" class="r-case-section" data-reveal>
      <SectionLabel icon="context">02 &middot; Competitive landscape</SectionLabel>
      <h2>Existing tools were built for developers or slow human tickets, not autonomous agents.</h2>
      <p class="aw-tight">
        Before designing the control plane, I audited four tool categories enterprises stitch together today. Every one breaks down once software acts autonomously.
      </p>

      <div class="aw-compete">
        {COMPETITORS.map((c) => (
          <div class="aw-compete-card">
            <p class="aw-compete-n">{c.n}</p>
            <div class="aw-compete-logos">
              {c.logos.map((l) => (
                <span class="aw-compete-logo">
                  <svg class="aw-compete-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon} />
                  {l.name}
                </span>
              ))}
            </div>
            <p class="aw-compete-cat">{c.category}</p>
            <p class="aw-compete-does">{c.does}</p>
            <div class="aw-compete-blind">
              <p class="aw-compete-blind-k">The blind spot</p>
              <p class="aw-compete-blind-v">{c.blindSpot}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="aw-core">
        <p class="aw-core-badge">The core problem</p>
        <h3 class="aw-core-title">Enterprises lack a runtime layer that turns legal and financial rules into live, steerable guardrails.</h3>
        <p class="aw-core-body">
          Today, companies choose between shutting agents off completely or letting them spend and move data unchecked. The Agent Control Plane closes that gap: pausing high-risk actions in real time and giving leaders one-click fixes before execution.
        </p>
      </div>
    </section>

    <!-- 03. Systems thinking -->
    <section id="s-systems" class="r-case-section" data-reveal>
      <SectionLabel icon="systems">03 &middot; Systems thinking</SectionLabel>
      <h2>Four rules, and the pipeline that enforces them.</h2>

      <div class="aw-principles">
        {PRINCIPLES.map((p) => (
          <div class="aw-pcard">
            <div class="aw-pcard-top">
              <svg class="aw-pcard-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
              <span class="aw-pcard-n">{p.n}</span>
            </div>
            <h3 class="aw-pcard-title">{p.title}</h3>

            {p.tag.kind === "pill" && <span class="aw-mtag aw-mtag--good">{p.tag.text}</span>}
            {p.tag.kind === "split" && (
              <span class="aw-mtag-split">
                <span class="aw-mtag">{p.tag.parts![0]}</span>
                <span class="aw-mtag">{p.tag.parts![1]}</span>
              </span>
            )}
            {p.tag.kind === "toggle" && (
              <span class="aw-mtag-toggle">
                <span class="aw-mtag-toggle-switch"><span class="aw-mtag-toggle-dot" /></span>
                {p.tag.text}
              </span>
            )}
            {p.tag.kind === "mono" && <span class="aw-mtag aw-mtag--mono">{p.tag.text}</span>}

            <p class="aw-pcard-rule">{p.rule}</p>
          </div>
        ))}
      </div>

      <p class="aw-tight aw-arch-intro">
        A central Policies engine parses regional law and department budgets into live pre-flight checks.
      </p>

      <div class="aw-arch" role="img" aria-label="Architecture diagram: Finance rules and country policies feed into a Control Plane Interceptor, which branches into Auto-Execute or Pause and Steer">
        <div class="aw-arch-col">
          <div class="aw-arch-node aw-arch-node--input">
            <p class="aw-arch-node-k">Input</p>
            <p class="aw-arch-node-v">Finance rules<br/><span class="aw-arch-mono">Q4 dept caps</span></p>
          </div>
          <div class="aw-arch-node aw-arch-node--input">
            <p class="aw-arch-node-k">Input</p>
            <p class="aw-arch-node-v">Country policies<br/><span class="aw-arch-mono">GDPR §4.2</span></p>
          </div>
        </div>

        <svg class="aw-arch-wires aw-arch-wires--in" viewBox="0 0 60 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 20 Q 30 20 30 50 Q 30 80 60 80" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <path d="M0 80 Q 30 80 30 50 Q 30 20 60 20" fill="none" stroke="currentColor" stroke-width="1.5"/>
        </svg>

        <div class="aw-arch-node aw-arch-node--core">
          <p class="aw-arch-node-k">Core</p>
          <p class="aw-arch-node-v">Control Plane<br/>Interceptor</p>
        </div>

        <svg class="aw-arch-wires aw-arch-wires--out" viewBox="0 0 60 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 20 Q 30 20 30 50 Q 30 80 60 80" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <path d="M0 80 Q 30 80 30 50 Q 30 20 60 20" fill="none" stroke="currentColor" stroke-width="1.5"/>
        </svg>

        <div class="aw-arch-col">
          <div class="aw-arch-node aw-arch-node--good">
            <p class="aw-arch-node-k">Output</p>
            <p class="aw-arch-node-v">Auto-execute<br/><span class="aw-arch-mono">REQ-843</span></p>
          </div>
          <div class="aw-arch-node aw-arch-node--warn">
            <p class="aw-arch-node-k">Output</p>
            <p class="aw-arch-node-v">Pause &amp; steer<br/><span class="aw-arch-mono">REQ-842</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 04. Interactive UI teardown -->
    <section id="s-craft" class="r-case-section" data-reveal>
      <SectionLabel icon="craft">04 &middot; Interaction craft</SectionLabel>
      <h2>Anatomy of the decision workspace.</h2>
      <p class="aw-tight">Click a pin to open the decision behind it.</p>

      <HotspotInspector
        client:visible
        imageSrc={`${IMG}/anatomy-annotated.png`}
        imageAlt="Agent Control Plane workspace with the evidence drawer open, four numbered hotspots over the triage queue, risk card, evidence drawer and steering panel"
        pins={PINS}
      />
    </section>

    <!-- 05. Visual evolution: before/after slider -->
    <section id="s-evolution" class="r-case-section" data-reveal>
      <SectionLabel icon="judgment">05 &middot; Visual evolution</SectionLabel>
      <h2>Steering raw AI output into executive-grade craft.</h2>
      <p class="aw-tight">Drag the slider to inspect how I restructured hierarchy, removed blocking modals, and added live remediation.</p>

      <BeforeAfterShowcase
        client:visible
        beforeSrc="/images/acp-draft-1.png"
        afterSrc="/images/acp-final.webp"
        pins={[
          { x: 35, y: 9, label: "Exception-first queue: separated safe auto-runs from human gates." },
          { x: 89, y: 52, label: "Inline evidence drawer: replaced blocking modal with zero-switch DPA proof." },
          { x: 49, y: 54, label: "Live steering toggles: turned dead-end blocks into 1-click fixes." },
        ]}
      />

      <div class="bas-delta">
        <div class="bas-delta-col">
          <p class="bas-delta-k">Hierarchy</p>
          <p class="bas-delta-v"><span class="bas-delta-from">14 equal-weight rows</span><span class="bas-delta-arrow">&rarr;</span><span class="bas-delta-to">3 priority triage tiers</span></p>
        </div>
        <div class="bas-delta-col">
          <p class="bas-delta-k">Compliance flow</p>
          <p class="bas-delta-v"><span class="bas-delta-from">Blocking modal</span><span class="bas-delta-arrow">&rarr;</span><span class="bas-delta-to">Inline evidence drawer</span></p>
        </div>
        <div class="bas-delta-col">
          <p class="bas-delta-k">Resolution</p>
          <p class="bas-delta-v"><span class="bas-delta-from">Binary reject button</span><span class="bas-delta-arrow">&rarr;</span><span class="bas-delta-to">Live remediation toggles</span></p>
        </div>
      </div>
    </section>

    <!-- 06. Working product: live prototype -->
    <section id="s-product" class="r-case-section" data-reveal>
      <SectionLabel icon="film">06 &middot; Working product</SectionLabel>
      <h2>Test the live Agent Control Plane.</h2>

      <div class="aw-steps">
        <span class="aw-step"><span class="aw-step-n">1</span>Click <code>REQ-842</code> in the queue</span>
        <span class="aw-step-arrow" aria-hidden="true">&rarr;</span>
        <span class="aw-step"><span class="aw-step-n">2</span>Click <code>[DPA §4.2]</code> to inspect vendor telemetry</span>
        <span class="aw-step-arrow" aria-hidden="true">&rarr;</span>
        <span class="aw-step"><span class="aw-step-n">3</span>Toggle remediation fixes to clear the block</span>
      </div>

      <div class="aw-embed">
        <div class="aw-embed-bar">
          <span class="aw-embed-label">Agent Control Plane: Enterprise Spend &amp; Compliance Governance</span>
          <a href={PROTOTYPE_URL} target="_blank" rel="noopener noreferrer" class="aw-embed-open">
            Open fullscreen
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
        </div>
        <div class="aw-embed-frame">
          <iframe src={PROTOTYPE_URL} title="Agent Control Plane live prototype" loading="lazy"></iframe>
        </div>
      </div>
    </section>

    <!-- 07. Reusable patterns + builder note -->
    <section id="s-patterns" class="r-case-section" data-reveal>
