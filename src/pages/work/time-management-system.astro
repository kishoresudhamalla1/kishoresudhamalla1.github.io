---
import Base from '../../layouts/Base.astro';
import ScreenGallery from "../../components/ScreenGallery.astro";
import CaseHero from "../../components/CaseHero.astro";
---

<Base title="Time Management System. Kishore Sudhamalla" description="Rebuilding Darwinbox's most-complained-about module into a unified, insight-driven time management experience used by 1.16M employees.">

<style>
  /* ── Page-level overrides ───────────────────────────────── */
  .cs-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .cs-h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }
  /* Horizontal scroll gallery */
  .scroll-gallery {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .scroll-gallery::-webkit-scrollbar { display: none; }
  .scroll-gallery > * {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }
  /* Screenshot frame — dark stage */
  .screen-stage {
    background: #111110;
    border-radius: 1.25rem;
    padding: 2.5rem 2.5rem 1.5rem;
    position: relative;
  }
  .screen-stage::before {
    content: '';
    position: absolute;
    top: 1rem;
    left: 1.5rem;
    width: 10px; height: 10px;
    border-radius: 50%;
    background: #333;
    box-shadow: 18px 0 0 #333, 36px 0 0 #333;
  }
  .screen-stage img {
    border-radius: 0.75rem;
    width: 100%;
    box-shadow: 0 32px 80px rgba(0,0,0,0.5);
  }
  /* Stat number */
  .stat-num {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  /* Pull quote */
  .pull-quote {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.02em;
    font-style: italic;
    color: var(--color-ink);
    border-left: 3px solid var(--color-ink);
    padding-left: 1.5rem;
  }
  /* Slide frame — neutral surface with subtle border */
  .slide-frame {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }
  .slide-frame img { width: 100%; display: block; }
  /* Before/after label strip */
  .ba-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  /* ── Never let a deck-extracted image render above its native width.
     The sources top out around 1000–1400px, so scaling them to a 1152px
     container is what made them look soft. ── */
  .slide-frame img,
  .screen-stage img,
  .cs-figure img {
    max-width: 100%;
    height: auto;
  }

  .cs-figure {
    margin: 0 auto;
    /* Source is 2044px, so it can fill the container and stay retina-sharp. */
    max-width: 100%;
    border: 1px solid #262622;
    border-radius: 1rem;
    overflow: hidden;
  }
  .cs-figure img { width: 100%; display: block; }
  .cs-figure figcaption {
    padding: 0.75rem 1.25rem;
    font-size: 0.75rem;
    color: #6b6b64;
    border-top: 1px solid #262622;
  }

  /* ── Adoption table ── */
  .cs-table-wrap {
    overflow-x: auto;
    border: 1px solid #262622;
    border-radius: 1rem;
  }
  .cs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    min-width: 640px;
  }
  .cs-table th,
  .cs-table td {
    padding: 1rem 1.25rem;
    text-align: left;
    border-bottom: 1px solid #1e1e1a;
  }
  .cs-table thead th {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b64;
  }
  .cs-table tbody th {
    font-weight: 500;
    color: #f5f5f0;
  }
  .cs-table td { color: #b9b9b1; font-variant-numeric: tabular-nums; }
  .cs-table .num { text-align: right; }
  .cs-table tbody tr:last-child th,
  .cs-table tbody tr:last-child td { border-bottom: none; }

  /* ── Client quotes ── */
  .cs-quotes {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) { .cs-quotes { grid-template-columns: repeat(3, 1fr); } }
  .cs-quote {
    margin: 0;
    padding: 1.5rem;
    border: 1px solid #262622;
    border-radius: 1rem;
    background: #111110;
  }
  .cs-quote p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #d6d6ce;
    margin-bottom: 1.25rem;
  }
  .cs-quote footer { display: flex; flex-direction: column; gap: 0.15rem; }
  .cs-quote-name { font-size: 0.8125rem; font-weight: 600; color: #f5f5f0; }
  .cs-quote-role {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b6b64;
  }

  /* ── Post-release review ── */
  .cs-review {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) { .cs-review { grid-template-columns: 1fr 1fr; } }
  .cs-review-col {
    padding: 1.75rem;
    border: 1px solid #262622;
    border-radius: 1rem;
    background: #111110;
  }
  .cs-review-head {
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .cs-review-head--good { color: #6ec18f; }
  .cs-review-head--ask  { color: #d99a5b; }
  .cs-review-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .cs-review-list li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #b9b9b1;
  }
  .cs-review-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #4a4a44;
  }
  .cs-review-quote {
    font-size: 0.875rem;
    font-style: italic;
    line-height: 1.6;
    color: #d6d6ce;
    padding-left: 0.9rem;
    border-left: 2px solid #2e2e28;
    margin-bottom: 0.9rem;
  }
  .cs-review-quote span {
    display: block;
    font-style: normal;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b6b64;
    margin-top: 0.35rem;
  }
  .cs-review-note {
    font-size: 0.75rem;
    line-height: 1.6;
    color: #6b6b64;
    padding-top: 0.9rem;
    border-top: 1px solid #1e1e1a;
  }

  /* ── Light-section text blocks (converted from deck slides) ── */
  .cs-split { display: grid; gap: 1rem; }
  @media (min-width: 768px) { .cs-split { grid-template-columns: 1fr 1fr; } }

  .cs-card {
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.75rem;
    background: var(--color-bg);
  }
  .cs-card-kicker {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: 0.75rem;
  }
  .cs-card-title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin-bottom: 0.6rem;
  }
  .cs-card-body {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-ink-2);
  }

  .cs-jobs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .cs-jobs li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-2);
  }
  .cs-jobs li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.62em;
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--color-ink-3);
  }

  /* Participants — client logos with sector captions */
  .cs-clients {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: end;
  }
  .cs-client { text-align: center; }
  .cs-client-logo {
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.9rem;
  }
  /* Fill the row box and let object-fit preserve each aspect ratio, so a
     small intrinsic SVG (bigbasket is 91×34) scales up to match the others
     instead of rendering at its natural size. */
  .cs-client-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* logos are dark-on-white marks — lift them so they read on a dark page */
  :global(.dark) .cs-client-logo img {
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }
  .cs-client-sector {
    font-size: 0.8125rem;
    color: var(--color-ink-2);
  }
  @media (max-width: 640px) {
    .cs-clients { grid-template-columns: 1fr; gap: 2rem; }
    .cs-client-logo { height: 44px; }
  }

  /* Internal connects — profile cards */
  .cs-connects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 700px)  { .cs-connects { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1000px) { .cs-connects { grid-template-columns: repeat(5, 1fr); } }
  .cs-connect {
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    background: var(--color-bg);
    padding: 1.15rem 1.2rem;
  }
  .cs-connect-name {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 0.15rem;
  }
  .cs-connect-role {
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--color-ink-3);
    /* Reserve two lines so roles that wrap and roles that don't still put
       the rule — and the bullets below it — on the same baseline in every
       card across the row. */
    min-height: 2.9em;
    padding-bottom: 0.85rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
  }
  .cs-connect-pts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .cs-connect-pts li {
    position: relative;
    padding-left: 0.85rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .cs-connect-pts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-ink-3);
  }

  /* Key findings — three columns, tinted like the original slide */
  .cs-findings { display: grid; gap: 1rem; }
  @media (min-width: 900px) { .cs-findings { grid-template-columns: repeat(3, 1fr); } }
  .cs-find { border-radius: 1rem; padding: 1.5rem 1.75rem; }
  .cs-find--pain { background: #fdf0ee; }
  .cs-find--disc { background: #fdf8e9; }
  .cs-find--sugg { background: #edf6f2; }
  :global(.dark) .cs-find--pain { background: rgba(226,120,100,0.10); }
  :global(.dark) .cs-find--disc { background: rgba(220,180,80,0.10); }
  :global(.dark) .cs-find--sugg { background: rgba(90,170,124,0.10); }
  .cs-find-head {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 1rem;
  }
  .cs-find-list {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .cs-find-list li {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  /* Voice of the user */
  .cs-voice { display: grid; gap: 0.75rem; }
  @media (min-width: 768px) { .cs-voice { grid-template-columns: 1fr 1fr; } }
  .cs-voice p {
    background: var(--color-surface);
    border-radius: 0.875rem;
    padding: 1.1rem 1.35rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  /* Card-sort chips */
  .cs-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .cs-chip {
    display: inline-block;
    background: #fbf3c4;
    color: #4a4326;
    border-radius: 0.375rem;
    padding: 0.45rem 0.8rem;
    font-size: 0.8125rem;
    line-height: 1.2;
  }
  :global(.dark) .cs-chip { background: rgba(240,214,90,0.14); color: #e4d79a; }
  .cs-chip--sm { font-size: 0.75rem; padding: 0.35rem 0.65rem; }

  .cs-groups { display: flex; flex-direction: column; gap: 1.25rem; }
  .cs-group {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }
  .cs-group-name {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: 0.7rem;
  }

  /* ── Shipped product: the emphasis moment of the case study ──
     Wider than the surrounding text column, generous air above and below,
     and a quiet frame so the product does the talking. */
  .cs-final {
    margin-top: 5rem;
    padding-top: 4rem;
    border-top: 1px solid var(--color-border);
  }
  .cs-final-lead { max-width: 34rem; margin-bottom: 2.5rem; }
  .cs-final-desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink-2);
  }
  .cs-final-stage {
    margin: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: 0 30px 70px -40px rgba(0, 0, 0, 0.35);
  }
  :global(.dark) .cs-final-stage { box-shadow: 0 30px 70px -35px rgba(0, 0, 0, 0.8); }
  .cs-final-video { display: block; width: 100%; height: auto; }
  .cs-final-meta {
    margin-top: 1.1rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-3);
  }
  /* Let it breathe wider than the reading column on large screens */
  @media (min-width: 1100px) {
    .cs-final-stage { margin-inline: -3rem; }
  }

  /* Competitive analysis — hairline rows, no cards or shadows */
  .cs-compete { border-top: 1px solid var(--color-border); }
  .cs-compete-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem 2.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 700px) {
    .cs-compete-row { grid-template-columns: 13rem 1fr; align-items: start; }
  }
  .cs-compete-name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .cs-compete-note {
    font-size: 0.75rem;
    color: var(--color-ink-3);
    margin-top: 0.1rem;
  }
  .cs-compete-pts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
  }
  .cs-compete-pts li {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-ink-2);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    padding: 0.3rem 0.75rem;
  }
  .cs-compete-take {
    margin-top: 2.5rem;
    max-width: 42rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-2);
    padding-left: 1.1rem;
    border-left: 2px solid var(--color-ink);
  }

  /* Before — two real screens, stacked and given room to be legible */
  .cs-before { display: flex; flex-direction: column; gap: 1.25rem; }
  .cs-before-shot {
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    overflow: hidden;
    background: var(--color-surface);
  }
  .cs-before-shot img { width: 100%; height: auto; display: block; }
  .cs-before-cap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;
    font-size: 0.75rem;
    color: var(--color-ink-2);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .cs-before-tag {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b4462f;
    background: #fdf1ee;
    border-radius: 100px;
    padding: 0.2rem 0.6rem;
  }
  :global(.dark) .cs-before-tag { color: #e79a86; background: rgba(226,120,100,0.14); }

  /* Roadshow photography — real grid, sized so each frame stays retina-sharp */
  .cs-photos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 800px) {
    .cs-photos { grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  }
  .cs-photo {
    margin: 0;
    overflow: hidden;
    border-radius: 0.875rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    aspect-ratio: 4 / 3;
  }
  .cs-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s cubic-bezier(.22,1,.36,1);
  }
  .cs-photo:hover img { transform: scale(1.03); }
  /* one frame leads the grid */
  @media (min-width: 800px) {
    .cs-photo--wide { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-photo img { transition: none; }
    .cs-photo:hover img { transform: none; }
  }

  /* Roadshow client roster */
  .cs-roster {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    overflow: hidden;
  }
  @media (min-width: 700px)  { .cs-roster { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1000px) { .cs-roster { grid-template-columns: repeat(4, 1fr); } }

  .cs-roster-item {
    background: var(--color-bg);
    padding: 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .cs-roster-name {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .cs-roster-industry {
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .cs-roster-country {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.35rem;
    font-size: 0.6875rem;
  }
  .cs-roster-country-label {
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
</style>

  <!-- Back link -->
  <div class="container-pg pt-8 flex items-center justify-between flex-wrap gap-4">
    <a href="/" class="cs-label hover:text-[var(--color-ink)] transition-colors inline-flex items-center gap-2">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M8.5 2L3.5 7L8.5 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Back to work
    </a>
    <a href="/work/time-management-system-v2" class="cs-label border border-[var(--color-border)] rounded-full px-4 py-1.5 hover:border-[var(--color-ink-3)] transition-colors">
      View award-style version →
    </a>
  </div>

  <!-- ══════════════════════════════════════════════════════
       HERO, full-bleed image with overlay headline
  ══════════════════════════════════════════════════════ -->
  <CaseHero
    eyebrow="Systems design · Platform UX · Enterprise"
    title="Time Management,<br />rebuilt for the world."
    lede="Darwinbox's most-complained-about module, fragmented, eight years old, and used daily by over a million people. Rebuilt around what a manager needs to see first, then rolled out globally."
    meta={[
      { k: "Role", v: "Associate Director, UX" },
      { k: "Timeline", v: "2023 – 2024" },
      { k: "Team", v: "3 designers · product · engineering" },
      { k: "Platform", v: "Darwinbox HCM" },
    ]}
    video="/images/work/time-management/tm-manager-dashboard"
    poster="/images/work/time-management/tm-manager-dashboard-poster.jpg"
    alt="Time Management, the manager dashboard in use"
    cards={[
      {
        eyebrow: "Manager play rate",
        value: "73.1%",
        label: "Highest on the platform",
        note: "The view managers actually opened, rather than the one they were given.",
      },
      {
        eyebrow: "Gartner WFM",
        value: "3.5",
        label: "Up from 2.9 by 2025",
        note: "Darwinbox's Workforce Management score after the rebuild shipped.",
      },
    ]}
  />

  <!-- ══════════════════════════════════════════════════════
       IMPACT NUMBERS
  ══════════════════════════════════════════════════════ -->
  <section class="sec-y" data-reveal>
