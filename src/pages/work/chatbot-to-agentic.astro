---
/**
 * Chatbot → Agentic AI → AI-native experiences. Case study 03.
 *
 * Genuinely not started yet. Draft template only: the headings below are
 * the agreed structure, each with a TODO for Kishore to fill with real
 * content. Not linked from the homepage or nav, and noindexed, until it's
 * written. Keep this honest framing, don't dress it up as finished work.
 */
import Base from "../../layouts/Base.astro";

const SECTIONS = [
  { h: "Stakes", todo: "TODO: what was actually on the line here (business, user, or personal) if this went wrong or didn't happen." },
  { h: "What changed from chatbot to agent", todo: "TODO: the concrete before/after. What could the chatbot not do that the agent can, and why that's a real product shift and not just a label change." },
  { h: "Five-question framework applied", todo: "TODO: walk through \"what does it know / what can it decide / what should it do / when should a person be involved / how do we know it worked\" for this specific product, with specifics, not the generic framing already on the homepage." },
  { h: "Options rejected and why", todo: "TODO: at least one real alternative you considered and didn't ship, and the reasoning, matching the Decision-block format used on the other two case studies." },
  { h: "Human-oversight moments", todo: "TODO: the exact point(s) where a person reviews, approves, or can override the agent, and what happens if they don't." },
  { h: "Outcome", todo: "TODO: what shipped (if anything) and any real evidence of it working. If there's no metric, write the honest \"what I couldn't measure and how I'd know\" version instead, same as the other two case studies." },
  { h: "What I'd do differently", todo: "TODO: the judgment/reflection section, same role as \"Judgment\" on Time Management." },
];
---

<Base title="Chatbot → Agentic AI → AI-native experiences | Kishore Sudhamalla" noindex={true}>
  <article class="container-pg stub">
    <p class="stub-label">Case study 03 · Draft template, not published</p>
    <h1>Chatbot → Agentic AI → AI-native experiences</h1>
    <p class="stub-tag">Exploring what changes when AI moves from answering questions to getting work done.</p>
    <p class="stub-p">
      A look at the shift from conversational assistants to agents that
      understand intent, use tools, take actions, and become part of the
      product experience itself.
    </p>

    <div class="stub-soon">
      <p class="stub-soon-k">Still being written</p>
      <p class="stub-soon-b">
        This one doesn't have a finished story to tell yet, so I'd rather hold it than publish a placeholder dressed up as a case study. Check back in a few weeks, or email me if you'd like to talk through the thinking sooner.
      </p>
      <a class="stub-soon-link" href="mailto:build@kishoresudhamalla.com">build@kishoresudhamalla.com</a>
    </div>

    <div class="stub-outline">
      {SECTIONS.map((s) => (
        <section class="stub-section">
          <h2>{s.h}</h2>
          <p class="stub-todo">{s.todo}</p>
        </section>
      ))}
    </div>
  </article>
</Base>

<style>
  .stub { padding-block: clamp(3rem, 7vw, 5rem) clamp(4rem, 8vw, 6rem); }
  .stub > * { max-width: var(--measure); }
  .stub-label {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-ink-3); margin: 0 0 1rem;
  }
  .stub h1 {
    font-family: var(--font-display); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1;
    font-size: clamp(1.875rem, 4.5vw, 3rem); color: var(--color-ink); margin: 0 0 1rem;
  }
  .stub-tag { font-weight: 600; font-size: 1.125rem; color: var(--color-ink); margin: 0 0 1rem; }
  .stub-p { font-size: 1.0625rem; line-height: 1.7; color: var(--color-ink-2); margin: 0 0 2.5rem; }

  .stub-soon {
    border: 1px dashed var(--color-border); border-radius: 1rem;
    padding: 1.75rem 2rem; display: flex; flex-direction: column; gap: 0.6rem;
  }
  .stub-soon-k {
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-ink-3); margin: 0;
  }
  .stub-soon-b { font-size: 0.9375rem; line-height: 1.7; color: var(--color-ink-2); margin: 0; }
  .stub-soon-link {
    font-size: 0.9375rem; font-weight: 600; color: var(--color-ink);
    text-decoration: underline; text-underline-offset: 3px; width: fit-content;
  }
  .stub-soon-link:hover { color: var(--color-ink-2); }

  .stub-outline { margin-top: 3rem; border-top: 1px solid var(--color-border); padding-top: 2rem; }
  .stub-section { margin-bottom: 1.75rem; }
  .stub-section h2 {
    font-family: var(--font-display); font-weight: 700; font-size: 1.125rem;
    letter-spacing: -0.015em; color: var(--color-ink); margin: 0 0 0.5rem;
  }
  .stub-todo {
    font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.6;
    color: var(--color-ink-3); margin: 0; padding: 0.75rem 1rem;
    border-left: 2px solid var(--color-border); background: var(--color-surface);
  }
</style>
