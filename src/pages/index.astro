---
/**
 * Homepage. Hero, selected work (with per-card micro-state toggles), how I
 * work, a click-through question switcher for AI-native product thinking,
 * and the AI Lab section with an interactive drift-confidence demo card.
 *
 * Preview and demo copy is grounded in what's actually documented on the
 * Design Ops and Flows/Journeys/Playbooks case studies, not invented stats.
 */
import Base from "../layouts/Base.astro";
import PaperCards from "../components/PaperCards.astro";
import SectionLabel from "../components/SectionLabel.astro";

const WORK = [
  {
    n: "01",
    short: "Time Management",
    word: "TIME", l1: "Enterprise HCM.", l2: "2023 to 2024.", ptitle: "Redesigning Global Time Management.",
    pblurb: "A time management tool used by employees, managers and HR teams across a global company. I redesigned it from the ground up.",
    kicker: "01 — Enterprise HCM · Web app",
    title: "Time Management",
    tags: ["Product design", "Systems thinking", "Enterprise UX"],
    href: "/work/time-management",
    featured: true,
    micro: {
      label: "View as",
      options: [
        { label: "Employee", state: "Sees their own attendance, leave balance and team calendar. Nothing about anyone else." },
        { label: "Manager", state: "Sees the same screen, scoped to their reportees, plus who's overworking and who's about to run out of leave." },
      ],
    },
  },
  {
    n: "02",
    short: "Flows to Playbooks",
    word: "PLAYBOOKS", l1: "Product strategy.", l2: "Journeys shipped.", ptitle: "Orchestrating Moments That Matter.",
    pblurb: "How a single task grew into a guided journey for employees, then into playbooks an AI can help run.",
    kicker: "02 — Product strategy · Web app",
    title: "From Flows → Journeys → AI Playbooks",
    tags: ["Product strategy", "Workflow design", "AI-native experiences"],
    href: "/work/flows-journeys-playbooks",
    featured: false,
    micro: {
      label: "Trigger",
      options: [
        { label: "New hire", state: "Starts the onboarding journey: welcome steps, IT provisioning, manager introductions." },
        { label: "Role change", state: "Notifies the manager, re-checks access and updates the employee's journey list." },
        { label: "Exit", state: "Starts offboarding: asset return, access revoked, final tasks assigned." },
      ],
    },
  },
  {
    n: "03",
    short: "Agentic AI",
    word: "AGENTIC", l1: "Agentic AI Transition Story.", l2: "", ptitle: "Designing Agentic Workflows.",
    pblurb: "What changes when AI stops just answering questions and starts doing the work itself.",
    kicker: "03 — Agentic UX · In progress",
    title: "Chatbot → Agentic AI → AI-native experiences",
    tags: ["Agentic UX", "AI interaction design", "Human-AI collaboration"],
    href: "/work/chatbot-to-agentic",
    featured: false,
    inProgress: true,
  },
];

const QUESTIONS = [
  { q: "What does the system know?", preview: "It reads the ticket's changelog, the comment thread and the current policy. Nothing more." },
  { q: "What can it decide?", preview: "It can flag a risk and suggest a reason. It never changes a date or a status itself." },
  { q: "What should it do?", preview: "Write one sentence explaining the risk, cite exactly what it read, then stop." },
  { q: "When should a person be involved?", preview: "Before anything writes back to Jira. Every time, no exceptions." },
  { q: "How do we know it worked?", preview: "It checks its own advice against what actually happened, and says so when it was wrong." },
];
---

<Base title="Kishore Sudhamalla | Principal Product Designer">
  <!-- Hero -->
  <section class="r-hero-wrap">
  <div class="r-hero-grid" data-cursor-grid aria-hidden="true"></div>
  <div class="container-pg r-hero">
    <p class="r-eyebrow enter" style="--tier:0">Principal Product Designer</p>
    <h1 class="r-h1 enter" style="--tier:0">
      I turn complex ideas, systems and workflows into
      <span class="r-h1-accent">products that feel intuitive and intelligent.</span>
    </h1>

    <p class="r-lede enter" style="--tier:1">
      I bring the same thinking to AI: designing experiences that make it clear what AI knows, what it can do, and when a person should step in.
    </p>

    <p class="r-hero-facts enter" style="--tier:1">
      16+ years in design · 11 years in product design · AI-native product design
    </p>

    <div class="r-cta-row enter" style="--tier:2">
      <a href="#work" class="r-btn r-btn-primary">View my work</a>
      <a href="/ai-lab" class="r-btn r-btn-ghost">Explore AI Lab</a>
    </div>
  </div>
  </section>

  <!-- Selected work -->
  <section id="work" class="container-pg r-work" data-reveal>
    <SectionLabel icon="craft">Selected work</SectionLabel>

    <PaperCards items={WORK} variant="grid" />
  </section>

  <!-- A little about how I work -->
  <section class="container-pg r-prose" data-reveal>
    <SectionLabel icon="context">A little about how I work</SectionLabel>
    <div class="r-prose-rail">
      <p class="r-prose-lead">Complex products rarely have a single UX problem.</p>
      <p>The screen is usually just where the complexity becomes visible.</p>
      <p>I like getting underneath it. Understanding the system, finding where people struggle and figuring out what the product should do differently.</p>
      <p>With AI, that becomes even more interesting.</p>
      <p>The question is no longer just how people navigate a product. It is also what the product should understand, what it should do on their behalf, when it should ask and when it should step back.</p>
      <p class="r-prose-close">That's the kind of work I enjoy.</p>
    </div>
  </section>

  <!-- How I think about AI-native products -->
  <section class="container-pg r-think" data-reveal>
    <SectionLabel icon="systems">How I think about AI-native products</SectionLabel>
    <div class="r-think-grid">
      <div class="r-think-copy">
        <p class="r-think-lead">AI isn't just another feature to add to an existing interface.</p>
        <p>It changes how people interact with products.</p>
        <p>Instead of asking users to find the right screen, understand the right workflow and perform every step themselves, we can start with intent and let the system help with the work.</p>
        <p>But that only works when people understand what the system is doing and remain in control when it matters.</p>
      </div>
      <div class="r-think-side">
        <p class="r-think-intro">I think about AI experiences through a few simple questions. Click one.</p>
        <div class="r-think-switch" data-think-switch>
          <div class="r-think-tabs" role="tablist" aria-label="AI experience questions">
            {QUESTIONS.map((item, i) => (
              <button type="button" class="r-think-tab" role="tab" data-think-tab={i} aria-selected={i === 0 ? "true" : "false"}>
                <span class="r-think-n">{String(i + 1).padStart(2, "0")}</span>
                <span>{item.q}</span>
              </button>
            ))}
          </div>
          <div class="r-think-preview">
            <p class="r-think-preview-k">Example from Design Ops, not a live system</p>
            {QUESTIONS.map((item, i) => (
              <p class="r-think-panel" data-think-panel={i} hidden={i !== 0}>{item.preview}</p>
            ))}
          </div>
        </div>
      </div>
    </div>
    <p class="r-think-close">That's where I spend a lot of my time.</p>
  </section>

  <!-- AI Lab -->
  <section class="container-pg r-lab" data-reveal>
    <SectionLabel icon="impact">AI Lab</SectionLabel>
    <h2 class="r-h2">Designing by building</h2>

    <div class="r-lab-split">
      <div class="r-prose-inline">
        <p>Figma shows what a product could look like. It doesn't show how an AI feature actually behaves once it's wired to real data and a real person has to trust it.</p>
        <p>The AI Lab is where I build that part. Working prototypes I can click, break and watch react, not just a flow diagram of one.</p>
        <p>The card on the right is a small piece of Design Ops, the same decision a reviewer makes every week. Try it.</p>
      </div>

      <div class="r-signal" data-signal>
        <div class="r-signal-top">
          <span class="r-signal-dot" data-signal-dot></span>
          <span class="r-signal-label" data-signal-label>Signal: Low drift</span>
        </div>
        <input type="range" class="r-signal-range" min="0" max="100" value="20" data-signal-range aria-label="Drift confidence" />
        <div class="r-signal-marks"><span>Low</span><span>Medium</span><span>High</span></div>
        <p class="r-signal-state" data-signal-state>No action needed. Nothing is queued for review.</p>
        <div class="r-signal-actions" data-signal-actions hidden>
          <button type="button" class="r-signal-btn r-signal-btn-approve" data-signal-approve>Approve</button>
          <button type="button" class="r-signal-btn r-signal-btn-override" data-signal-override>Override</button>
        </div>
        <button type="button" class="r-signal-reset" data-signal-reset>Reset</button>
      </div>
    </div>

    <a href="/ai-lab" class="r-lab-card">
      <h3>Design Ops</h3>
      <p class="r-lab-q">What if a design operations dashboard could understand the signals, explain what they mean and help designers decide what to do next?</p>
      <p>I built a working system that connects product data, deterministic rules, AI interpretation, recommendations, human approval and verification.</p>
      <div class="work-card-tags">
        <span>AI prototyping</span><span>Product systems</span><span>Claude Code</span><span>Human-in-the-loop design</span>
      </div>
      <span class="r-text-link">Explore AI Lab →</span>
    </a>
  </section>

  <!-- Let's talk -->
  <section id="contact" class="r-talk" data-reveal>
    <div class="container-pg">
      <h2 class="r-talk-head">Let's talk</h2>
      <p class="r-talk-p">If you're building complex products, rethinking enterprise workflows or figuring out what AI-native experiences should actually look like, I'd love to compare notes.</p>
      <a href="mailto:build@kishoresudhamalla.com" class="r-btn r-btn-primary">Get in touch</a>
    </div>
  </section>
</Base>

<script>
  import { initCursorGrid } from "../lib/cursorGrid";

  function mountHeroGrid() {
    const el = document.querySelector<HTMLElement>("[data-cursor-grid]");
    if (!el || el.dataset.ready) return;
    el.dataset.ready = "1";
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const opts = () => ({
      color: getComputedStyle(document.body).getPropertyValue("--color-ink").trim() || "#0d0d0c",
      cellSize: 60, radius: 150, maxOpacity: 0.22, holdTime: 250,
      fadeDuration: 650, lineWidth: 0.75, gridOpacity: 0, fillOpacity: 0, cellRadius: 4,
    });
    let destroy = initCursorGrid(el, opts());
    document.addEventListener("themechange", () => {
      destroy();
      destroy = initCursorGrid(el, opts());
    });
  }
  mountHeroGrid();
  document.addEventListener("astro:page-load", mountHeroGrid);

  // Question switcher: click a question, see its preview. Hover does the
  // same on a device that actually has a pointer, so the switch feels
  // instant without fighting touchscreens.
  function initThinkSwitch() {
    const root = document.querySelector<HTMLElement>("[data-think-switch]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-think-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-think-panel]"));
    const hoverCapable = window.matchMedia("(hover: hover)").matches;

    const show = (i: number) => {
      tabs.forEach((t, k) => t.setAttribute("aria-selected", String(k === i)));
      panels.forEach((p) => { p.hidden = Number(p.dataset.thinkPanel) !== i; });
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => show(i));
      if (hoverCapable) t.addEventListener("pointerenter", () => show(i));
    });
  }
  initThinkSwitch();
  document.addEventListener("astro:page-load", initThinkSwitch);

  function initSignalCard() {
    const root = document.querySelector<HTMLElement>("[data-signal]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";

    const range = root.querySelector<HTMLInputElement>("[data-signal-range]")!;
    const dot = root.querySelector<HTMLElement>("[data-signal-dot]")!;
    const label = root.querySelector<HTMLElement>("[data-signal-label]")!;
    const state = root.querySelector<HTMLElement>("[data-signal-state]")!;
    const actions = root.querySelector<HTMLElement>("[data-signal-actions]")!;
    const approveBtn = root.querySelector<HTMLButtonElement>("[data-signal-approve]")!;
    const overrideBtn = root.querySelector<HTMLButtonElement>("[data-signal-override]")!;
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-signal-reset]")!;

    let decided = "";

    const tierFor = (v: number) => (v > 66 ? "high" : v > 33 ? "medium" : "low");

    const render = () => {
      const v = Number(range.value);
      const tier = tierFor(v);
      dot.dataset.tier = tier;
      if (decided) {
        label.textContent = `Signal: ${tier === "high" ? "High" : tier === "medium" ? "Medium" : "Low"} drift`;
        state.textContent = decided;
        actions.hidden = true;
        return;
      }
      if (tier === "low") {
        label.textContent = "Signal: Low drift";
        state.textContent = "No action needed. Nothing is queued for review.";
        actions.hidden = true;
      } else if (tier === "medium") {
        label.textContent = "Signal: Medium drift";
        state.textContent = "Added to the weekly review. No action needed yet.";
        actions.hidden = true;
      } else {
        label.textContent = "Signal: High drift";
        state.textContent = "This needs a decision before it reaches the plan.";
        actions.hidden = false;
      }
    };

    range.addEventListener("input", () => { decided = ""; render(); });
    approveBtn.addEventListener("click", () => {
      decided = "Approved. Nothing else happens until the next sync.";
      render();
    });
    overrideBtn.addEventListener("click", () => {
      decided = "Overridden. Flag cleared, logged for verification.";
      render();
    });
    resetBtn.addEventListener("click", () => {
      decided = "";
      range.value = "20";
      render();
    });

    render();
  }
  initSignalCard();
  document.addEventListener("astro:page-load", initSignalCard);
</script>

<style>
  .r-hero-wrap { position: relative; overflow: hidden; }
  .r-hero-grid { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .r-hero-wrap > .r-hero { position: relative; z-index: 1; }
  .r-hero { padding-block: clamp(3rem, 8vw, 6rem) clamp(2.5rem, 5vw, 4rem); }
  .r-hero > * { max-width: var(--measure); }
  .r-hero > .r-h1 { max-width: var(--measure-head); }
  .r-eyebrow {
    font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-3);
    margin: 0 0 1.25rem;
  }
  .r-h1 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    line-height: 1.05; letter-spacing: -0.03em; color: var(--color-ink);
    margin: 0 0 1.5rem;
  }
  @property --hue { syntax: "<number>"; inherits: true; initial-value: 1; }
  .r-h1 {
    --hue: 1;
    --g1: #8ea7ff; --g2: #b9c6ff; --g3: #fdf3e3; --g4: #ffc97a; --g5: #ff9e74; --g6: #ff8aa0;
    transition: --hue 800ms var(--ease-enter);
    animation: hue-intro 1.5s cubic-bezier(0.4, 0, 0.2, 1) 0.4s 1;
  }
  :global(html:not(.dark)) .r-h1 { --g1: #2f46d8; --g2: #4a5fe8; --g3: #8a6520; --g4: #c07a12; --g5: #d1512c; --g6: #c43a62; }
  @property --shine { syntax: "<percentage>"; inherits: true; initial-value: 160%; }
  .r-h1-accent {
    --shine: 160%;
    color: transparent; -webkit-background-clip: text; background-clip: text;
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
    background-repeat: no-repeat;
    background-size: 46% 100%, 100% 100%;
    background-position: var(--shine) 0, 0 0;
    background-image:
      linear-gradient(100deg,
        transparent 10%,
        color-mix(in srgb, white 100%, transparent) 50%,
        transparent 90%),
      linear-gradient(90deg,
        color-mix(in srgb, var(--g1) calc(var(--hue) * 100%), var(--color-ink-2)),
        color-mix(in srgb, var(--g2) calc(var(--hue) * 100%), var(--color-ink-2)),
        color-mix(in srgb, var(--g3) calc(var(--hue) * 100%), var(--color-ink-2)),
        color-mix(in srgb, var(--g4) calc(var(--hue) * 100%), var(--color-ink-2)),
        color-mix(in srgb, var(--g5) calc(var(--hue) * 100%), var(--color-ink-2)),
        color-mix(in srgb, var(--g6) calc(var(--hue) * 100%), var(--color-ink-2)));
    transition: filter var(--dur-normal) var(--ease-enter);
    animation:
      hue-intro 1.5s cubic-bezier(0.4, 0, 0.2, 1) 0.4s 1,
      shine-sweep 7.5s cubic-bezier(0.4, 0, 0.2, 1) 2.2s infinite;
  }
  @keyframes hue-intro { from { --hue: 0; } to { --hue: 1; } }
  @keyframes shine-sweep {
    0%, 70% { --shine: 160%; }
    92% { --shine: -90%; }
    100% { --shine: -90%; }
  }
  @media (hover: hover) { .r-h1:hover .r-h1-accent { filter: saturate(1.18) brightness(1.07); } }
  @media (prefers-reduced-motion: reduce) {
    .r-h1 { transition: none; }
    .r-h1-accent { animation: none; }
  }
  .r-lede {
    font-size: clamp(1rem, 1.5vw, 1.125rem); line-height: 1.6;
    color: var(--color-ink-2); max-width: var(--measure); margin: 0 0 2.25rem;
  }
  .r-cta-row { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 0; }
  .r-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.8rem 1.6rem; border-radius: 100px;
    font-size: 0.875rem; font-weight: 500; text-decoration: none;
    transition: opacity var(--dur-micro) var(--ease-enter), border-color var(--dur-micro) var(--ease-enter), background-color var(--dur-micro) var(--ease-enter);
  }
  .r-btn-primary { background: var(--color-ink); color: var(--color-bg); }
  .r-btn-primary:hover { opacity: 0.85; }
  .r-btn-ghost { border: 1px solid var(--color-border); color: var(--color-ink); }
  .r-btn-ghost:hover { border-color: var(--color-ink-3); }

  .r-work { padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 6vw, 5rem); }

  .work-card-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .work-card-tags span {
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-2);
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
    border-radius: 100px; padding: 0.5rem 1rem;
  }

  .r-text-link {
    font-size: 0.875rem; font-weight: 500; color: var(--color-ink);
    text-decoration: none; border-bottom: 1px solid var(--color-border);
  }
  .r-text-link:hover { border-color: var(--color-ink); }

  .r-hero-facts {
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em;
    color: var(--color-ink-3); margin: 0 0 1.75rem;
  }

  .r-prose { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .r-prose > * { max-width: var(--measure); }
  .r-prose-rail {
    max-width: var(--measure); border-left: 2px solid var(--color-border);
    padding-left: clamp(1.1rem, 2.5vw, 1.5rem);
  }
  .r-prose p { font-size: 1.0625rem; line-height: 1.7; color: var(--color-ink-2); margin: 0 0 1.1rem; }
  .r-prose .r-prose-lead {
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em;
    font-size: clamp(1.25rem, 2.4vw, 1.625rem); line-height: 1.3; color: var(--color-ink);
  }
  .r-prose .r-prose-close { color: var(--color-ink); font-weight: 500; margin-top: 1.5rem; }

  .r-h2 {
    font-family: var(--font-display); font-weight: 700; letter-spacing: -0.03em;
    font-size: clamp(1.75rem, 3.6vw, 2.5rem); color: var(--color-ink); margin: 0 0 1.25rem;
  }
  .r-lab { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .r-prose-inline { max-width: var(--measure); }
  .r-prose-inline p { font-size: 1.0625rem; line-height: 1.7; color: var(--color-ink-2); margin: 0 0 1.1rem; }

  .r-lab-split {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start; margin-bottom: 1.75rem;
  }
  .r-lab-split .r-prose-inline { margin: 0; }
  @media (max-width: 860px) {
    .r-lab-split { grid-template-columns: 1fr; }
  }

  .r-signal {
    border: 1px solid var(--color-border); border-radius: 1rem; padding: 1.5rem;
    background: color-mix(in srgb, var(--color-ink) 4%, var(--color-bg));
  }
  :global(.dark) .r-signal {
    background: color-mix(in srgb, #000 35%, var(--color-surface));
    border-color: color-mix(in srgb, #fff 12%, transparent);
  }
  .r-signal-top { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }
  .r-signal-dot {
    width: 0.5rem; height: 0.5rem; border-radius: 999px; flex-shrink: 0;
    background: var(--color-ink-3); transition: background-color var(--dur-micro) var(--ease-enter);
  }
  .r-signal-dot[data-tier="medium"] { background: #c08a1e; }
  .r-signal-dot[data-tier="high"] { background: #c0421e; }
  .r-signal-label {
    font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600;
    letter-spacing: 0.04em; color: var(--color-ink);
  }
  .r-signal-range { width: 100%; accent-color: var(--color-ink); display: block; margin: 0 0 0.4rem; }
  .r-signal-marks {
    display: flex; justify-content: space-between; font-family: var(--font-mono);
    font-size: 0.6875rem; color: var(--color-ink-3); margin-bottom: 1.1rem;
  }
  .r-signal-state {
    font-size: 0.9375rem; line-height: 1.5; color: var(--color-ink-2);
    margin: 0 0 1rem; min-height: 2.6em;
  }
  .r-signal-actions { display: flex; gap: 0.6rem; margin-bottom: 0.9rem; }
  .r-signal-btn {
    flex: 1; padding: 0.55rem 0.8rem; border-radius: 0.6rem; font-size: 0.8125rem;
    font-weight: 600; cursor: pointer; border: 1px solid var(--color-border);
    background: var(--color-surface); color: var(--color-ink);
    transition: transform 120ms ease, border-color 120ms ease;
  }
  .r-signal-btn:hover { border-color: var(--color-ink-3); transform: translateY(-1px); }
  .r-signal-btn-approve { border-color: color-mix(in srgb, #1e8a4c 50%, var(--color-border)); }
  .r-signal-btn-override { border-color: color-mix(in srgb, #c0421e 50%, var(--color-border)); }
  .r-signal-reset {
    font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-ink-3);
    background: none; border: none; cursor: pointer; padding: 0; text-decoration: underline;
    text-decoration-color: var(--color-border); text-underline-offset: 3px;
  }
  .r-signal-reset:hover { color: var(--color-ink-2); }

