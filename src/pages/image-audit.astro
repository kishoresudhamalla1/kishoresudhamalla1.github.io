---
import Base from "../layouts/Base.astro";

/**
 * Temporary review page — shows every image still used in the Time Management
 * case study, with how sharp it actually is at desktop width on a 2× screen.
 * Delete this route once the re-uploads are done.
 *
 * ratio = native width ÷ (display width × 2).  Below 1.0 = browser inventing
 * pixels. 1.0 = exactly retina-sharp.
 */

const DIR = "/images/work/time-management/";

const images = [
  {
    file: "image-1783857427121.webp",
    what: "Case study cover",
    where: "Top of page",
    nat: [1482, 1374], css: 1072, ratio: 0.69,
  },
  {
    file: "before/old-attendance.webp",
    what: "Before, employee attendance (cropped from the slide)",
    where: "Section 01 · The Problem",
    nat: [1228, 527], css: 795, ratio: 0.77,
  },
  {
    file: "before/old-roster.webp",
    what: "Before, manager roster (cropped from the slide)",
    where: "Section 01 · The Problem",
    nat: [1219, 485], css: 795, ratio: 0.77,
  },
  {
    file: "image-1783857507797.png",
    what: "Finalized 2-column layout wireframe",
    where: "Section 04 · Information Architecture",
    nat: [1158, 1382], css: 589, ratio: 0.98,
  },
  {
    file: "gartner-mq-cloud-hcm-2024.webp",
    what: "Gartner Magic Quadrant. Cloud HCM Suites ✅ replaced",
    where: "Section 08 · Impact",
    nat: [2044, 1152], css: 1022, ratio: 1.00,
  },
  {
    file: "roadshow/session-studio-tiered.webp",
    what: "SEA roadshow ✅ replaced with 8 individual frames",
    where: "Section 07 · Validation",
    nat: [954, 716], css: 470, ratio: 1.01,
  },
  {
    file: "slide-after-manager.png",
    what: "After, manager view",
    where: "Section 06 · The Design",
    nat: [3012, 1656], css: 1022, ratio: 1.47,
  },
  {
    file: "slide-after-employee.png",
    what: "After, employee view",
    where: "Section 06 · The Design",
    nat: [3022, 1688], css: 1022, ratio: 1.48,
  },
  {
    file: "image-1783857498993.png",
    what: "Layout explorations",
    where: "Section 04 · Information Architecture",
    nat: [1154, 686], css: 283, ratio: 2.04,
  },
  {
    file: "image-1783857502682.png",
    what: "3-column vs 2-column",
    where: "Section 04 · Information Architecture",
    nat: [1156, 646], css: 283, ratio: 2.04,
  },
];

const verdict = (r: number) =>
  r < 0.8 ? { label: "Replace", cls: "bad" }
  : r < 1.0 ? { label: "Borderline", cls: "warn" }
  : { label: "Fine", cls: "ok" };

const needed = (css: number) => Math.round(css * 2);
const counts = {
  bad: images.filter((i) => i.ratio < 0.8).length,
  warn: images.filter((i) => i.ratio >= 0.8 && i.ratio < 1.0).length,
  ok: images.filter((i) => i.ratio >= 1.0).length,
};
---

<Base title="Image audit. Time Management case study" description="Which images need re-uploading.">
  <div class="ia-wrap">
    <header class="ia-head">
      <p class="text-label" style="color:var(--color-ink-3)">Temporary review page</p>
      <h1 class="text-display-sm">Which images need re-uploading</h1>
      <p class="ia-lede">
        Every image still used in the Time Management case study, worst first.
        <strong>Ratio</strong> is native width ÷ what a retina screen needs at
        the size it's displayed. Below <strong>1.0</strong> means the browser is
        inventing pixels, that's what reads as blurry. Click any image to open
        it full size.
      </p>
      <div class="ia-counts">
        <span class="ia-pill bad">{counts.bad} replace</span>
        <span class="ia-pill warn">{counts.warn} borderline</span>
        <span class="ia-pill ok">{counts.ok} fine</span>
      </div>
    </header>

    <div class="ia-grid">
      {images.map((img, n) => {
        const v = verdict(img.ratio);
        return (
          <article class={`ia-card ia-card--${v.cls}`}>
            <a href={`${DIR}${img.file}`} target="_blank" rel="noopener" class="ia-thumb">
              <img src={`${DIR}${img.file}`} alt={img.what} loading="lazy" />
            </a>

            <div class="ia-body">
              <div class="ia-title-row">
                <span class="ia-num">{String(n + 1).padStart(2, "0")}</span>
                <span class={`ia-badge ${v.cls}`}>{v.label}</span>
              </div>

              <h2 class="ia-what">{img.what}</h2>
              <p class="ia-where">{img.where}</p>

              <dl class="ia-stats">
                <div><dt>Native</dt><dd>{img.nat[0]} × {img.nat[1]}</dd></div>
                <div><dt>Shown at</dt><dd>{img.css}px</dd></div>
                <div><dt>Ratio</dt><dd class={v.cls}>{img.ratio.toFixed(2)}×</dd></div>
                <div><dt>Need</dt><dd>{needed(img.css)}px wide</dd></div>
              </dl>

              <p class="ia-file">{img.file}</p>
            </div>
          </article>
        );
      })}
    </div>

    <p class="ia-foot">
      Send replacements one at a time, just say which number it is. Anything at
      <strong>2× the display width</strong> or more will be pixel-perfect.
    </p>
  </div>
</Base>

<style>
  .ia-wrap { max-width: 68rem; margin-inline: auto; padding: 3rem 1.5rem 6rem; }
  @media (min-width: 640px) { .ia-wrap { padding-inline: 2.5rem; } }

  .ia-head { max-width: 42rem; margin-bottom: 3rem; }
  .ia-head h1 { margin: 0.75rem 0 1rem; }
  .ia-lede { font-size: 1rem; line-height: 1.7; color: var(--color-ink-2); }
  .ia-lede strong { color: var(--color-ink); font-weight: 600; }

  .ia-counts { display: flex; gap: 0.5rem; margin-top: 1.5rem; flex-wrap: wrap; }
  .ia-pill {
    font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.85rem;
    border-radius: 100px; border: 1px solid var(--color-border);
  }
  .ia-pill.bad  { color: #b4462f; border-color: #e7bdb2; background: #fdf1ee; }
  .ia-pill.warn { color: #8a6410; border-color: #e8d6a8; background: #fdf8ea; }
  .ia-pill.ok   { color: #2f6b4a; border-color: #b9d9c7; background: #eef7f2; }
  .dark .ia-pill.bad  { color: #e79a86; background: rgba(226,120,100,.12); border-color: rgba(226,120,100,.3); }
  .dark .ia-pill.warn { color: #dcc07a; background: rgba(220,180,80,.12); border-color: rgba(220,180,80,.3); }
  .dark .ia-pill.ok   { color: #8ecfab; background: rgba(90,170,124,.12); border-color: rgba(90,170,124,.3); }

  .ia-grid { display: grid; gap: 1.25rem; }
  @media (min-width: 700px) { .ia-grid { grid-template-columns: 1fr 1fr; } }

  .ia-card {
    display: flex; flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 1rem; overflow: hidden;
    background: var(--color-bg);
  }
  .ia-card--bad  { border-color: #e7bdb2; }
  .ia-card--warn { border-color: #e8d6a8; }
  .dark .ia-card--bad  { border-color: rgba(226,120,100,.35); }
  .dark .ia-card--warn { border-color: rgba(220,180,80,.35); }

  .ia-thumb {
    display: block; background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    max-height: 300px; overflow: hidden;
  }
  .ia-thumb img { width: 100%; height: auto; display: block; }
  .ia-thumb:hover { opacity: .88; }

  .ia-body { padding: 1.25rem 1.4rem 1.4rem; }
  .ia-title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: .6rem; }
  .ia-num {
    font-size: .6875rem; font-weight: 600; letter-spacing: .1em;
    color: var(--color-ink-3);
  }
  .ia-badge {
    font-size: .6875rem; font-weight: 600; padding: .25rem .7rem; border-radius: 100px;
  }
  .ia-badge.bad  { color: #b4462f; background: #fdf1ee; }
  .ia-badge.warn { color: #8a6410; background: #fdf8ea; }
  .ia-badge.ok   { color: #2f6b4a; background: #eef7f2; }
  .dark .ia-badge.bad  { color: #e79a86; background: rgba(226,120,100,.14); }
  .dark .ia-badge.warn { color: #dcc07a; background: rgba(220,180,80,.14); }
  .dark .ia-badge.ok   { color: #8ecfab; background: rgba(90,170,124,.14); }

  .ia-what {
    font-size: 1rem; font-weight: 600; letter-spacing: -.015em;
    line-height: 1.35; color: var(--color-ink); margin-bottom: .3rem;
  }
  .ia-where { font-size: .8125rem; color: var(--color-ink-3); margin-bottom: 1rem; }

  .ia-stats {
    display: grid; grid-template-columns: 1fr 1fr; gap: .6rem 1rem;
    margin: 0 0 1rem; padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .ia-stats dt {
    font-size: .625rem; font-weight: 600; letter-spacing: .08em;
    text-transform: uppercase; color: var(--color-ink-3); margin-bottom: .15rem;
  }
  .ia-stats dd {
    margin: 0; font-size: .875rem; color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .ia-stats dd.bad  { color: #b4462f; font-weight: 600; }
  .ia-stats dd.warn { color: #8a6410; font-weight: 600; }
  .ia-stats dd.ok   { color: #2f6b4a; }
  .dark .ia-stats dd.bad  { color: #e79a86; }
  .dark .ia-stats dd.warn { color: #dcc07a; }
  .dark .ia-stats dd.ok   { color: #8ecfab; }

  .ia-file {
    font-family: var(--font-mono, monospace);
    font-size: .6875rem; color: var(--color-ink-3);
    word-break: break-all;
  }

  .ia-foot {
    margin-top: 3rem; padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: .9375rem; color: var(--color-ink-2);
  }
  .ia-foot strong { color: var(--color-ink); font-weight: 600; }
</style>
