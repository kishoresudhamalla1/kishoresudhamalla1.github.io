---
/**
 * Redesign option — homepage. Repositions from "AI leader / strategic UX
 * leader" to hands-on Principal/Staff IC: complex enterprise systems first,
 * AI-native product design as the next chapter, not the whole identity.
 *
 * Every stat here is one already used elsewhere in the live site
 * (HeroSection.tsx, About.astro) — nothing new invented. "120+ countries"
 * carries the same caveat it already has there: no case study in the repo
 * cites a source for it, so if you want to keep it, it needs a citation.
 */
import RBase from "../../layouts/RBase.astro";
import Contact from "../../components/Contact.astro";

const FACTS = [
  { value: "16+", label: "Years in design" },
  { value: "9", label: "Years building enterprise HCM" },
  { value: "1.6M+", label: "Users reached" },
  { value: "120+", label: "Countries" },
];

const WORK = [
  {
    n: "01",
    title: "Time Management",
    kicker: "Darwinbox · Associate Director, UX · Enterprise systems",
    blurb: "Reimagining enterprise time management for global scale — an eight-year-old module rebuilt around what managers need to decide first.",
    tags: ["1.6M+ users", "120+ countries"],
    href: "/redesign/work/time-management",
    img: "/images/work/time-management/tm-manager-dashboard-poster.jpg",
    featured: true,
  },
  {
    n: "02",
    title: "Flows → Journeys → Playbooks",
    kicker: "Darwinbox · Senior Manager, UX Design · AI-native",
    blurb: "Rethinking employee experiences for an AI-native HCM platform — a product evolution story, from transactional flows to AI-recommended guidance.",
    tags: ["Product evolution", "AI-native interaction"],
    href: "/redesign/work/flows-journeys-playbooks",
    img: "/images/work/beyond-the-task/hero-illustration-poster.jpg",
    featured: false,
  },
];
---

<RBase title="Kishore Sudhamalla — Principal Product Designer">
  <!-- Hero -->
  <section class="container-pg r-hero">
    <p class="r-eyebrow" data-reveal>Kishore Sudhamalla</p>
    <h1 class="r-h1" data-reveal>
      Principal Product Designer, designing complex enterprise systems into
      <span class="r-h1-accent">intelligent, AI-native experiences.</span>
    </h1>

    <p class="r-lede" data-reveal>
      I design complex products, systems and workflows that make work simpler
      for people. Currently exploring the next generation of AI-native
      product experiences.
    </p>

    <div class="r-cta-row" data-reveal>
      <a href="#work" class="r-btn r-btn-primary">View selected work</a>
      <a href="/redesign/ai-lab" class="r-btn r-btn-ghost">Explore AI Lab</a>
    </div>

    <dl class="r-facts" data-reveal>
      {FACTS.map((f) => (
        <div>
          <dt>{f.value}</dt>
          <dd>{f.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Selected work — side by side, hover expands one, collapses the other -->
  <section id="work" class="container-pg r-work" data-reveal>
    <p class="r-section-label">Selected work</p>

    <div class="work-row">
      {WORK.map((p) => (
        <a href={p.href} class:list={["work-card", p.featured && "is-featured"]}>
          <span class="work-card-n" aria-hidden="true">{p.n}</span>

          <div class="work-card-frame">
            <span class="work-card-chrome" aria-hidden="true"><i></i><i></i><i></i></span>
            <div class="work-card-shot">
              <img src={p.img} alt="" loading="lazy" decoding="async" />
            </div>
          </div>

          <div class="work-card-info">
            <p class="work-card-kicker">{p.kicker}</p>
            <p class="work-card-title">{p.title}</p>
            <p class="work-card-blurb">{p.blurb}</p>
            <div class="work-card-foot">
              <div class="work-card-tags">
                {p.tags.map((t) => <span>{t}</span>)}
              </div>
              <span class="work-card-arrow" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                  <path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </div>

          <p class="work-card-label" aria-hidden="true">{p.n} &middot; {p.title}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- How I work -->
  <section class="container-pg r-how">
    <p class="r-section-label" data-reveal>How I work</p>
    <h2 class="r-how-head" data-reveal>I start with the system, not the screen.</h2>

    <div class="r-how-list">
      {[
        { n: "01", t: "Understand the system", d: "Users, data, workflows, dependencies and constraints." },
        { n: "02", t: "Find the real problem", d: "Separate the visible request from the underlying experience problem." },
        { n: "03", t: "Shape the model", d: "Simplify complexity into clearer mental models and interaction patterns." },
        { n: "04", t: "Prototype the future", d: "Move quickly from ideas to working experiences." },
        { n: "05", t: "Make it real", d: "Work closely with product and engineering to ship." },
        { n: "06", t: "Learn and evolve", d: "Use adoption, behaviour and feedback to improve the system." },
      ].map((s) => (
        <div class="r-how-item" data-reveal>
          <p class="r-how-n">{s.n}</p>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- About teaser -->
  <section class="container-pg r-about-teaser">
    <p class="r-section-label" data-reveal>About</p>
    <p class="r-about-p" data-reveal>
      I like difficult problems. I've spent most of my career designing
      products where complexity is unavoidable. For the last nine years I've
      worked on Darwinbox, a global HCM platform used across 120+ countries,
      across Time Management, Payroll, Benefits, Journeys, Flows, HR
      Documents, Core HR, Extensibility and AI experiences. What interests
      me now is what happens when these systems become intelligent.
    </p>
    <a href="/redesign/about" class="r-text-link" data-reveal>More about me →</a>
  </section>

  <Contact />
</RBase>

<style>
  .r-hero { padding: clamp(3rem, 8vw, 6rem) 0 clamp(2.5rem, 5vw, 4rem); max-width: 54rem; }
  .r-eyebrow {
    font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-3);
    margin: 0 0 1.25rem;
  }
  .r-h1 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    line-height: 1.05; letter-spacing: -0.03em; color: var(--color-ink);
    margin: 0 0 1.5rem;
  }
  .r-h1-accent { color: var(--color-ink-2); }
  .r-lede {
    font-size: clamp(1rem, 1.5vw, 1.125rem); line-height: 1.6;
    color: var(--color-ink-2); max-width: 36rem; margin: 0 0 2.25rem;
  }
  .r-cta-row { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 3rem; }
  .r-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.8rem 1.6rem; border-radius: 100px;
    font-size: 0.875rem; font-weight: 500; text-decoration: none;
    transition: all 0.2s;
  }
  .r-btn-primary { background: var(--color-ink); color: var(--color-bg); }
  .r-btn-primary:hover { opacity: 0.85; }
  .r-btn-ghost {
    border: 1px solid var(--color-border); color: var(--color-ink);
  }
  .r-btn-ghost:hover { border-color: var(--color-ink-3); }

  .r-facts {
    display: flex; flex-wrap: wrap; gap: 2rem 3rem;
    padding-top: 1.75rem; border-top: 1px solid var(--color-border);
  }
  .r-facts dt {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .r-facts dd {
    margin: 0.25rem 0 0; font-size: 0.75rem; color: var(--color-ink-3);
  }

  .r-section-label {
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-3);
    margin: 0 0 1.5rem;
  }

  .r-work { padding: clamp(2rem, 5vw, 3rem) 0 clamp(3rem, 6vw, 5rem); }

  /* ── side-by-side hover-expand, same mechanic as the live ProjectList.astro ──
     Mobile-first plain stack (no hover to drive a collapse); the
     side-by-side expand/collapse turns on only at the breakpoint where a
     pointer with hover is also likely. */
  .work-row { display: flex; flex-direction: column; gap: 1.25rem; }

  .work-card {
    position: relative; display: flex; flex-direction: column;
    border: 1px solid var(--color-border); border-radius: 1.25rem;
    text-decoration: none; color: inherit; background: var(--color-surface);
    padding: 1.1rem;
  }

  .work-card-n {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.06em;
    color: var(--color-ink-3); margin-bottom: 0.9rem; display: block;
  }

  .work-card-frame {
    border: 1px solid var(--color-border); border-radius: 0.85rem; overflow: hidden;
    background: var(--color-bg); margin-bottom: 1.1rem;
  }
  .work-card-chrome {
    display: flex; align-items: center; gap: 0.3rem;
    padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--color-border);
  }
  .work-card-chrome i {
    width: 6px; height: 6px; border-radius: 50%; background: var(--color-border);
  }
  .work-card-shot { aspect-ratio: 16 / 10; background: var(--color-surface); }
  .work-card-shot img {
    width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block;
  }

  .work-card-info { display: flex; flex-direction: column; flex: 1; }

  .work-card-kicker {
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.03em;
    color: var(--color-ink-3); margin: 0 0 0.6rem;
  }
  .work-card-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 600; line-height: 1.2; letter-spacing: -0.02em;
    color: var(--color-ink); margin: 0 0 0.6rem; max-width: 30rem;
  }
  .work-card-blurb {
    font-size: 0.9375rem; line-height: 1.6; color: var(--color-ink-2); max-width: 32rem; margin: 0 0 1.25rem;
  }

  .work-card-foot {
    margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .work-card-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .work-card-tags span {
    font-size: 0.75rem; color: var(--color-ink-2);
    border: 1px solid var(--color-border); border-radius: 100px; padding: 0.4rem 0.85rem;
  }
  .work-card-arrow {
    flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    width: 2.5rem; height: 2.5rem; border-radius: 50%;
    border: 1px solid var(--color-border); color: var(--color-ink);
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) {
    .work-card:hover .work-card-arrow {
      background: var(--color-ink); border-color: var(--color-ink); color: var(--color-bg);
      transform: rotate(45deg);
    }
  }

  .work-card-label { display: none; }

  @media (min-width: 900px) {
    .work-row { flex-direction: row; align-items: stretch; height: clamp(26rem, 44vw, 30rem); gap: 0.75rem; }
    .work-card {
      flex: 0 1 4.5rem; min-width: 4.5rem; overflow: hidden;
      transition: flex-grow 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .work-card.is-featured { flex: 3 1 0; }
    .work-row:hover .work-card { flex: 1 1 0; }
    .work-row:hover .work-card:hover { flex: 3.2 1 0; }

    .work-card-n, .work-card-frame, .work-card-info { display: none; }
    .work-card-label {
      display: block; writing-mode: vertical-rl; text-orientation: mixed;
      font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.02em;
      color: var(--color-ink-3); white-space: nowrap; overflow: hidden; max-height: 100%;
    }

    /* Custom-property toggle, not ancestor-qualified selectors on a shared
       trailing compound selector — see ProjectList.astro's comment for why:
       Lightning CSS (Tailwind v4's minifier) silently "factors" and drops
       the ancestor qualifier off one branch when rules sharing a trailing
       selector are written side by side, applying it unconditionally.
       Confirmed by inspecting compiled dist CSS. One concrete rule per
       element here, so there's nothing left for it to merge unsafely. */
    .work-card-n, .work-card-frame, .work-card-info {
      display: var(--expanded-display, none);
    }
    .work-card-label { display: var(--collapsed-display, block); }
    .work-card.is-featured {
      --expanded-display: block; --collapsed-display: none;
    }
    .work-row:hover .work-card:hover {
      --expanded-display: block; --collapsed-display: none;
    }
    .work-row:hover .work-card:not(:hover) {
      --expanded-display: none; --collapsed-display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card, .work-card-arrow { transition: none; }
  }

  .r-how { padding: clamp(2rem, 5vw, 3rem) 0 clamp(3rem, 6vw, 5rem); }
  .r-how-head {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.25rem); letter-spacing: -0.02em;
    color: var(--color-ink); margin: 0 0 2.5rem; max-width: 30rem;
  }
  .r-how-list {
    display: grid; grid-template-columns: 1fr; gap: 2rem;
    padding-top: 2rem; border-top: 1px solid var(--color-border);
  }
  .r-how-item h3 { font-size: 1rem; font-weight: 600; color: var(--color-ink); margin: 0.5rem 0 0.5rem; }
  .r-how-item p { font-size: 0.875rem; line-height: 1.55; color: var(--color-ink-2); margin: 0; }
  .r-how-n { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-ink-3); margin: 0; }

  @media (min-width: 768px) {
    .r-how-list { grid-template-columns: repeat(3, 1fr); }
  }

  .r-about-teaser { padding: clamp(2rem, 5vw, 3rem) 0 clamp(4rem, 8vw, 6rem); max-width: 42rem; }
  .r-about-p { font-size: 1rem; line-height: 1.7; color: var(--color-ink-2); margin: 0 0 1.5rem; }
  .r-text-link {
    font-size: 0.875rem; font-weight: 500; color: var(--color-ink);
    text-decoration: none; border-bottom: 1px solid var(--color-border);
  }
  .r-text-link:hover { border-color: var(--color-ink); }
</style>
