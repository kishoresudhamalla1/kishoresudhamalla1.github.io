---
/**
 * Redesign option — AI Lab.
 *
 * One real, shipped experiment: the existing Design Ops case study
 * (/work/design-ops) is a genuinely built, solo, end-to-end AI tool — rules
 * decide what's true, AI explains what it means, nothing writes back
 * without approval. It fits "AI Lab" better than it fit the two-flagship
 * Selected Work list, so it's surfaced here instead, linked to the real
 * page rather than duplicated.
 *
 * The other three experiments the brief suggested (UX Signals, Wireframe
 * Generator, Design QA Agent) have not been built in this repo. They're
 * shown as explicitly labeled "Conceptual" cards with no invented results,
 * per the content-integrity rule — a one-line description of the idea,
 * nothing claimed as built or measured.
 */
import Base from "../layouts/Base.astro";
import ContentNeeded from "../components/ContentNeeded.astro";

const CONCEPTS = [
  {
    title: "UX Signals",
    status: "Conceptual",
    explore: "Whether a BRD or product-context document can be turned into UX signals and open design questions before any screen gets drawn. The aim is to surface ambiguity early instead of discovering it mid-design.",
    build: "Not yet built.",
    learn: "Not applicable. Conceptual only.",
  },
  {
    title: "Wireframe Generator",
    status: "Conceptual",
    explore: "Whether a short text description or rough sketch can be turned into a low-fidelity product structure fast enough to be useful as a starting point for design exploration rather than a replacement for it.",
    build: "Not yet built.",
    learn: "Not applicable. Conceptual only.",
  },
  {
    title: "Design QA Agent",
    status: "Conceptual",
    explore: "Whether a design file or screenshot can be checked against usability and accessibility heuristics automatically and catch issues earlier than a manual review would.",
    build: "Not yet built.",
    learn: "Not applicable. Conceptual only.",
  },
];
const BUILT = [
  {
    n: "01",
    title: "Agentic HCM: an AI that explains why delivery slipped",
    tagline: "A rules engine decides what is true. An AI layer explains what it means.",
    blurb: "A solo end-to-end system: a rules engine stays the single source of truth for dates, scope and status, and an AI layer explains root cause, cites the records it read and only writes back after explicit approval. In daily use as of 2026.",
    tags: ["Built", "Agentic UX", "Rules plus AI"],
    href: "/work/design-ops",
    img: "/images/work/design-ops/hero-window.webp",
    featured: true,
  },
  {
    n: "02",
    title: "Twelve agent UX patterns you can click through",
    tagline: "Intent, plans, approvals, failure, handoff, memory and evaluation.",
    blurb: "Each pattern is a scripted, simulated agent with realistic latency and failures, and the design trade-off written beside it. Nothing here calls a real model.",
    tags: ["Interactive", "Simulated", "Agent UX"],
    href: "/ai-lab/patterns",
    img: "/images/work/ai-labs/patterns.webp",
    featured: false,
  },
];
---

<Base title="AI Lab | Kishore Sudhamalla">
  <section class="container-pg r-lab-hero" data-reveal>
    <p class="r-eyebrow">AI Lab</p>
    <h1>Where I build AI-native ideas as well as design them.</h1>
    <p class="r-lede">
      This is a working record, not a marketing page. Some of what's here shipped and runs on real data. Some is a question I'm still exploring and haven't built yet. Those are labeled conceptual and no results are claimed for them.
    </p>
  </section>

  <section class="container-pg r-work" data-reveal>
    <p class="r-case-label">Built</p>
    <div class="work-row">
      {BUILT.map((p) => (
        <a href={p.href} class:list={["work-card", p.featured && "is-featured"]}>
          <div class="work-card-body">
            <span class="work-card-n" aria-hidden="true">{p.n}</span>
            <div class="work-card-frame">
              <span class="work-card-chrome" aria-hidden="true"><i></i><i></i><i></i></span>
              <div class="work-card-shot"><img src={p.img} alt="" loading="lazy" decoding="async" /></div>
            </div>
            <div class="work-card-info">
              <p class="work-card-title">{p.title}</p>
              <p class="work-card-tagline">{p.tagline}</p>
              <p class="work-card-blurb">{p.blurb}</p>
              <div class="work-card-foot">
                <div class="work-card-tags">{p.tags.map((t) => <span>{t}</span>)}</div>
                <span class="work-card-arrow" aria-hidden="true">
                  <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4M12 4H5.5M12 4V10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </div>
            </div>
          </div>
          <p class="work-card-label" aria-hidden="true">{p.n} &middot; {p.title}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Conceptual experiments -->
  <section class="container-pg r-lab-concepts" data-reveal>
    <p class="r-case-label">Conceptual · not yet built</p>
    <div class="r-concept-grid">
      {CONCEPTS.map((c) => (
        <div class="r-concept-card">
          <div class="r-concept-top">
            <h3>{c.title}</h3>
            <span class="r-concept-status">{c.status}</span>
          </div>
          <p class="r-concept-label">What I wanted to explore</p>
          <p>{c.explore}</p>
          <p class="r-concept-label">What I built</p>
          <p>{c.build}</p>
          <p class="r-concept-label">What I learned</p>
          <p>{c.learn}</p>
        </div>
      ))}
    </div>
    <ContentNeeded note="These three concepts are listed because they are directions worth exploring, not because any of them has been built. If one gets built, move it up to the 'Built' section above with real detail on what it does and what was learned. Do not backfill results here." />
  </section>
</Base>

<style>

  .r-lab-hero { padding-block: clamp(3rem, 7vw, 5rem) clamp(2rem, 4vw, 3rem); }
  .r-lab-hero > * { max-width: var(--measure); }
  .r-eyebrow {
    font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-3);
    margin: 0 0 1.25rem;
  }
  .r-lab-hero h1 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.875rem, 4.5vw, 3rem); letter-spacing: -0.03em; line-height: 1.1;
    color: var(--color-ink); margin: 0 0 1.25rem;
  }
  .r-lede { font-size: 1.0625rem; line-height: 1.65; color: var(--color-ink-2); margin: 0; }

  .r-case-label {
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-3);
    margin: 0 0 1.25rem;
  }

  .r-lab-concepts { padding-bottom: clamp(4rem, 8vw, 6rem); }
  .r-concept-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; margin-bottom: 2rem; }
  .r-concept-card { padding: 1.5rem; border: 1px solid var(--color-border); border-radius: 1rem; }
  .r-concept-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.1rem; }
  .r-concept-top h3 { font-size: 1.0625rem; font-weight: 600; color: var(--color-ink); margin: 0; }
  .r-concept-status {
    font-family: var(--font-mono); font-size: 0.625rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-ink-3); border: 1px solid var(--color-border); border-radius: 100px; padding: 0.25rem 0.6rem;
  }
  .r-concept-label { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-ink-3); margin: 0 0 0.3rem; font-family: var(--font-mono); }
  .r-concept-card p:not(.r-concept-label) { font-size: 0.875rem; line-height: 1.55; color: var(--color-ink-2); margin: 0 0 1rem; }

  @media (min-width: 768px) {
    .r-concept-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .r-work { padding-block: clamp(1rem, 3vw, 2rem) clamp(3rem, 6vw, 4.5rem); }
  .work-row { display: flex; flex-direction: column; gap: 1.25rem; }

  .work-card {
    position: relative; display: flex; flex-direction: column;
    border: 1px solid var(--color-border); border-radius: 1.25rem;
    text-decoration: none; color: inherit; background: var(--color-surface);
    padding: 1.1rem;
  }

  .work-card-n {
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.06em;
    color: var(--color-ink-3); margin-bottom: 0.9rem; display: block;
  }

  .work-card-frame {
    border: 1px solid var(--color-border); border-radius: 0.85rem; overflow: hidden;
    background: var(--color-bg); margin-bottom: 1.1rem;
  }
  .work-card-chrome {
    display: flex; align-items: center; gap: 0.3rem;
    padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--color-border);
  }
  .work-card-chrome i {
    width: 6px; height: 6px; border-radius: 50%; background: var(--color-border);
  }
  .work-card-shot { aspect-ratio: 16 / 10; background: var(--color-surface); }
  .work-card-shot img {
    width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block;
  }

  .work-card-info { display: flex; flex-direction: column; flex: 1; }

  .work-card-kicker {
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.03em;
    color: var(--color-ink-3); margin: 0 0 0.6rem;
  }
  .work-card-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 600; line-height: 1.2; letter-spacing: -0.02em;
    color: var(--color-ink); margin: 0 0 0.6rem; max-width: 30rem;
  }
  .work-card-blurb {
    font-size: 0.9375rem; line-height: 1.6; color: var(--color-ink-2); max-width: 32rem; margin: 0 0 1.25rem;
  }

  .work-card-foot {
    margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .work-card-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .work-card-tags span {
    font-size: 0.75rem; color: var(--color-ink-2);
    border: 1px solid var(--color-border); border-radius: 100px; padding: 0.4rem 0.85rem;
  }
  .work-card-arrow {
    flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    width: 2.5rem; height: 2.5rem; border-radius: 50%;
    border: 1px solid var(--color-border); color: var(--color-ink);
    transition: background-color var(--dur-fast) var(--ease-enter), color var(--dur-fast) var(--ease-enter), border-color var(--dur-fast) var(--ease-enter), transform var(--dur-normal) var(--ease-emphasized);
  }
  @media (hover: hover) {
    .work-card:hover .work-card-arrow {
      background: var(--color-ink); border-color: var(--color-ink); color: var(--color-bg);
      transform: rotate(45deg);
    }
  }

  .work-card-body { display: flex; flex-direction: column; flex: 1; }
  .work-card-label { display: none; }

  @media (min-width: 900px) {
    .work-row { flex-direction: row; align-items: stretch; height: clamp(26rem, 44vw, 30rem); gap: 0.75rem; }
    .work-card {
      flex: 0 1 4.5rem; min-width: 4.5rem; overflow: hidden;
      transition: flex-grow var(--dur-slow) var(--ease-emphasized);
    }
    .work-card.is-featured { flex: 3 1 0; }
    .work-row:hover .work-card { flex: 1 1 0; }
    .work-row:hover .work-card:hover { flex: 3.2 1 0; }

    /*
      The card's width is the only thing that animates. Its content is taken
      out of flow and cross-faded around the move instead of switched with
      display:none: the outgoing content is gone in ~90ms, before the card
      narrows, and the incoming content fades in only once the card is ~90%
      open, so the text never visibly re-wraps while the width is changing.

      State is driven through custom properties on the card, with exactly one
      concrete rule per child element. Writing these as separate
      ancestor-qualified rules against a shared child selector triggers a
      Lightning CSS (Tailwind v4 minifier) bug that drops the ancestor
      qualifier and applies one branch to every card.
    */
    .work-card-body {
      position: absolute; inset: 1.1rem;
      opacity: var(--body-o, 0);
      transition: opacity var(--body-dur, 90ms) var(--body-ease, var(--ease-exit)) var(--body-delay, 0ms);
    }
    .work-card-label {
      display: block; writing-mode: vertical-rl; text-orientation: mixed;
      font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.02em;
      color: var(--color-ink-3); white-space: nowrap; overflow: hidden; max-height: 100%;
      opacity: var(--label-o, 1);
      transition: opacity var(--label-dur, 140ms) var(--ease-enter) var(--label-delay, 260ms);
    }
    .work-card.is-featured {
      --body-o: 1; --body-dur: var(--dur-fast); --body-delay: 220ms; --body-ease: var(--ease-enter);
      --label-o: 0; --label-dur: 60ms; --label-delay: 0ms;
    }
    .work-row:hover .work-card:hover {
      --body-o: 1; --body-dur: var(--dur-fast); --body-delay: 220ms; --body-ease: var(--ease-enter);
      --label-o: 0; --label-dur: 60ms; --label-delay: 0ms;
    }
    .work-row:hover .work-card:not(:hover) {
      --body-o: 0; --body-dur: 90ms; --body-delay: 0ms;
      --label-o: 1; --label-dur: 140ms; --label-delay: 260ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card, .work-card-arrow, .work-card-body, .work-card-label { transition: none; }
  }



  .work-card-tagline {
    font-family: var(--font-display); font-weight: 600; font-size: 1rem; line-height: 1.4;
    letter-spacing: -0.01em; color: var(--color-ink); margin: 0 0 0.6rem; max-width: 32rem;
  }
  .work-card-info .work-card-title { margin-bottom: 0.4rem; }

</style>
