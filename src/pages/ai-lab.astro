 *
 * One real, shipped experiment: the existing Design Ops case study
 * (/work/design-ops) is a genuinely built, solo, end-to-end AI tool — rules
 * decide what's true, AI explains what it means, nothing writes back
 * without approval. It fits "AI Lab" better than it fit the two-flagship
 * Selected Work list, so it's surfaced here instead, linked to the real
 * page rather than duplicated.
 *
 * Unbuilt concept ideas (UX Signals, Wireframe Generator, Design QA Agent)
 * removed from this page on 2026-11-09; see CONTENT-TODO.md (untracked,
 * local only) if they get built later.
 */
import Base from "../layouts/Base.astro";
import PaperCards from "../components/PaperCards.astro";

const BUILT = [
  {
    n: "01",
    short: "Design Ops",
    word: "OPS",
    wordN: 6,
    l1: "Agentic HCM.",
    l2: "In daily use, 2026.",
    ptitle: "Design Ops.",
    pblurb: "A rules engine decides what is true. An AI layer explains what it means and writes back only after approval.",
    kicker: "01 \u2014 Built \u00b7 In daily use",
    tags: ["Built", "Agentic UX", "Rules plus AI"],
    href: "/work/design-ops",
    title: "Agentic HCM: an AI that explains why delivery slipped",
    featured: true,
  },
  {
    n: "02",
    short: "Agent UX patterns",
    word: "PATTERNS",
    l1: "Interactive.",
    l2: "Simulated.",
    ptitle: "Twelve agent UX patterns.",
    pblurb: "Intent, plans, approvals, failure, handoff, memory and evaluation, each as a clickable demo.",
    kicker: "02 \u2014 Interactive \u00b7 Simulated",
    tags: ["Interactive", "Simulated", "Agent UX"],
    href: "/ai-lab/patterns",
    title: "Twelve agent UX patterns you can click through",
