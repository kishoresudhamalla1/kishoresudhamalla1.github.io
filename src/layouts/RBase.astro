---
/**
 * Layout for the /redesign/* option — parallel to Base.astro, not a
 * modification of it. Shares the same theme script, scroll-reset fix,
 * reveal/parallax observers, global stylesheet and Footer, but swaps in
 * RNav (the reduced Work / AI Lab / Thinking / About nav) instead of the
 * live site's Nav. Keeping this separate means the redesign option can be
 * reviewed and discarded without touching anything live.
 */
import "../styles/global.css";
import RNav from "../components/redesign/RNav.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";
import CountUp from "../components/CountUp.astro";

interface Props {
  title?: string;
  description?: string;
  og?: string;
}

const {
  title = "Kishore Sudhamalla — Principal Product Designer (redesign option)",
  description = "Designing complex enterprise systems into intelligent, AI-native experiences.",
  og = "/og.png",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..800;1,14..32,300..800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var DARK_FROM = 18.5;
        var DARK_TO = 7;
        function isNight(d) {
          var h = d.getHours() + d.getMinutes() / 60;
          return h >= DARK_FROM || h < DARK_TO;
        }
        function periodKey(d) {
          var night = isNight(d);
          var day = new Date(d);
          if (night && d.getHours() < DARK_TO) day.setDate(day.getDate() - 1);
          return [day.getFullYear(), day.getMonth() + 1, day.getDate(), night ? "n" : "d"].join("-");
        }
        function autoTheme(d) {
          var osDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          return osDark || isNight(d) ? "dark" : "light";
        }
        function resolve() {
          var now = new Date();
          try {
            var raw = localStorage.getItem("theme-override");
            if (raw) {
              var o = JSON.parse(raw);
              if (o && o.period === periodKey(now)) return o.value;
              localStorage.removeItem("theme-override");
            }
          } catch (e) {}
          return autoTheme(now);
        }
        function apply() {
          var t = resolve();
          var isDark = t === "dark";
          if (document.documentElement.classList.contains("dark") !== isDark) {
            document.documentElement.classList.toggle("dark", isDark);
            document.dispatchEvent(new CustomEvent("themechange", { detail: t }));
          }
        }
        function set(value) {
          try {
            localStorage.setItem("theme-override", JSON.stringify({ value: value, period: periodKey(new Date()) }));
          } catch (e) {}
          document.documentElement.classList.toggle("dark", value === "dark");
          document.dispatchEvent(new CustomEvent("themechange", { detail: value }));
        }
        window.__theme = { resolve: resolve, apply: apply, set: set };
        document.documentElement.classList.toggle("dark", resolve() === "dark");
        document.addEventListener("astro:after-swap", apply);
        setInterval(apply, 60000);
        document.addEventListener("visibilitychange", function () {
          if (!document.hidden) apply();
        });
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", apply);
      })();
    </script>
    <script is:inline>
      (function () {
        var nav = performance.getEntriesByType("navigation")[0];
        var type = nav ? nav.type : "navigate";
        if (!location.hash && (type === "navigate" || type === "reload")) {
          if ("scrollRestoration" in history) history.scrollRestoration = "manual";
          window.scrollTo(0, 0);
        }
      })();
    </script>
    <ViewTransitions />
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-ink)] transition-colors duration-200">
    <div class="r-option-flag">Redesign option — not live</div>
    <RNav />
    <main>
      <slot />
    </main>
    <Footer />
    <CountUp />
  </body>
</html>

<style>
  .r-option-flag {
    position: fixed; bottom: 1rem; right: 1rem; z-index: 60;
    font-family: var(--font-mono);
    font-size: 0.625rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-bg); background: var(--color-ink);
    padding: 0.4rem 0.7rem; border-radius: 100px;
    opacity: 0.85; pointer-events: none;
  }
</style>

<script>
  function initReveal() {
    const els = document.querySelectorAll("[data-reveal]");
    if (!els.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "-60px 0px", threshold: 0.05 }
    );
    els.forEach((el) => io.observe(el));
  }
  initReveal();
  document.addEventListener("astro:page-load", initReveal);
</script>

<script>
  function initParallax() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const els = Array.from(document.querySelectorAll("[data-parallax]"));
    if (!els.length) return;
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      for (const el of els) {
        const speed = parseFloat(el.dataset.parallax || "0.08");
        const anchor = el.parentElement ?? el;
        const r = anchor.getBoundingClientRect();
        if (r.bottom < -200 || r.top > vh + 200) continue;
        const offset = (r.top + r.height / 2 - vh / 2) * -speed;
        el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
      }
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }
  initParallax();
  document.addEventListener("astro:page-load", initParallax);
</script>
