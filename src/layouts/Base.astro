---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";
import CountUp from "../components/CountUp.astro";

interface Props {
  title?: string;
  description?: string;
  og?: string;
  noindex?: boolean;
}

const {
  title = "Kishore Sudhamalla — Principal Product Designer",
  description = "Designing complex enterprise systems into intelligent, AI-native experiences.",
  og = "/og.png",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..800;1,14..32,300..800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var DARK_FROM = 18.5;
        var DARK_TO = 7;
        function isNight(d) {
          var h = d.getHours() + d.getMinutes() / 60;
          return h >= DARK_FROM || h < DARK_TO;
        }
        function periodKey(d) {
          var night = isNight(d);
          var day = new Date(d);
          if (night && d.getHours() < DARK_TO) day.setDate(day.getDate() - 1);
          return [day.getFullYear(), day.getMonth() + 1, day.getDate(), night ? "n" : "d"].join("-");
        }
        function autoTheme(d) {
          var osDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          return osDark || isNight(d) ? "dark" : "light";
        }
        function resolve() {
          var now = new Date();
          try {
            var raw = localStorage.getItem("theme-override");
            if (raw) {
              var o = JSON.parse(raw);
              if (o && o.period === periodKey(now)) return o.value;
              localStorage.removeItem("theme-override");
            }
          } catch (e) {}
          return autoTheme(now);
        }
        function apply() {
          var t = resolve();
          var isDark = t === "dark";
          if (document.documentElement.classList.contains("dark") !== isDark) {
            document.documentElement.classList.toggle("dark", isDark);
            document.dispatchEvent(new CustomEvent("themechange", { detail: t }));
          }
        }
        function set(value) {
          try {
            localStorage.setItem("theme-override", JSON.stringify({ value: value, period: periodKey(new Date()) }));
          } catch (e) {}
          document.documentElement.classList.toggle("dark", value === "dark");
          document.dispatchEvent(new CustomEvent("themechange", { detail: value }));
        }
        window.__theme = { resolve: resolve, apply: apply, set: set };
        document.documentElement.classList.toggle("dark", resolve() === "dark");
        // `js` gates the hidden initial state of [data-reveal] (see global.css),
        // so a blocked or failed script can never leave the page invisible. A
        // view-transition swap replaces <html>'s attributes, so it is re-added,
        // and `__navSwapAt` tells the reveal script this content arrived with a
        // page transition rather than from a cold load.
        document.documentElement.classList.add("js");
        document.addEventListener("astro:after-swap", function () {
          document.documentElement.classList.add("js");
          window.__navSwapAt = performance.now();
        });
        document.addEventListener("astro:after-swap", apply);
        setInterval(apply, 60000);
        document.addEventListener("visibilitychange", function () {
          if (!document.hidden) apply();
        });
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", apply);
      })();
    </script>
    <script is:inline>
      (function () {
        var nav = performance.getEntriesByType("navigation")[0];
        var type = nav ? nav.type : "navigate";
        if (!location.hash && (type === "navigate" || type === "reload")) {
          if ("scrollRestoration" in history) history.scrollRestoration = "manual";
          window.scrollTo(0, 0);
        }
      })();
    </script>
    <ViewTransitions />
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-ink)] transition-colors duration-200">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <CountUp />
  </body>
</html>


<script>
  import { prefersReducedMotion, watchVisibility } from "../lib/motion";

  // Scroll reveal. Observes whole groups (one [data-reveal] per section), and
  // reveals as soon as a group's top edge is within the viewport, so the
  // reader never scrolls ahead of the content. Groups that are already in view
  // when a page arrives through a view transition appear in place.
  function initReveal() {
    const els = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]:not(.revealed)"));
    if (!els.length) return;

    const swapAt: number = (window as any).__navSwapAt ?? -Infinity;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          // Within the view transition's window: appear in place.
          if (performance.now() - swapAt < 600) el.setAttribute("data-instant", "");
          el.classList.add("revealed");
          io.unobserve(el);
        });
      },
      { rootMargin: "0px 0px -6% 0px", threshold: 0 }
    );
    els.forEach((el) => io.observe(el));
  }
  initReveal();
  document.addEventListener("astro:page-load", initReveal);

  // Ambient video (hero loops, product recordings): play only while visible,
  // and never autoplay for people who have asked for reduced motion -- the
  // poster frame stands in.
  function initVideo() {
    document.querySelectorAll<HTMLVideoElement>("video[autoplay]").forEach((v) => {
      if (v.dataset.motionReady) return;
      v.dataset.motionReady = "1";
      if (prefersReducedMotion()) {
        v.pause();
        v.removeAttribute("autoplay");
        return;
      }
      watchVisibility(v, (visible) => {
        if (visible) v.play().catch(() => {});
        else v.pause();
      });
    });
  }
  initVideo();
  document.addEventListener("astro:page-load", initVideo);
</script>
